# bandplate — apps/web environment configuration.
#
# Copy this file to `.env` and fill in real values. `astro.config.mjs` loads
# it into `process.env` at startup, which is what `src/server/config.ts`
# validates — Vite on its own only exposes `.env` through `import.meta.env`,
# so the file alone is not enough and the config there says why.
#
# This applies to `astro dev` and `astro build`. A BUILT server started with
# `node dist/start.mjs` is a separate process that never runs the Astro config,
# so it takes its configuration from the real environment — which is what you
# want in a deployment.
#
# Configuration is validated once, at startup, with zod (see
# src/server/config.ts) — a missing required variable or a broken combination
# fails immediately with a message naming the offending variable, rather than
# starting in a half-working state.

# --- Database ---------------------------------------------------------------

# libSQL URL. A local file for development/single-box deployments, or a
# remote libSQL/Turso URL for anything else. Required.
BANDPLATE_DATABASE_URL=file:./.data/bandplate.db

# --- Public origin / CSRF ----------------------------------------------------

# The exact public origin this app is served from, e.g. https://bandplate.example
# (scheme + host, no trailing slash, no path). Used to build login-link URLs
# and to check the `Origin` header on every mutating request (the app's CSRF
# defense) — a mismatch here fails every login/admin form with a 403 that
# looks unrelated to configuration.
#
# Required when NODE_ENV=production. Outside production it defaults to
# http://localhost:4321, which is correct for local dev and wrong for
# anything else — set it explicitly for any real deployment, even a staging
# one, rather than relying on the dev default.
BANDPLATE_APP_ORIGIN=http://localhost:4321

# --- Language ----------------------------------------------------------------

# What this installation speaks: "en" or "cs". Optional; English if unset.
#
# It is a FALLBACK, not an override. A signed-in member's own choice on /me
# wins, so does the cookie recording an earlier choice, and so does a browser
# that asks (via Accept-Language) for a language this app actually has. What
# this decides is everything that used to land on English by default: a
# visitor whose browser asks for something we do not speak, and the language
# written onto each NEW member's row — which is what their invitation is sent
# in and what they see on their first sign-in, before they have been anywhere
# near /me.
#
# Validated against the shipped languages, so a typo'd "cz" (the country
# code, not the language code) fails at startup naming the variable rather
# than silently doing nothing.
BANDPLATE_DEFAULT_LOCALE=en

# --- Bootstrap ---------------------------------------------------------------

# Shared secret required once, by the operator, at /setup, to create the
# first admin account. Required. Generate a long random value and keep it
# out of version control — treat it like a password.
BANDPLATE_BOOTSTRAP_TOKEN=change-me-to-a-long-random-value

# --- Cookies -----------------------------------------------------------------

# Whether the `bp_session` cookie is marked `Secure` (HTTPS only). Defaults
# to true. Set to `false` ONLY for local development over plain HTTP —
# never in any deployment reachable over the network.
BANDPLATE_COOKIE_SECURE=true

# --- Trusted proxy depth (rate-limit key spoofing) ---------------------------

# Number of reverse-proxy hops IN FRONT of this app that are trusted to have
# appended their own observed peer address to `X-Forwarded-For`. This
# controls how the app picks the real client IP out of that header for
# rate-limiting login requests — get it wrong and either a real client's
# rate limit bucket is shared with everyone behind the same proxy, or worse,
# an attacker can pick their own bucket by forging the header.
#
# Defaults to 1, which is correct for the common case: one platform
# edge/proxy (a CDN, a PaaS's router, a single nginx/Caddy in front of the
# app) in front of bandplate.
#
# *** If bandplate has NO reverse proxy in front of it at all (it receives
# connections directly from clients), set this to 0. *** With no fronting
# proxy, a direct client can set `X-Forwarded-For` on their own request —
# there is no trusted hop to have appended anything trustworthy to it — so
# trusting any part of that header at depth 1 lets an attacker pick an
# arbitrary rate-limit bucket per request and bypass the login rate limit
# entirely.
BANDPLATE_TRUSTED_PROXY_DEPTH=1

# --- Mail ---------------------------------------------------------------------

# The app is email-only after bootstrap — there is no other way for a
# member to sign in. It refuses to start with no way to deliver login
# links: set the SMTP block below for any real deployment, or set
# BANDPLATE_ALLOW_DEV_MAILER=true for local development only (prints raw
# login links to the server console instead of emailing them — never do
# this anywhere a real member might need to sign in).

# SMTP config is all-or-nothing: HOST, PORT and FROM are all required
# together once any of them is set. USER/PASS are optional (some relays
# don't require auth) but must be set together if used.
# BANDPLATE_SMTP_HOST=smtp.example.com
# BANDPLATE_SMTP_PORT=587
# BANDPLATE_SMTP_SECURE=false
# BANDPLATE_SMTP_FROM=bandplate@example.com
# BANDPLATE_SMTP_USER=
# BANDPLATE_SMTP_PASS=

# Local development only. Never set this to true in a real deployment —
# uncomment ONLY on your own machine, never in a committed .env or a
# deployed environment. Left commented out here on purpose: copying this
# file as-is with SMTP left commented out above now fails to start
# (no mailer configured) instead of silently printing raw login links to
# stdout, which is what happened when this line shipped active. Config
# validation also refuses BANDPLATE_ALLOW_DEV_MAILER=true outright when
# NODE_ENV=production, as a second line of defense.
# BANDPLATE_ALLOW_DEV_MAILER=true

# --- Web Push (notifications) -------------------------------------------------

# Optional. Push notifications are off entirely when none of these three are
# set — `/me`'s Notifikace section doesn't render, and no tick ever sends a
# push. Set all three together to turn it on; like SMTP above, this is
# all-or-nothing, and a partial set fails at startup naming what's missing.
#
# Generate a fresh key pair with:
#   pnpm --filter @bandplate/push vapid:generate
#
# BANDPLATE_VAPID_PUBLIC_KEY is safe to expose to the browser (it's handed to
# every subscribing client as `applicationServerKey`); BANDPLATE_VAPID_PRIVATE_KEY
# is not — treat it like a password, never commit it, never let it leave the
# server. BANDPLATE_VAPID_SUBJECT identifies the sender to push services per
# RFC 8292 and must start with "mailto:" or "https:" — a contact address the
# push service can reach if this deployment starts misbehaving.
# BANDPLATE_VAPID_PUBLIC_KEY=
# BANDPLATE_VAPID_PRIVATE_KEY=
# BANDPLATE_VAPID_SUBJECT=mailto:band@example.com

# --- Object storage (audio) --------------------------------------------------

# Where recordings live — an S3-compatible bucket (MinIO for self-hosted /
# local dev, or R2/real S3). All six variables are required; there is no
# "no storage configured" mode, since every take's audio depends on this.
#
# S3_ENDPOINT and S3_PUBLIC_ENDPOINT are DELIBERATELY separate variables:
#   - S3_ENDPOINT is what THIS SERVER uses to reach the bucket.
#   - S3_PUBLIC_ENDPOINT is what the BROWSER uses to fetch presigned
#     upload/download URLs.
# The default below (both http://localhost:9000) is correct for the
# README's actual documented/verified path: `deploy/node/compose.yml`
# starts MinIO (`docker compose up -d minio minio-init`), and `apps/web`
# itself runs directly on the host (`pnpm --filter web dev`, or
# `pnpm build && pnpm start`) — reachable at localhost either way.
# `deploy/node/compose.yml`'s own `app` service (running `apps/web` INSIDE
# the compose network too) is the one case these must differ: set
# S3_ENDPOINT=http://minio:9000 there instead, since that's the compose
# network's internal hostname for MinIO — `minio` does not resolve outside
# it, so S3_PUBLIC_ENDPOINT (used to build URLs for the BROWSER, which is
# never on that network) stays http://localhost:9000 regardless.
# Setting both to the same WRONG value works right up until the first real
# playback attempt, which then 403s or hangs with no obvious cause — see
# `apps/web/src/server/config.ts` for the same warning surfaced as a
# config-validation error message if either is left empty.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Bucket name and region. "auto" is the correct region for both MinIO and
# Cloudflare R2 — only a real AWS S3 bucket needs a real region name.
S3_BUCKET=bandplate
S3_REGION=auto

# Credentials for the bucket. The values below match
# `deploy/node/compose.yml`'s MinIO defaults — change them for anything
# other than local dev against that compose stack.
S3_ACCESS_KEY_ID=bandplate-dev
S3_SECRET_ACCESS_KEY=bandplate-dev-secret
