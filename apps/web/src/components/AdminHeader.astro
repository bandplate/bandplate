---
import { messages } from "@bandplate/i18n";
// The admin section header — and the whole of what used to be `AdminLayout`.
//
// Admin has no shell of its own any more. These pages render inside
// `AppLayout` like every other page, under the Admin nav item, so the second
// header (its own wordmark, its own pill nav, its own sign-out button) is
// gone: signing out lives on `/me`, the wordmark is in the shell, and what is
// actually specific to admin is this — the page's title and the row of
// sections beneath it.
//
// The pills are the `.bp-filter-pill` the events archive uses, carrying
// `aria-current="page"` rather than `aria-pressed`. Same shape, different
// verb: these navigate, they do not toggle, and a pressed toggle that is
// really a link is the kind of control nobody can predict.
//
// They are a PHONE control. Past `lg` the sidebar has an Admin section
// listing these same four links, so the pills hide there rather than
// rendering the same navigation twice on one screen (see components.css).
export interface Props {
  title: string;
  current: "overview" | "members" | "instruments" | "tokens";
}

const { title, current } = Astro.props;

const t = messages(Astro.locals.locale);

// The SAME four labels the sidebar renders (`AppLayout.astro`'s `adminItems`),
// from the same catalog keys. They were literal English here, which nothing
// caught because admin is the one area whose sidebar and whose pills are never
// on screen together: past `lg` the pills are hidden, below it the sidebar is,
// so a Czech reader on a phone got an English menu and no way to see the
// translated one beside it — and the pills are the ONLY admin navigation at
// that width.
const sections = [
  { key: "overview", label: t.shell.adminNav.overview, href: "/admin" },
  { key: "members", label: t.shell.adminNav.members, href: "/admin/members" },
  { key: "instruments", label: t.shell.adminNav.instruments, href: "/admin/instruments" },
  { key: "tokens", label: t.shell.adminNav.tokens, href: "/admin/tokens" },
] as const;
---

<div class="bp-admin-head">
  <h1 class="bp-page-title">{title}</h1>
  {/* `aria-label={...}`, NOT `aria-label="{...}"`. A quoted attribute is a
      string even when it looks like an expression, so this landmark announced
      itself to screen readers by reading out its own source code. Nothing
      warns about it — the markup is valid and the page renders. */}
  <nav class="bp-filter-pills bp-admin-sections" aria-label={t.shell.adminSectionsLabel}>
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="bp-filter-pill"
          aria-current={section.key === current ? "page" : undefined}
        >
          {section.label}
        </a>
      ))
    }
  </nav>
</div>
