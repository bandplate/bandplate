---
// The admin section header — and the whole of what used to be `AdminLayout`.
//
// Admin has no shell of its own any more. These pages render inside
// `AppLayout` like every other page, under the Admin nav item, so the second
// header (its own wordmark, its own pill nav, its own sign-out button) is
// gone: signing out lives on `/me`, the wordmark is in the shell, and what is
// actually specific to admin is this — the page's title and the row of
// sections beneath it.
//
// The pills are the `.bp-filter-pill` the events archive uses, carrying
// `aria-current="page"` rather than `aria-pressed`. Same shape, different
// verb: these navigate, they do not toggle, and a pressed toggle that is
// really a link is the kind of control nobody can predict.
//
// They are a PHONE control. Past `lg` the sidebar has an Admin section
// listing these same four links, so the pills hide there rather than
// rendering the same navigation twice on one screen (see components.css).
export interface Props {
  title: string;
  current: "overview" | "members" | "instruments" | "tokens";
}

const { title, current } = Astro.props;

const sections = [
  { key: "overview", label: "Overview", href: "/admin" },
  { key: "members", label: "Members", href: "/admin/members" },
  { key: "instruments", label: "Instruments", href: "/admin/instruments" },
  { key: "tokens", label: "Tokens", href: "/admin/tokens" },
] as const;
---

<div class="bp-admin-head">
  <h1 class="bp-page-title">{title}</h1>
  <nav class="bp-filter-pills bp-admin-sections" aria-label="Admin sections">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="bp-filter-pill"
          aria-current={section.key === current ? "page" : undefined}
        >
          {section.label}
        </a>
      ))
    }
  </nav>
</div>
