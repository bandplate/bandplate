---
// A RUN of instrument glyphs, as one object.
//
// `InstrumentIcon` draws one instrument; this draws a set of them. Five places
// rendered a set before this existed — the take row, the take detail's facts
// line, `/me`, the admin members table, and the take row's own second copy —
// each with its own class name (`.bp-take-instruments`, `.bp-me-instruments`,
// `.bp-cell-editor-icons`), its own size, and its own hand-written
// `aria-label`. Two of them announced "Instruments:", two announced "Plays:".
// One component owns all of that.
//
// --- The pad, not a rule ------------------------------------------------
//
// The set carries a tinted pad (`tone="chip"`, the default): a 6% wash of the
// foreground behind the glyphs. That is not decoration — it is what lets the
// glyphs sit directly beside text with nothing drawn between them. On the take
// row the run used to need a 1px rule separating it from the date, because
// without one a row of pictograms read as more words in the same sentence. A
// held-together group needs no separator, and one fewer hairline per row down
// a list is worth having.
//
// `tone="bare"` is for a set that already sits inside a box of its own — a
// table cell, a labelled field — where a second container reads as a box in a
// box.
//
// --- Density follows the COUNT, not the viewport ------------------------
//
// A set of six glyphs is nearly twice the width of a set of three, and on the
// take row it shares one line with the date and (where there is room) the
// event's name. Rather than a breakpoint — which would make the same take look
// different in a wide list and a narrow one, the thing R3 was chosen to avoid
// — the glyphs shrink when the set holds MORE THAN FOUR. A take with a rhythm
// section reads at full size everywhere; a take with a horn section reads
// small everywhere. `size` overrides it outright for callers that have their
// own reason (the admin table's 18px rows).
//
// --- One mark per DRAWING, not one per instrument -----------------------
//
// Several instruments legitimately share a glyph: a band that records bass
// twice — a DI take and a live amp, or an overdub done afterwards — keeps them
// as separate instruments ("Bass", "Live Bass") because the stems are separate
// files, and an admin quite reasonably gives both the bass glyph. Drawn
// straight, that renders two identical basses in a row, which reads as a
// mistake and tells the reader nothing the first one didn't.
//
// So the run is de-duplicated on `instrumentMark` — the glyph an admin CHOSE,
// which is their statement that these two look alike. Instruments with no
// glyph are never merged; see that function for why. Nothing is hidden
// either way: the merged glyph's hover text names every instrument behind it,
// and the group's `aria-label` still lists all of them in order, so the set
// means exactly what it meant before and only stops repeating itself.
import type { instrumentsRepo } from "@bandplate/db";
import { commonMessages, type Locale } from "@bandplate/i18n";
import { instrumentMark } from "@bandplate/ui/icons/instruments.js";
import { rosterSlots } from "../server/instrument-roster.js";
import InstrumentIcon from "./InstrumentIcon.astro";

/** Above this count the set draws at `DENSE_SIZE`. See the header comment. */
const DENSE_ABOVE = 4;
const BASE_SIZE = 20;
const DENSE_SIZE = 16;

type VerbKey = "instruments" | "plays";

/** The word each case opens with. */
function verbLabel(key: VerbKey, locale: Locale): string {
  const t = commonMessages(locale);
  return key === "plays" ? t.playsVerb : t.instrumentsVerb;
}

export interface Props {
  instruments: instrumentsRepo.Instrument[];
  /**
   * Which sentence the accessible label opens with. A take's set is a list of
   * what was recorded ("Instruments: bass, drums"); a member's is a list of
   * what they play ("Plays: bass, drums"). Same component, different sentence.
   *
   * A KEY, not the word itself. This was typed `"Instruments" | "Plays"` —
   * user-facing copy standing in for an enum — so the callers named a sentence
   * by quoting it and the type would have had to grow a Czech member to hold a
   * Czech verb. The word is looked up here; the caller names the case.
   */
  verb?: VerbKey;
  /** `"chip"` (default) draws the tinted pad; `"bare"` draws glyphs alone. */
  tone?: "chip" | "bare";
  /** Overrides the count-driven size. See the header comment. */
  size?: number;
  /**
   * What an EMPTY set renders. `null` (the default) renders nothing at all —
   * correct in a row or on a facts line, where an absent fact should take no
   * room. A table cell passes a word, because a blank cell in a column of
   * filled ones reads as a loading failure rather than as "none".
   */
  emptyLabel?: string | null;
  /**
   * The band's active instruments, in admin order. Given, the set draws the
   * whole roster in fixed positions, the take's instruments solid and the
   * rest ghosted, so rows down a list line up into comparable columns. See
   * `server/instrument-roster.ts` for the rules.
   */
  roster?: instrumentsRepo.Instrument[];
}

const {
  instruments,
  verb = "instruments",
  tone = "chip",
  size,
  emptyLabel = null,
  roster,
} = Astro.props;
const slots = roster ? rosterSlots(roster, instruments, instrumentMark) : null;

/** One entry per glyph actually drawn, in the order the set was given. */
interface DrawnMark {
  /** The first instrument to claim this mark — the one whose glyph is drawn. */
  instrument: instrumentsRepo.Instrument;
  /** Every instrument behind it, itself included. Becomes the hover text. */
  labels: string[];
}

const marks = new Map<string, DrawnMark>();
for (const instrument of instruments) {
  const key = instrumentMark(instrument);
  const existing = marks.get(key);
  if (existing) {
    existing.labels.push(instrument.label);
  } else {
    marks.set(key, { instrument, labels: [instrument.label] });
  }
}
const drawn = [...marks.values()];

// Density follows what is DRAWN, not what was passed: a set that collapses
// from five glyphs to three is three glyphs wide and should read at full size.
const dense = size === undefined && drawn.length > DENSE_ABOVE;
const glyphSize = size ?? (dense ? DENSE_SIZE : BASE_SIZE);
const classes = [
  "bp-instrument-set",
  tone === "bare" ? "bp-instrument-set--bare" : "",
  dense ? "bp-instrument-set--dense" : "",
]
  .filter(Boolean)
  .join(" ");
---

{
  slots && slots.length > 0 ? (
    <span
      class="bp-instrument-set bp-instrument-set--roster"
      role={instruments.length > 0 ? "img" : undefined}
      aria-hidden={instruments.length > 0 ? undefined : "true"}
      aria-label={
        instruments.length > 0
          ? `${verbLabel(verb, Astro.locals.locale)}: ${instruments.map((i) => i.label).join(", ")}`
          : undefined
      }
    >
      {slots.map((slot) => (
        <InstrumentIcon
          icon={slot.instrument.icon}
          label={slot.instrument.label}
          title={slot.labels.join(", ")}
          size={size ?? BASE_SIZE}
          off={!slot.present}
        />
      ))}
    </span>
  ) : instruments.length === 0 ? (
    emptyLabel ? (
      <span class="bp-kind">{emptyLabel}</span>
    ) : null
  ) : (
    /* ONE label for the group, not one announcement per glyph — seven
       consecutive "image" announcements is not a readable list. */
    <span
      class={classes}
      role="img"
      aria-label={`${verbLabel(verb, Astro.locals.locale)}: ${instruments.map((i) => i.label).join(", ")}`}
    >
      {drawn.map((mark) => (
        <InstrumentIcon
          icon={mark.instrument.icon}
          label={mark.instrument.label}
          title={mark.labels.join(", ")}
          size={glyphSize}
        />
      ))}
    </span>
  )
}
