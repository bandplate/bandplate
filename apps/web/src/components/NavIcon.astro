---
// AppLayout's nav icons (sidebar + tab bar), from Lucide like every other
// icon in the app, at a lighter 1.75 stroke so a row of them does not shout
// over the labels beside them. Lives here rather than packages/ui because it
// is specific to this one shell, not a primitive other pages compose.
//
// The choices that are not obvious:
//   - takes: a cassette, not a plate. The plate is what a take BECOMES once
//     the band keeps it; the cassette is the take before the verdict.
//   - admin: faders, not a cog. Admin is where the band's own vocabulary is
//     set, and a cog would read as "settings", which this section is not.
//   - instruments: a list of music, because the page is a vocabulary; no
//     single instrument can stand for the whole of it.
//   - tokens: a key, because a service token is handed OUT.
import Calendar from "@lucide/astro/icons/calendar";
import CassetteTape from "@lucide/astro/icons/cassette-tape";
import House from "@lucide/astro/icons/house";
import KeyRound from "@lucide/astro/icons/key-round";
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import ListMusic from "@lucide/astro/icons/list-music";
import Music from "@lucide/astro/icons/music";
import SlidersVertical from "@lucide/astro/icons/sliders-vertical";
import User from "@lucide/astro/icons/user";
import Users from "@lucide/astro/icons/users";

export interface Props {
  name:
    | "home"
    | "songs"
    | "events"
    | "takes"
    | "admin"
    | "me"
    | "overview"
    | "members"
    | "instruments"
    | "tokens";
}

const ICONS = {
  home: House,
  songs: Music,
  events: Calendar,
  takes: CassetteTape,
  admin: SlidersVertical,
  me: User,
  overview: LayoutGrid,
  members: Users,
  instruments: ListMusic,
  tokens: KeyRound,
} as const;

const Icon = ICONS[Astro.props.name];
---

<Icon size={20} stroke-width={1.75} aria-hidden="true" focusable="false" />
