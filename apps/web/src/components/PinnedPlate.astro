---
// A pinned thing, drawn as a plate: a dark grooved disc with a centre label
// carrying its name. This is the one place in the app that spends a real image
// on an object, and it is the right place — the app is called bandplate, the
// design direction is Dubplate, and these are the things a member reaches for.
// A list of rows is what made home read as undifferentiated stuff.
//
// The label's colour says which KIND of thing it is without a word: gold for a
// take (the same accent the play control uses, because a take is the thing you
// play) and bone for a song or an event (a container, not a recording). The
// caption under the plate says it in words too — colour alone is never the only
// carrier of meaning here, same rule the vote buttons follow.
import { formatShortDate, messages, playerMessages } from "@bandplate/i18n";
import { Pause, Play } from "@lucide/astro";
import { eventName } from "../server/format.js";
import { type PinnedItem, pinnedKindWord } from "../server/pages/home.js";

// One size. Home used to lead with a large "hero" plate beside a title and put
// the rest in a rail of smaller ones; the split read as two unrelated things,
// so every pin is now the same plate in one row (sized in CSS, smaller on a
// phone), each carrying its own link and caption.
export interface Props {
  item: PinnedItem;
}

const { item } = Astro.props;

const href =
  item.kind === "take"
    ? `/takes/${item.id}`
    : item.kind === "song"
      ? `/songs/${item.song.slug}`
      : `/events/${item.id}`;

const locale = Astro.locals.locale;
const t = messages(locale);

// What goes on the centre label. A take borrows its song's name — a take has no
// name of its own, and "9 Dec 2025" on the label of a record is what an event
// is actually called.
const label =
  item.kind === "take"
    ? (item.song?.title ?? t.home.untitled)
    : item.kind === "song"
      ? item.song.title
      : formatShortDate(locale, item.event.heldAt);

// The caption: what this IS, then what it has. A member scanning the rail
// should not have to work out from a row's shape whether they pinned the song
// or one take of it.
const kindWord = pinnedKindWord(item, locale);

// A personal event's caption says whose day it was, beside its kind: the
// label already carries the date, and "osobní nahrávky" alone does not say
// whose. The count stays in the plate's accessible name.
const personalOwner =
  item.kind === "event" && item.event.kind === "personal" ? item.ownerName : null;
const detail =
  item.kind === "take"
    ? formatShortDate(locale, item.take.recordedAt)
    : item.kind === "song"
      ? t.events.takeCount(item.takeCount)
      : (personalOwner ?? t.events.takeCount(item.takeCount));

const accessibleName =
  item.kind === "take"
    ? t.home.plateTakeName({ name: label, date: detail })
    : item.kind === "song"
      ? t.home.plateSongName({ name: label, detail })
      : t.home.plateEventName({
          name: eventName(item.event, item.ownerName) || kindWord,
          detail: t.events.takeCount(item.takeCount),
        });

// Gold for a take, bone for a container. See the header comment.
const labelTone = item.kind === "take" ? "take" : "container";
// Only a take can be played, and only when it has a ready master.
const playable = item.kind === "take" ? item.playableAssetId : undefined;
const playTitle = item.kind === "take" ? (item.song?.title ?? t.home.untitled) : "";
const playSubtitle = item.kind === "take" ? (item.take.label ?? detail) : "";
---

<div class={`bp-plate bp-plate--${labelTone}`}>
  {/* The link is an OVERLAY, not the wrapper.
      A plate used to be one big `<a>`, which made the play badge inside it
      decoration — clicking it could only ever navigate, because a `<button>`
      cannot live inside an anchor. Playing from the shelf is the whole point
      of the shelf, so the anchor moves to a layer of its own and the badge
      becomes a real control on top of it. One link and one button, siblings,
      no nesting. */}
  <a class="bp-plate-hit" href={href} aria-label={accessibleName} />
  <span class="bp-plate-disc" aria-hidden={playable ? undefined : "true"}>
    <span class="bp-plate-label" aria-hidden="true">
      {label}
    </span>
    <span class="bp-plate-spindle" aria-hidden="true" />
  </span>
  {
      playable && (
        /* A SIBLING of the disc, not a child of it.
           Inside, it was unclickable: the disc takes a `transform` on hover,
           a transform makes a stacking context, and the button's `z-index`
           was trapped in it — so the whole disc, button included, fell under
           the link overlay exactly whenever the pointer was on it. Out here
           its `z-index` is measured against the same context as the link.

           Same `data-audio-source` contract `PlayToggleButton.astro` uses, so
           the persistent player's one document-level click delegate picks this
           up with no island of its own — see `Player.tsx`'s header. */
        <button
          type="button"
          class="bp-plate-play"
          data-audio-source
          data-take-id={item.id}
          data-asset-id={playable}
          data-title={playTitle}
          data-subtitle={playSubtitle}
          data-source-kind="master"
          data-role="toggle"
          aria-pressed="false"
          aria-label={playerMessages(locale).play(playTitle)}
        >
          <Play size={11} class="bp-play-icon-play" aria-hidden="true" fill="currentColor" />
          <Pause size={11} class="bp-play-icon-pause" aria-hidden="true" fill="currentColor" />
        </button>
      )
    }
  <span class="bp-plate-caption" aria-hidden="true">
    <span class="bp-kind">{kindWord}</span>
    <span class="bp-plate-caption-sep" />
    <span>{detail}</span>
  </span>
</div>
