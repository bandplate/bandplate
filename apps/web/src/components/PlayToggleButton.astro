---
import { playerMessages } from "@bandplate/i18n";
import Pause from "@lucide/astro/icons/pause";
import Play from "@lucide/astro/icons/play";
// The play/pause affordance — shared markup for `TakeRow.astro`'s leading
// slot and the take-detail hero, so both stay wired to the persistent
// player (`Player.tsx`) the exact same way rather than two copies of the
// same `data-*` contract drifting apart. Plain markup, no island of its
// own — see `Player.tsx`'s header comment for why (one shared document
// click delegate, not N per-row islands).
//
// Never rendered for a take with no playable asset — that decision is the
// CALLER's (a take with none renders no `<PlayToggleButton>` at all, not
// this component with a disabled prop), per the brief's "no fake play
// affordance" rule.
export interface Props {
  takeId: string;
  assetId: string;
  /** Song title or a fallback label — the accessible name this control announces (`Play <title>` / `Pause <title>`). */
  title: string;
  /** Event/date context or the take's own label. */
  subtitle?: string;
  size?: "sm" | "lg";
  /**
   * Given, the control is a labelled pill ("▶ Přehrát tuhle nahrávku"), the
   * shape "Přehrát vše" has: a small accent disc inside a secondary button.
   * Same `data-*` contract either way, which is all the player reads.
   */
  label?: string;
}

const { takeId, assetId, title, subtitle = "", size = "sm", label } = Astro.props;
const dataAttrs = {
  "data-audio-source": true,
  "data-take-id": takeId,
  "data-asset-id": assetId,
  "data-title": title,
  "data-subtitle": subtitle,
  "data-source-kind": "master",
  "data-role": "toggle",
};
const ariaLabel = playerMessages(Astro.locals.locale).play(title);
---

{
  label ? (
    <button
      type="button"
      class="bp-btn bp-btn-secondary bp-btn-sm bp-btn-play-all bp-play-pill"
      {...dataAttrs}
      aria-pressed="false"
      aria-label={ariaLabel}
    >
      <span class="bp-btn-play-disc" aria-hidden="true">
        <Play size={13} class="bp-play-icon-play" fill="currentColor" />
        <Pause size={13} class="bp-play-icon-pause" fill="currentColor" />
      </span>
      {label}
    </button>
  ) : (
    <button
      type="button"
      class={`bp-play-toggle ${size === "lg" ? "bp-play-toggle-lg" : ""}`}
      {...dataAttrs}
      aria-pressed="false"
      aria-label={ariaLabel}
    >
      <Play size={size === "lg" ? "28" : "18"} class="bp-play-icon-play" aria-hidden="true" fill="currentColor" />
      <Pause size={size === "lg" ? "28" : "18"} class="bp-play-icon-pause" aria-hidden="true" fill="currentColor" />
    </button>
  )
}
