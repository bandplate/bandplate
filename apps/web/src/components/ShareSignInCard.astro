---
// What a signed-out visitor gets from a MEMBERS' share link (`/s/<code>`):
// a tiny page a link preview can read (WhatsApp, Messenger and Signal fetch
// it with no session) carrying the target's title and one factual line, and
// nothing else, which sends a person straight on to sign in. A whole
// document of its own, not `Layout`: no fonts, no script, for a page nobody
// is meant to look at for longer than the redirect takes. It does carry the
// app's stylesheet, which Astro attaches per ROUTE and `/s/[code]` also
// renders the public page; nothing here uses it, and a crawler does not
// fetch it.
import { messages } from "@bandplate/i18n";

export interface Props {
  title: string;
  description: string;
  /** Absolute: a crawler has no page to resolve a relative one against. */
  pageUrl: string;
  imageUrl: string;
  loginPath: string;
}

const { title, description, pageUrl, imageUrl, loginPath } = Astro.props;
const locale = Astro.locals.locale;
const t = messages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} | bandplate`}</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bandplate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.shell.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta http-equiv="refresh" content={`0;url=${loginPath}`} />
  </head>
  <body>
    <p><a href={loginPath}>{t.auth.shareSignIn}</a></p>
  </body>
</html>
