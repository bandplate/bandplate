---
// One recording from the stash, opened from its row — what it is (song, the
// personal day it sits in, who recorded it), the one thing to do with it (add
// it to the song, where the band hears it) and the three lesser ones (rename,
// download, delete).
//
// A SHEET, like every other "a panel of controls about one thing" in this app
// (see `RecordSheet.astro`): the member is looking at a list of four ideas
// from last Tuesday, and picking one should not take the list away. The
// recording still has a page of its own at `/stash/[id]`, which is where the
// row's link goes when there is no script to open the sheet with — and that
// page renders THIS component with `standalone`, so there is one publish
// form, one set of refusals and one delete in the codebase, not two that have
// to be kept saying the same thing.
//
// Two forms, two sheets. HTML drops a `<form>` inside a `<form>` (see
// docs/frontend-traps.md), so renaming is not a field tucked into the publish
// form: it is its own sheet beside this one, opened from it, and with
// scripting off both render as plain blocks and both still submit.
//
// Every write posts to the CURRENT page with the take named in the body, so
// this component works unchanged in the list and on the item's own page. The
// owner check is on the write itself (`applyStashWrite`), never on the route.
import { formatShortDate, messages } from "@bandplate/i18n";
import Field from "@bandplate/ui/components/Field.astro";
import type { SongOption } from "../client/recorder-logic.js";
import { stashName, stashNote, stashSongField } from "../client/stash-display.js";
import { stashRenameSheetId, stashSheetId } from "../client/stash-sheet-ids.js";
import { formatDuration } from "../server/format.js";
import type { StashRowData } from "../server/pages/stash.js";
import RecordSheet from "./RecordSheet.astro";

export interface Props {
  row: StashRowData;
  /** Who recorded it — every row in a member's stash is that member's. */
  ownerName: string | undefined;
  /** The library, for a recording that has no song yet. Empty otherwise. */
  songChoices: SongOption[];
  /** Set under the field when THIS recording's rename was refused. */
  renameError?: string | undefined;
  /**
   * Where this sheet's own caller wants the member back after a write —
   * its own page, not necessarily the stash view. Undefined (the default)
   * is the stash view's own behaviour: publish lands on the take's own
   * page (`applyStashWrite`'s default) and delete's confirm goes back to
   * `/takes?stash=1`. The song page's own stash section passes its own URL
   * here so both writes return to it instead.
   */
  returnTo?: string;
  /**
   * This sheet IS the page — `/stash/[id]`, which is one recording and
   * nothing else.
   *
   * It lays out in the flow at every width (`inline`), and it drops the Close
   * button, which on a page closes nothing. The rename sheet beside it stays
   * a real dialog: there the button that opens it is right there.
   */
  standalone?: boolean;
}

const { row, ownerName, songChoices, renameError, returnTo, standalone = false } = Astro.props;
const locale = Astro.locals.locale;
const t = messages(locale);
const nameParts = { songId: row.songId, songTitle: row.song?.title, label: row.label };
const nameWords = { noSong: t.stash.noSongYet, unknownSong: t.stash.unknownSong };
// What this recording is called, what goes under that, and what its "Píseň"
// field says — three different questions since a recording can have no song.
const title = stashName(nameParts, nameWords);
const note = stashNote(nameParts, nameWords);
const songField = stashSongField(nameParts, nameWords);
const length = formatDuration(row.durationMs);
const subtitle = note ? t.stash.songAndLength(note, length) : length;
// The song has to be chosen before the recording can go to the band, so the
// picker is part of the publish form rather than a step before it.
const needsSong = !row.songId;
const canPublishHere = Boolean(row.playableAssetId) && (!needsSong || songChoices.length > 0);
// Where the delete goes after it has run, with script and without it. With
// script the dialog follows `data-confirm-redirect`; with none, the confirm
// PAGE reads `?returnTo=` off its own URL, which is why the same destination
// rides along on the link. A caller that named one gets it back; the stash
// view names none and gets its own list, told which recording went so it can
// drop a local copy still waiting to upload into it.
const deleteHref = returnTo
  ? `/stash/${row.id}/delete?returnTo=${encodeURIComponent(returnTo)}`
  : `/stash/${row.id}/delete`;
const afterDelete = returnTo ?? `/takes?stash=1&deleted=${row.id}`;
---

<RecordSheet id={stashSheetId(row.id)} eyebrow={t.stash.sheetEyebrow} title={title} subtitle={subtitle} inline={standalone}>
  <form method="post" class="bp-sheet-form">
    <input type="hidden" name="intent" value="publish" />
    <input type="hidden" name="takeId" value={row.id} />
    {returnTo && <input type="hidden" name="returnTo" value={returnTo} />}
    <div class="bp-sheet-body">
      {/* Labelled fields, not a run joined by dots: three different facts. */}
      <dl class="bp-stash-facts">
        <div>
          <dt>{t.stash.fieldSong}</dt>
          <dd>{songField}</dd>
        </div>
        <div>
          <dt>{t.stash.fieldEvent}</dt>
          <dd>{t.stash.personalEvent(formatShortDate(locale, row.event?.heldAt ?? row.recordedAt))}</dd>
        </div>
        <div>
          <dt>{t.stash.fieldBy}</dt>
          <dd>{ownerName}</dd>
        </div>
      </dl>

      {/* No fake affordances, and the NEAREST obstacle first: a recording still
          on its way from the phone cannot be added whatever the library holds,
          so that is what the sheet says. Only once the file has landed is an
          empty library the thing in the way. */}
      {!row.playableAssetId ? (
        <p class="bp-field-hint bp-m0">{t.stash.stillUploading}</p>
      ) : needsSong && songChoices.length === 0 ? (
        <p class="bp-field-hint bp-m0">{t.stash.noSongs}</p>
      ) : (
        <>
          <p class="bp-m0">{t.stash.publishNote}</p>
          {needsSong && (
            <div class="bp-stash-song-pick">
              <label class="bp-field-label" for={`publish-song-${row.id}`}>{t.stash.chooseSong}</label>
              <select id={`publish-song-${row.id}`} name="songId" class="bp-input" required>
                <option value="">{t.stash.chooseSongPlaceholder}</option>
                {songChoices.map((choice) => (
                  <option value={choice.id}>{choice.title}</option>
                ))}
              </select>
            </div>
          )}
        </>
      )}

      <div class="bp-stash-item-actions">
        <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm" data-sheet-open={stashRenameSheetId(row.id)}>
          {t.stash.rename}
        </button>
        {row.playableAssetId && (
          <a href={`/api/assets/${row.playableAssetId}/download`} class="bp-btn bp-btn-secondary bp-btn-sm">
            {/* The same glyph the take page's download wears. */}
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v12" />
              <path d="M7 11l5 5 5-5" />
              <path d="M4 20h16" />
            </svg>
            {t.stash.download}
          </a>
        )}
      </div>
      {/* The app's danger pattern, the same as a song's sheet: not a button
          beside Rename and Download but a text link under the rule, apart
          from them, so the one action that cannot be undone never reads as
          one more of the everyday ones. The solid plate belongs to the
          confirm dialog it opens. */}
      <div class="bp-sheet-extras">
        <a
          href={deleteHref}
          class="bp-sheet-danger"
          data-confirm
          data-confirm-title={t.stash.deleteTitle(title)}
          data-confirm-body={t.stash.deleteBody}
          data-confirm-action={deleteHref}
          data-confirm-cta={t.stash.deleteCta}
          data-confirm-redirect={afterDelete}
        >
          {t.stash.deleteForGood}
        </a>
      </div>
    </div>
    <div class="bp-sheet-foot">
      {/* One-way, so it asks: nothing puts a shared recording back in the
          stash. The dialog submits THIS form, so the song picked above goes
          with it. Neutral tone: sharing is not destruction. */}
      {canPublishHere && (
        <button
          type="submit"
          class="bp-btn bp-btn-primary"
          data-confirm
          data-confirm-tone="neutral"
          data-confirm-title={t.stash.publishConfirmTitle}
          data-confirm-body={t.stash.publishNote}
          data-confirm-cta={t.stash.publish}
        >
          {t.stash.publish}
        </button>
      )}
      {/* No Close on a page: there is nothing to close, and a button that
          does nothing is the fake affordance this app does not render. */}
      {!standalone && <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.stash.close}</button>}
    </div>
  </form>
</RecordSheet>

<RecordSheet id={stashRenameSheetId(row.id)} eyebrow={t.stash.rename} title={title}>
  <form method="post" class="bp-sheet-form" novalidate>
    <input type="hidden" name="intent" value="rename" />
    <input type="hidden" name="takeId" value={row.id} />
    <div class="bp-sheet-body">
      <Field label={t.stash.labelField} name="label" id={`stash-label-${row.id}`} value={row.label ?? ""} maxlength={200} error={renameError} />
    </div>
    <div class="bp-sheet-foot">
      <button type="submit" class="bp-btn bp-btn-primary">{t.stash.renameSave}</button>
      <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.stash.cancel}</button>
    </div>
  </form>
</RecordSheet>
