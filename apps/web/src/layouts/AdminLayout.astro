---
import type { MemberPrincipal } from "@bandlib/core";
import ConfirmDialog from "../components/ConfirmDialog.tsx";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  principal: MemberPrincipal;
  current: "overview" | "members" | "instruments" | "tokens";
}

const { title, principal, current } = Astro.props;

const navItems = [
  { key: "overview", label: "Overview", href: "/admin" },
  { key: "members", label: "Members", href: "/admin/members" },
  { key: "instruments", label: "Instruments", href: "/admin/instruments" },
  { key: "tokens", label: "Tokens", href: "/admin/tokens" },
] as const;
---

<Layout title={`Admin — ${title}`}>
  <div class="bl-container bl-stack">
    <header class="bl-stack" style="gap: 0.75rem;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap: 0.75rem;">
        <h1 class="font-bl-display" style="font-size: 1.75rem; margin: 0;">bandlib admin</h1>
        <form method="post" action="/logout">
          <button type="submit" class="bl-btn bl-btn-secondary bl-btn-sm">
            Sign out ({principal.role})
          </button>
        </form>
      </div>
      <nav aria-label="Admin sections">
        <ul style="display:flex; flex-wrap:wrap; gap: 0.5rem; list-style:none; padding:0; margin:0;">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="bl-btn bl-btn-sm"
                  class:list={[item.key === current ? "bl-btn-primary" : "bl-btn-secondary"]}
                  aria-current={item.key === current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" class="bl-stack">
      <slot />
    </main>
  </div>
  <ConfirmDialog client:load />
</Layout>
