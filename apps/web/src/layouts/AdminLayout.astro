---
import type { MemberPrincipal } from "@bandplate/core";
import ConfirmDialog from "../components/ConfirmDialog.tsx";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  principal: MemberPrincipal;
  current: "overview" | "members" | "instruments" | "tokens";
}

const { title, principal, current } = Astro.props;

const navItems = [
  { key: "overview", label: "Overview", href: "/admin" },
  { key: "members", label: "Members", href: "/admin/members" },
  { key: "instruments", label: "Instruments", href: "/admin/instruments" },
  { key: "tokens", label: "Tokens", href: "/admin/tokens" },
] as const;
---

<Layout title={`Admin — ${title}`}>
  <div class="bp-container bp-stack">
    <header class="bp-stack bp-stack-tight">
      <div class="bp-header-row">
        <h1 class="bp-admin-title">bandplate admin</h1>
        <form method="post" action="/logout">
          <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">
            Sign out ({principal.role})
          </button>
        </form>
      </div>
      <nav aria-label="Admin sections">
        <ul class="bp-inline-nav-list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="bp-btn bp-btn-sm"
                  class:list={[item.key === current ? "bp-btn-primary" : "bp-btn-secondary"]}
                  aria-current={item.key === current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" class="bp-stack">
      <slot />
    </main>
  </div>
  <ConfirmDialog client:load />
</Layout>
