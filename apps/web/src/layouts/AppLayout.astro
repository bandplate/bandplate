---
import { ClientRouter } from "astro:transitions";
// The member-facing app shell (Task 5) — Songs / Events / Search / Me, no
// hierarchy between them. A bottom tab bar on phones, a persistent sidebar
// past `lg` (1024px); see components.css's "App shell" section for why
// these are two separate elements rather than one reflowed with media
// queries. `<ClientRouter />` gives every page under this layout animated
// navigation (with a progress bar — see the inline script below) without
// any page needing its own client-side JS; it respects
// `prefers-reduced-motion` itself (Astro's built-in behavior).
import type { MemberPrincipal } from "@bandplate/core";
import { messages } from "@bandplate/i18n";
import Logo from "@bandplate/ui/components/Logo.astro";
import ConfirmDialog from "../components/ConfirmDialog.tsx";
import NavIcon from "../components/NavIcon.astro";
import Player from "../components/Player.tsx";
import VoteFavorite from "../components/VoteFavorite.tsx";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  /**
   * The one sentence under the title in a link preview, and the page's own
   * `<meta name="description">`.
   *
   * Forwarded to `Layout`, which is where the default lives. A page that
   * knows what it is about — a take, a song, an event — should say so rather
   * than repeat the product pitch; see `Layout`'s own note for why that is
   * safe to do on a private archive.
   */
  description?: string;
  /**
   * The page's own name, for the phone's header row. A list page (Songs,
   * Events, Takes) spends that row on the product name and then a whole
   * second row on its own title beside two buttons, which is where they
   * overflowed. Given one, the phone header shows the mark and this, and the
   * page's own `.bp-page-title` stays in the document (it is still the h1)
   * but steps out of sight, so the page's buttons get a row of their own.
   * Past `lg` the header is gone and nothing changes.
   *
   * A detail page (a song, an event, a take) does the same, with its hero
   * heading marked `.bp-titled-heading` instead of `.bp-page-title`, its
   * favorite star passed as the `header-actions` slot so the star stays
   * beside the name it belongs to, and its facts as `headerSubtitle`.
   */
  headerTitle?: string;
  /** A count shown after `headerTitle`, in the muted tone: "Skladby (8)". */
  headerCount?: number;
  /**
   * A detail page's facts, one small line under the name: "Dmi, 76 bpm",
   * "Zkouška, Dezerter". The page's own copy is `.bp-titled-facts`, hidden
   * on a phone the way the h1 is, so the facts sit with the name they
   * describe instead of in pieces below the header.
   */
  headerSubtitle?: string;
  /**
   * What opens the facts line, in the ink colour: a take's own label, "take 1"
   * or "new arrangement". It is what tells two takes of one song apart, so it
   * is never the part that gets cut. It sat after the name as "Dezertér: take
   * 1" until a long label wrapped the header onto two lines of title and
   * shoved the star to the far edge.
   */
  headerSubtitleLead?: string;
  principal: MemberPrincipal;
  current: NavKey;
  // Which admin section is open, when `current` is "admin". The sidebar lists
  // the four of them directly (see below), so it needs to know which one is
  // the page rather than just that the page is somewhere under /admin.
  adminSection?: "overview" | "members" | "instruments" | "tokens";
  /**
   * `/takes/:id/mix` owns its page's audio outright, and both of these exist
   * for that one page.
   *
   * NO ROUTER: `ClientRouter` replaces the body without unmounting islands, so
   * a Preact cleanup never runs — and removing an `<audio>` from the DOM does
   * not stop it. It plays until garbage collection, and it is never collected,
   * because a live `AudioContext` holds a `MediaElementAudioSourceNode` which
   * holds the element. Navigate away from the mixer under a view transition
   * and seven stems keep playing off-screen with no control anywhere.
   *
   * NO SHELL PLAYER: two engines, one pair of ears.
   *
   * Turning the router off makes EVERY link off that page a full navigation,
   * which is the point: the invariant holds for the sidebar, the tab bar, the
   * back link and whatever someone adds next year, without anyone having to
   * remember `data-astro-reload` on it.
   */
  transitions?: boolean;
  shellPlayer?: boolean;
  /**
   * The app's navigation: the header, the sidebar and the tab bar.
   *
   * Off for the mixer, which is the one page that is a TOOL rather than a
   * view of the band's things. A stack of lanes on one time axis wants every
   * pixel of width it can have, and the sidebar was spending a fifth of a
   * desktop window on links to somewhere you are not going while you play
   * along. The way out is the page's own "back to the take" button, which
   * puts you somewhere the full navigation exists.
   */
  chrome?: boolean;
}

const {
  title,
  description,
  headerTitle,
  headerCount,
  headerSubtitle,
  headerSubtitleLead,
  principal,
  current,
  adminSection,
  transitions = true,
  shellPlayer = true,
  chrome = true,
} = Astro.props;

const isAdmin = principal.role === "admin";

/** The keys `NavIcon` draws and `current` is compared against. */
type NavKey = "home" | "songs" | "events" | "takes" | "admin" | "me";

// Home, then the band's things, then yours. Admin is deliberately NOT in this
// list.
//
// Home used to reach the nav only through the wordmark, which is a link people
// know on the web and do not necessarily look for on a phone — and the phone
// has no wordmark in reach at all, only the tab bar. A page every other page
// links back to should be reachable the same way as the rest of them.
const t = messages(Astro.locals.locale);

const navItems = [
  { key: "home", label: t.shell.nav.home, href: "/" },
  { key: "songs", label: t.shell.nav.songs, href: "/songs" },
  { key: "events", label: t.shell.nav.events, href: "/events" },
  { key: "takes", label: t.shell.nav.takes, href: "/takes" },
  { key: "me", label: t.shell.nav.me, href: "/me" },
] as const;

// Admin is its own SECTION of the sidebar, under a rule and its own label,
// rather than a fifth peer of Songs and Events: it is a different mode of
// using the app — running the band's account rather than listening to it —
// and the four sections below are its own navigation, not the app's. Listing
// them here is also what lets the section pills stay a phone-only control.
const adminItems = [
  { key: "overview", label: t.shell.adminNav.overview, href: "/admin" },
  { key: "members", label: t.shell.adminNav.members, href: "/admin/members" },
  { key: "instruments", label: t.shell.adminNav.instruments, href: "/admin/instruments" },
  { key: "tokens", label: t.shell.adminNav.tokens, href: "/admin/tokens" },
] as const;

// The phone has no sidebar to hold a section, so there Admin stays one tab —
// the door, with `AdminHeader`'s pills behind it. Before Me, so the bar still
// reads left to right from the band's stuff to yours.
//
// Built by splitting off the LAST item rather than by index. It was
// `slice(0, 3)` plus `navItems[3]`, which silently meant "everything before Me,
// then Me" only for as long as the list was four long — adding Home to the
// front of it dropped Me from the bar and put Takes where it had been.
const tabItems: readonly { key: NavKey; label: string; href: string }[] = isAdmin
  ? [
      ...navItems.slice(0, -1),
      { key: "admin", label: t.shell.nav.admin, href: "/admin" },
      ...navItems.slice(-1),
    ]
  : navItems;
---

<Layout title={title} description={description}>
  {transitions && <ClientRouter />}
  <div
    class="bp-route-progress"
    id="route-progress"
    aria-hidden="true"
    transition:persist="route-progress"
  ></div>
  <div class={headerTitle ? "bp-shell bp-shell--titled" : "bp-shell"} data-member-id={principal.memberId}>
    {
      chrome && (
        <header class="bp-shell-header">
          {headerTitle ? (
            <>
              {/* The mark alone still goes home, so it has to say so. */}
              <a href="/" class="bp-shell-wordmark" aria-label="bandplate">
                <Logo size={24} id="header" class="bp-shell-mark" />
              </a>
              <div class="bp-shell-titles">
                <div class="bp-shell-title-line">
                  {/* A picture of the h1, not a second one: the heading is
                      the page's own, which a screen reader already reaches. */}
                  <p class="bp-shell-title bp-m0" aria-hidden="true">
                    {headerTitle}
                    {headerCount !== undefined && <span class="bp-title-count"> ({headerCount})</span>}
                  </p>
                  {/* A real control, so outside the aria-hidden picture. The
                      page's own copy of it is out of the tree on a phone
                      (display: none), so there is exactly one star to reach.
                      On the name's line, not after the block: under a wider
                      subtitle it would drift away from the name it marks. */}
                  {Astro.slots.has("header-actions") && (
                    <div class="bp-shell-header-actions">
                      <slot name="header-actions" />
                    </div>
                  )}
                </div>
                {/* A picture too: the page's own copy of these facts is
                    marked `.bp-titled-facts` and read in its place. */}
                {(headerSubtitle || headerSubtitleLead) && (
                  <p class="bp-shell-subtitle bp-m0" aria-hidden="true">
                    {/* One line, no breaks between the parts: a newline in
                        here is a text node, and ", " would grow a space in
                        front of it. */}
                    {headerSubtitleLead && <span class="bp-shell-subtitle-lead">{headerSubtitleLead}</span>}{headerSubtitleLead && headerSubtitle && ", "}{headerSubtitle}
                  </p>
                )}
              </div>
              {/* A list page's one write action, at the far end of the line:
                  its own copy in the page is hidden on a phone, so this is
                  the only one there. */}
              {Astro.slots.has("header-end") && (
                <div class="bp-shell-header-end">
                  <slot name="header-end" />
                </div>
              )}
            </>
          ) : (
            <a href="/" class="bp-shell-wordmark">
              <Logo size={24} id="header" class="bp-shell-mark" />
              bandplate
            </a>
          )}
        </header>
      )
    }
    {/* A second row joined under the header, phone only: a detail page's
        measurable facts (a take's length, line-up and ruling). A picture of
        the page's own copy, which is `.bp-titled-facts` and read in its place,
        so this one is hidden from assistive tech. */}
    {chrome && headerTitle && Astro.slots.has("header-panel") && (
      <div class="bp-shell-subbar" aria-hidden="true">
        <slot name="header-panel" />
      </div>
    )}
    <div class="bp-shell-body">
      {chrome && (
      <nav class="bp-sidebar" aria-label={t.shell.navLabel}>
        <a href="/" class="bp-shell-wordmark">
          <Logo size={26} id="sidebar" class="bp-shell-mark" />
          bandplate
        </a>
        <ul class="bp-sidebar-nav">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="bp-sidebar-item"
                  aria-current={item.key === current ? "page" : undefined}
                >
                  <span class="bp-sidebar-icon">
                    <NavIcon name={item.key} />
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          isAdmin && (
            <div class="bp-sidebar-group">
              <p class="bp-eyebrow bp-sidebar-group-label bp-m0">{t.shell.adminGroupLabel}</p>
              <ul class="bp-sidebar-nav">
                {adminItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="bp-sidebar-item bp-sidebar-subitem"
                      aria-current={
                        current === "admin" && adminSection === item.key ? "page" : undefined
                      }
                    >
                      <span class="bp-sidebar-icon">
                        <NavIcon name={item.key} />
                      </span>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </nav>
      )}
      <main id="main" class={`bp-shell-main${chrome ? "" : " bp-shell-main-bare"}`}>
        <slot />
      </main>
    </div>
    {
      chrome && (
        <nav class="bp-tabbar" aria-label={t.shell.navLabel}>
          {tabItems.map((item) => (
            <a
              href={item.href}
              class="bp-tabbar-item"
              aria-current={item.key === current ? "page" : undefined}
            >
              <span class="bp-tabbar-icon">
                <NavIcon name={item.key} />
              </span>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
    {shellPlayer && <Player client:load transition:persist="bp-player" locale={Astro.locals.locale} />}
    <VoteFavorite client:load transition:persist="bp-vote-favorite" />
    {/* One per document, in the shell — it listens on `document` for any
        `[data-confirm]` click, so a second copy would open two dialogs. It
        lived in `AdminLayout` only, which meant the keeper/reject confirms on
        a take's own page never got the modal and always took the full
        confirm-page navigation instead. */}
    <ConfirmDialog client:load transition:persist="bp-confirm" locale={Astro.locals.locale} />
  </div>
</Layout>

<script>
  import "../client/install-prompt.js";
  import { startStashSync } from "../client/stash-sync.js";
  // Recordings left on this device by a dead-signal commute go up on the next
  // page anyone opens, not only when the stash view is open. Runs once per
  // document: ClientRouter navigations do not re-run this script. Only the
  // signed-in member's recordings: a shared browser holds everyone's.
  startStashSync(document.querySelector<HTMLElement>(".bp-shell")?.dataset.memberId ?? null);
  // Progress bar for View Transitions navigation — see components.css's
  // ".bp-route-progress" for the actual animation and its
  // prefers-reduced-motion override. Astro fires these events on
  // `document` around every ClientRouter-driven navigation; a plain <a>
  // click that ClientRouter intercepts goes through this same lifecycle.
  //
  // `transition:persist="route-progress"` — an EXPLICIT id — is what keeps
  // this the same DOM node across a navigation. Bare `transition:persist`
  // (no id) auto-generates one from a per-page count of transition
  // directives, and that count differs between pages (a take row emits one
  // `transition:name` per take, so `/songs`, a song with 8 takes, and an
  // event with 3 takes each land on a different auto id) — the node then
  // gets silently recreated instead of persisted, and a reference captured
  // before the swap goes stale. Belt-and-braces on top of the explicit id:
  // every handler below re-queries the live element by id rather than
  // trusting a reference captured once at module init, so a future
  // persistence regression fails loud (no bar animates) instead of quietly
  // animating a detached node nobody sees.
  let hideTimer: ReturnType<typeof setTimeout> | undefined;
  let armed = false; // true only once a real navigation has actually started

  document.addEventListener("astro:before-preparation", () => {
    const bar = document.getElementById("route-progress");
    if (!bar) {
      return;
    }
    armed = true;
    clearTimeout(hideTimer);
    bar.classList.remove("is-done");
    // Force reflow so re-adding "is-active" restarts the transition even
    // if a previous navigation left it applied.
    bar.classList.remove("is-active");
    void bar.offsetWidth;
    bar.classList.add("is-active");
  });
  document.addEventListener("astro:page-load", () => {
    const bar = document.getElementById("route-progress");
    // Fires on the very first page load too, with no preceding
    // "before-preparation" — nothing to finish animating in that case,
    // so leave the bar alone rather than snapping it to a visible,
    // fully-opaque "done" state that would then never get cleaned up.
    if (!bar || !armed) {
      return;
    }
    armed = false;
    bar.classList.remove("is-active");
    bar.classList.add("is-done");
    // Return to the resting (invisible) state once the "done" fill-in
    // transition has had time to finish, so the bar doesn't linger as a
    // permanent line across the top of the page.
    hideTimer = setTimeout(() => {
      bar.classList.remove("is-done");
    }, 300);
  });
</script>

<script>
  // Push unsubscribe on sign-out (Task 5). One listener for every
  // `[data-signout-form]` in the document — there is only one today (`/me`'s
  // header), but a second one (a menu, say) gets this for free rather than
  // needing its own copy.
  //
  // CAPTURE, same reasoning as the theme picker's listener above:
  // `<ClientRouter />` also listens for `submit` on `document`, in the
  // bubble phase, and decides whether to intercept the POST by reading
  // `event.defaultPrevented` when ITS listener runs. This one has to see the
  // event and call `preventDefault()` first, so the router's decision (soft
  // navigation vs. letting it through) is made with our hidden field already
  // filled in, not the empty value the form rendered with.
  //
  // `data-push-checked` is the loop guard: `form.requestSubmit()` re-fires
  // `submit` on the same form, which re-enters this same capture listener.
  // The second time through, the flag is already set, so this returns
  // immediately and the event proceeds untouched — through the router's own
  // listener, then as a real network POST — exactly as it would have without
  // this script at all.
  //
  // Every await in `resolveAndSubmit` is wrapped so it can never leave the
  // member stuck: whatever throws (no service worker, a revoked permission,
  // `unsubscribe()` rejecting), the `finally` still submits. Signing out
  // must never depend on push working.
  import { broadcastMemberSignal } from "../client/member-signal.js";
  import { endpointFieldValue } from "../client/push-logout.js";
  import { stopSyncingLocally } from "../client/stash-sync.js";

  async function resolveAndSubmit(form: HTMLFormElement) {
    const field = form.elements.namedItem("pushEndpoint");
    try {
      if ("serviceWorker" in navigator) {
        const registration = await navigator.serviceWorker.getRegistration();
        const subscription = registration ? await registration.pushManager.getSubscription() : null;
        if (field instanceof HTMLInputElement) {
          field.value = endpointFieldValue(subscription);
        }
        if (subscription) {
          await subscription.unsubscribe();
        }
      }
    } catch {
      // Nothing to do — the field stays whatever it already was (empty, on
      // the form's initial render), and the server falls back to leaving
      // push subscriptions alone for this device, same as the no-JS path.
    } finally {
      form.dataset.pushChecked = "1";
      form.requestSubmit();
    }
  }

  document.addEventListener(
    "submit",
    (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.hasAttribute("data-signout-form")) {
        return;
      }
      if (form.dataset.pushChecked === "1") {
        return; // the re-submission below — let it go through for real
      }
      event.preventDefault();
      // Tell every OTHER open tab "nobody's signed in" right now, not once
      // this tab's own next page finishes loading. `<ClientRouter />` may
      // turn the submission below into a soft navigation, which never
      // re-runs `startStashSync` (see the script above) — so without this,
      // a tab that stays open through the sign-out would keep drawing and
      // syncing the old member's stash until it happens to navigate again.
      broadcastMemberSignal(null);
      // `broadcastMemberSignal` above reaches every OTHER tab; it fires no
      // `storage` event in THIS one (writing `localStorage` never does, in
      // the tab that wrote it). The redirect to `/login` is itself a soft
      // `<ClientRouter />` navigation (confirmed by hand: this page's module
      // state survives it), so without this call this tab would keep
      // believing the member who just signed out is still signed in.
      try {
        // Same invariant as `resolveAndSubmit`'s own `try`/`finally` below:
        // nothing on this path may block sign-out. `setCurrentMember` ends in
        // a nanostores `atom.set`, which RE-THROWS if any subscriber's own
        // callback throws — an exception here, uncaught, would skip
        // `resolveAndSubmit(form)` entirely and leave the member stuck signed
        // in on screen. Losing the local reset is no worse than not having
        // made this call at all; the cross-tab signal and the server check
        // are still the real guarantees.
        stopSyncingLocally();
      } catch {
        // See above — deliberately swallowed.
      }
      resolveAndSubmit(form);
    },
    { capture: true },
  );

  // If `form.requestSubmit()` above never completes as a real navigation —
  // the POST fails, the tab is closed and bfcache-restored, a soft
  // `<ClientRouter />` swap lands on a page that persists this form — the
  // form is left with `data-push-checked="1"` set and never cleared. The
  // submit listener's loop guard then treats the NEXT sign-out click as
  // the re-submission it's guarding against, skips `resolveAndSubmit`
  // entirely, and the device's push subscription never gets unsubscribed.
  // Clearing the flag whenever the page is (re)shown — a fresh
  // `astro:after-swap` (soft navigation restores this same DOM) or
  // `pageshow` (bfcache restore, including `event.persisted === true`) —
  // means a second press always re-runs the real check.
  function resetPushCheckedGuard() {
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-signout-form]")) {
      delete form.dataset.pushChecked;
    }
  }
  document.addEventListener("astro:after-swap", resetPushCheckedGuard);
  window.addEventListener("pageshow", resetPushCheckedGuard);
</script>
