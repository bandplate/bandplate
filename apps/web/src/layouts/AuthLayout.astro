---
// The auth shell — direction L2, "split press".
//
// Every other page in the app renders inside `AppLayout` and is about the
// archive. These three (`/login`, `/login/[token]`, `/setup`) are the only
// ones a member reaches with no session, no nav, no player and no content,
// and until now they answered that by rendering a 26rem column top-aligned
// against an empty page.
//
// So the emptiness becomes the point: past `lg` the window splits, and the
// left half is a plate the size of the viewport bleeding off its own edge.
// It is the ONE place in the app that gets to say what this thing is —
// everywhere else the archive speaks for itself and a pitch would be noise.
// Below `lg` that half collapses to a band across the top, because a phone
// has no room for a picture and a form at once.
//
// The field is deliberately dark in BOTH themes, like `--bp-plate-vinyl`
// already is: a record is not a light object, and a plate rendered in bone
// on the light ground would be a plate nobody recognises. Its colours are the
// fixed palette (lacquer, groove, bone, dust) for exactly that reason:
// reaching for `--bp-color-fg` here would put lacquer on lacquer in light.
import { messages } from "@bandplate/i18n";
import Logo from "@bandplate/ui/components/Logo.astro";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  /** Passed through for the login-token page, which must never be indexed. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<Layout title={title} noindex={noindex}>
  <div class="bp-auth">
    <div class="bp-auth-field">
      {/* The plate itself: a ring, the grooved disc, its label and the
          spindle hole, all sharing one centre so the whole thing stays
          concentric at any pane width. Purely decorative — the mark that
          actually identifies the app is the wordmark below. */}
      <div class="bp-auth-plate" aria-hidden="true">
        <span class="bp-auth-plate-ring"></span>
        <span class="bp-auth-plate-disc"></span>
        <span class="bp-auth-plate-label"></span>
        <span class="bp-auth-plate-spindle"></span>
      </div>
      <p class="bp-auth-wordmark bp-m0">
        <Logo size={26} id="auth" class="bp-auth-mark" />
        bandplate
      </p>
      {/* The one sentence of pitch in the whole product. It is hidden on the
          phone band, where there is room for the wordmark and nothing else. */}
      <p class="bp-auth-pitch bp-m0">
        {messages(Astro.locals.locale).shell.shareDescription}
      </p>
    </div>
    <main id="main" class="bp-auth-pane">
      <div class="bp-auth-col">
        <slot />
      </div>
    </main>
  </div>
</Layout>
