---
import "@bandlib/ui/tokens/theme.css";
import "@bandlib/ui/tokens/components.css";

export interface Props {
  title: string;
  /** Set for pages that must never be indexed or cached by intermediaries (the login-token page). */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — bandlib</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Coda+Caption:wght@800&family=Familjen+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="bg-bl-bg text-bl-fg font-bl-body">
    <a href="#main" class="bl-skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
</style>
