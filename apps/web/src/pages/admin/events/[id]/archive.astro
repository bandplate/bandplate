---
import { eventsRepo, takesRepo } from "@bandplate/db";
import { adminMessages } from "@bandplate/i18n";
import { formatLongDate, messages } from "@bandplate/i18n";
// Archive (or unarchive) an event — the sibling of the song confirm page next
// door, with the same guard and the same dual-mode POST.
import ConfirmActionPage from "@bandplate/ui/components/ConfirmActionPage.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getAppDeps } from "../../../../server/app.js";
import { isSameOrigin } from "../../../../server/csrf.js";

import { archiveEventConsequence, setEventArchived } from "../../../../server/pages/events.js";

const ta = adminMessages(Astro.locals.locale);

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/events");
}

const archiving = Astro.url.searchParams.get("unarchive") !== "1";
const appDeps = await getAppDeps();
const isFetch = (Astro.request.headers.get("accept") ?? "").includes("text/plain");

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    return new Response("origin check failed", { status: 403 });
  }
  const result = await setEventArchived(appDeps.db, appDeps.clock.now(), id, archiving);
  if (isFetch) {
    return new Response(result.kind === "ok" ? "ok" : "not found", {
      status: result.kind === "ok" ? 200 : 404,
    });
  }
  if (result.kind !== "ok") {
    return new Response("Event not found.", { status: 404 });
  }
  return archiving
    ? Astro.redirect("/events?archived_ok=1")
    : Astro.redirect(`/events/${result.event.id}?saved=1`);
}

const event = await eventsRepo.getById(appDeps.db, id);
if (!event) {
  return new Response("Event not found.", { status: 404 });
}
const takeCount = await takesRepo.countByEvent(appDeps.db, event.id);
const locale = Astro.locals.locale;
const consequence = archiveEventConsequence(takeCount, locale);
// Named the same way the dialog names it, so the two doors to this action
// read alike — see `events.unarchiveConfirmTitle` on why the kind and the
// date travel as separate parts.
const t = messages(locale);
const what = t.events.archiveConfirmWhat({
  kind: t.events.kindLabel(event.kind),
  date: formatLongDate(locale, event.heldAt),
});
---

<Layout title={archiving ? ta.archiveEvent : ta.unarchiveEvent}>
  {
    archiving ? (
      <ConfirmActionPage
        bannerTitle={`Archive ${what}?`}
        cta={ta.archiveEvent}
        cancelHref={`/events/${event.id}`}
        cancelLabel={ta.cancel}
      >
        {consequence}
      </ConfirmActionPage>
    ) : (
      <ConfirmActionPage
        bannerTitle={`Put ${what} back?`}
        cta={ta.unarchiveEvent}
        cancelHref={`/events/${event.id}`}
        cancelLabel={ta.cancel}
        tone="neutral"
      >{ta.unarchiveEventBody}</ConfirmActionPage>
    )
  }
</Layout>
