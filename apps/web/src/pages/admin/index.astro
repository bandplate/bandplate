---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { listInstruments } from "../../server/pages/admin-instruments.js";
import { listMembers } from "../../server/pages/admin-members.js";
import { listTokens } from "../../server/pages/admin-tokens.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const [members, instruments, tokens] = await Promise.all([
  listMembers(appDeps.db),
  listInstruments(appDeps.db),
  listTokens(appDeps.db),
]);

const activeInstruments = instruments.filter((i) => i.archivedAt === null);
const activeTokens = tokens.filter((t) => t.revokedAt === null);
---

<AdminLayout title="Overview" principal={principal} current="overview">
  <div class="bl-stack" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem;">
    <a href="/admin/members" class="bl-card" style="text-decoration:none; color:inherit;">
      <p class="bl-field-hint" style="margin:0;">Members</p>
      <p class="font-bl-display" style="font-size: 2.5rem; margin: 0.25rem 0;">{members.length}</p>
      <p style="margin:0;">Manage the band roster, roles and status.</p>
    </a>
    <a href="/admin/instruments" class="bl-card" style="text-decoration:none; color:inherit;">
      <p class="bl-field-hint" style="margin:0;">Instruments</p>
      <p class="font-bl-display" style="font-size: 2.5rem; margin: 0.25rem 0;">{activeInstruments.length}</p>
      <p style="margin:0;">{instruments.length - activeInstruments.length} archived.</p>
    </a>
    <a href="/admin/tokens" class="bl-card" style="text-decoration:none; color:inherit;">
      <p class="bl-field-hint" style="margin:0;">Service tokens</p>
      <p class="font-bl-display" style="font-size: 2.5rem; margin: 0.25rem 0;">{activeTokens.length}</p>
      <p style="margin:0;">{tokens.length - activeTokens.length} revoked.</p>
    </a>
  </div>
</AdminLayout>
