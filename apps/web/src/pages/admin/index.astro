---
import { adminMessages } from "@bandplate/i18n";
import AdminHeader from "../../components/AdminHeader.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { listInstruments } from "../../server/pages/admin-instruments.js";
import { listMembers } from "../../server/pages/admin-members.js";
import { listTokens } from "../../server/pages/admin-tokens.js";

const ta = adminMessages(Astro.locals.locale);

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const [members, instruments, tokens] = await Promise.all([
  listMembers(appDeps.db),
  listInstruments(appDeps.db),
  listTokens(appDeps.db),
]);

const activeInstruments = instruments.filter((i) => i.archivedAt === null);
const activeTokens = tokens.filter((t) => t.revokedAt === null);
---

<AppLayout title={ta.title} principal={principal} current="admin" adminSection="overview">
  <div class="bp-stack">
    <AdminHeader title={ta.title} current="overview" />

    {/* Not `.bp-card`s. A count with a label under it is the thinnest content
        there is, and wrapping each in a bordered, filled panel with its own
        heading was the treatment that made this section read as a different
        product from the rest of the app. Same hairline-and-hover vocabulary
        the plates and rows use, at tile proportions. */}
    <div class="bp-admin-tiles">
      <a href="/admin/members" class="bp-admin-tile">
        <span class="bp-eyebrow">{ta.members}</span>
        <span class="bp-admin-tile-value">{members.length}</span>
        <span class="bp-admin-tile-note">{ta.membersBlurb}</span>
      </a>
      <a href="/admin/instruments" class="bp-admin-tile">
        <span class="bp-eyebrow">{ta.colInstruments}</span>
        <span class="bp-admin-tile-value">{activeInstruments.length}</span>
        <span class="bp-admin-tile-note">
          {instruments.length - activeInstruments.length} archived.
        </span>
      </a>
      <a href="/admin/tokens" class="bp-admin-tile">
        <span class="bp-eyebrow">{ta.serviceTokens}</span>
        <span class="bp-admin-tile-value">{activeTokens.length}</span>
        <span class="bp-admin-tile-note">{ta.revokedCount(tokens.length - activeTokens.length)}</span>
      </a>
    </div>
  </div>
</AppLayout>
