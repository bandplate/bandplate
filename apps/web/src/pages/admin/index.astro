---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { listInstruments } from "../../server/pages/admin-instruments.js";
import { listMembers } from "../../server/pages/admin-members.js";
import { listTokens } from "../../server/pages/admin-tokens.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const [members, instruments, tokens] = await Promise.all([
  listMembers(appDeps.db),
  listInstruments(appDeps.db),
  listTokens(appDeps.db),
]);

const activeInstruments = instruments.filter((i) => i.archivedAt === null);
const activeTokens = tokens.filter((t) => t.revokedAt === null);
---

<AdminLayout title="Overview" principal={principal} current="overview">
  <div class="bp-stat-grid">
    <a href="/admin/members" class="bp-card bp-card-link">
      <p class="bp-field-hint bp-m0">Members</p>
      <p class="bp-stat-value">{members.length}</p>
      <p class="bp-m0">Manage the band roster, roles and status.</p>
    </a>
    <a href="/admin/instruments" class="bp-card bp-card-link">
      <p class="bp-field-hint bp-m0">Instruments</p>
      <p class="bp-stat-value">{activeInstruments.length}</p>
      <p class="bp-m0">{instruments.length - activeInstruments.length} archived.</p>
    </a>
    <a href="/admin/tokens" class="bp-card bp-card-link">
      <p class="bp-field-hint bp-m0">Service tokens</p>
      <p class="bp-stat-value">{activeTokens.length}</p>
      <p class="bp-m0">{tokens.length - activeTokens.length} revoked.</p>
    </a>
  </div>
</AdminLayout>
