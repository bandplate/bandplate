---
import { adminMessages, validationMessage } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import { INSTRUMENT_GLYPHS, INSTRUMENT_GLYPH_CREDIT } from "@bandplate/ui/icons/instruments.js";
import { TRACK_COLORS, trackColorVar } from "@bandplate/ui/tokens/track-colors.js";
import AdminHeader from "../../../components/AdminHeader.astro";
import InstrumentIcon from "../../../components/InstrumentIcon.astro";
import RecordSheet from "../../../components/RecordSheet.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { getAppDeps } from "../../../server/app.js";
import { isSameOrigin } from "../../../server/csrf.js";
import {
  type InstrumentUsage,
  addInstrumentAlias,
  aliasesByInstrument,
  createInstrument,
  instrumentUsage,
  isInstrumentUnused,
  listInstruments,
  removeInstrumentAlias,
  updateInstrument,
  usageOf,
} from "../../../server/pages/admin-instruments.js";

const ta = adminMessages(Astro.locals.locale);

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();

let createError: string | undefined;
let createErrorField: "slug" | "label" | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent");

    if (intent === "create") {
      const result = await createInstrument(appDeps.db, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/instruments?created=1");
      }
      createError = validationMessage(Astro.locals.locale, result.error);
      createErrorField = result.field;
    } else if (intent === "update") {
      const id = String(formData.get("instrumentId") ?? "");
      const result = await updateInstrument(appDeps.db, id, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/instruments?updated=1");
      }
      formError = ta.instrumentUpdateFailed;
    } else if (intent === "add-alias") {
      const id = String(formData.get("instrumentId") ?? "");
      const result = await addInstrumentAlias(appDeps.db, id, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/instruments?alias_added=1");
      }
      // "Taken" names the instrument holding it, because the next question is
      // always "by what" — and often the answer is an instrument this one
      // should be merged into instead.
      formError =
        result.kind === "taken"
          ? ta.aliasTaken(result.byLabel)
          : validationMessage(Astro.locals.locale, "slugRequired");
    } else if (intent === "remove-alias") {
      await removeInstrumentAlias(appDeps.db, String(formData.get("aliasId") ?? ""));
      return Astro.redirect("/admin/instruments?alias_removed=1");
    }
  }
}

// Archived instruments are fetched but not SHOWN by default. They are a
// retired list, not a working one — an instrument is archived precisely so it
// stops being one of the choices — and mixing them in put the band's real
// instruments in a table they had to read past.
//
// One query, partitioned here rather than two: the count is what the toggle
// below is for, so the hidden ones have to be known even while hidden.
//
// `show`, not `archived`: `?archived=1` already means "you just archived
// one", and one parameter carrying two meanings is how a flash message ends
// up doubling as a filter.
const [allInstruments, usage, aliases] = await Promise.all([
  listInstruments(appDeps.db),
  // For the whole table at once. Whether an instrument can be deleted is a
  // question about every row on screen, and asking per row would be four
  // queries times twelve.
  instrumentUsage(appDeps.db),
  // One query for the whole table, grouped here — every sheet lists its own.
  aliasesByInstrument(appDeps.db),
]);

/**
 * What is holding an instrument, as "takes (3) · members (2)".
 *
 * Only the non-zero parts, because a list of four zeroes says nothing. The
 * counts sit in parentheses rather than in a sentence so neither language
 * needs a plural form for four different nouns.
 */
function usageParts(u: InstrumentUsage): string {
  return (
    [
      [ta.usedByTakes, u.takes],
      [ta.usedByMembers, u.members],
      [ta.usedByCharts, u.charts],
      [ta.usedByStems, u.assets],
    ] as const
  )
    .filter(([, n]) => n > 0)
    .map(([noun, n]) => `${noun} (${n})`)
    .join(" · ");
}
const archivedCount = allInstruments.filter((instrument) => instrument.archivedAt).length;
const showArchived = Astro.url.searchParams.get("show") === "archived";
const instruments = showArchived
  ? allInstruments
  : allInstruments.filter((instrument) => !instrument.archivedAt);

// The status column earns its place from the ROWS, not from the view: an
// unfinished instrument is not archived, so tying the column to the archived
// view would have hidden the one status anybody needs to act on.
const anyStatus = instruments.some((instrument) => instrument.archivedAt || instrument.isStub);

const justCreated = Astro.url.searchParams.get("created") === "1";
const justUpdated = Astro.url.searchParams.get("updated") === "1";
const justArchived = Astro.url.searchParams.get("archived") === "1";
const justDeleted = Astro.url.searchParams.get("deleted") === "1";
const aliasAdded = Astro.url.searchParams.get("alias_added") === "1";
const aliasRemoved = Astro.url.searchParams.get("alias_removed") === "1";
const justMerged = Astro.url.searchParams.get("merged") === "1";
const deleteBlocked = Astro.url.searchParams.get("in_use") === "1";
---

<AppLayout title={ta.instrumentsTitle} principal={principal} current="admin" adminSection="instruments">
  <div class="bp-stack">
    <AdminHeader title={ta.colInstruments} current="instruments" />

    {justCreated && <Banner kind="success">{ta.instrumentAdded}</Banner>}
    {justUpdated && <Banner kind="success">{ta.instrumentUpdated}</Banner>}
    {justArchived && <Banner kind="success">{ta.instrumentArchived}</Banner>}
    {justDeleted && <Banner kind="success">{ta.instrumentDeleted}</Banner>}
    {aliasAdded && <Banner kind="success">{ta.aliasAdded}</Banner>}
    {aliasRemoved && <Banner kind="success">{ta.aliasRemoved}</Banner>}
    {justMerged && <Banner kind="success">{ta.merged}</Banner>}
    {deleteBlocked && <Banner kind="error">{ta.instrumentDeleteBlocked}</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    <form method="post" class="bp-admin-add" novalidate>
      <input type="hidden" name="intent" value="create" />
      <Field
        label={ta.colSlug}
        name="slug"
        required
        hint={ta.slugHint}
        error={createErrorField === "slug" ? createError : undefined}
      />
      <Field
        label={ta.colLabel}
        name="label"
        required
        hint={ta.labelHint}
        error={createErrorField === "label" ? createError : undefined}
      />
      <button type="submit" class="bp-btn bp-btn-primary">{ta.addInstrument}</button>
    </form>

    <p class="bp-field-hint bp-m0">
      {ta.archiveInstrumentNote}
    </p>

    {/* Only when there is something back there. A toggle that reveals nothing
        is a control that answers its own question before you press it. */}
    {archivedCount > 0 && (
      <p class="bp-field-hint bp-m0">
        <a href={showArchived ? "/admin/instruments" : "/admin/instruments?show=archived"}>
          {showArchived ? ta.hideArchived : ta.showArchived(archivedCount)}
        </a>
      </p>
    )}

    {instruments.length === 0 ? (
      <div class="bp-empty-state">
        {/* "None yet" and "all of them are archived" are different facts, and
            the first one tells someone with a full archive to go and add
            their first instrument. */}
        <p>{archivedCount > 0 ? ta.emptyActiveInstruments : ta.emptyInstruments}</p>
      </div>
    ) : (
      <div class="bp-table-wrap">
        <table class="bp-table">
          <thead>
            <tr>
              <th scope="col">{ta.colIcon}</th>
              <th scope="col">{ta.colLabel}</th>
              <th scope="col">{ta.colSlug}</th>
              <th scope="col">{ta.colOrder}</th>
              {anyStatus && <th scope="col">{ta.colStatus}</th>}
              <th scope="col">{ta.colActions}</th>
            </tr>
          </thead>
          <tbody>
            {instruments.map((instrument) => (
              <tr>
                <td data-label={ta.colIcon}>
                  <InstrumentIcon icon={instrument.icon} label={instrument.label} size={24} />
                </td>
                {/* The label reads as a label; editing it lives behind the
                    row's one disclosure, with the sort order, the icon picker
                    and the destructive action. Inline, the four of them wrapped
                    every row to three lines — a table of hairline rows you can
                    scan a column of cannot afford that. */}
                <td data-label={ta.colLabel}>
                  {/* The dot, not a swatch column of its own: a colour with no
                      name beside it is a quiz, and the table already has more
                      columns than a phone wants. `aria-hidden` because the
                      colour is decoration here — the picker inside the sheet is
                      where it is named and chosen. */}
                  <span class="bp-table-name">
                    <span
                      class="bp-color-dot"
                      aria-hidden="true"
                      style={`--bp-swatch: ${trackColorVar(instrument.color)}`}
                    />{instrument.label}
                  </span>
                </td>
                <td data-label={ta.colSlug} class="bp-table-quiet">{instrument.slug}</td>
                <td data-label={ta.colOrder} class="bp-table-quiet">{instrument.sortOrder}</td>
                {/* Only when some row on screen has a status to report: with
                    nothing archived and nothing unfinished it was a header
                    over a column of blanks on every single row.

                    One line, no surrounding whitespace: an ordinary
                    instrument must leave this cell with NO child nodes so the
                    phone layout's `td:empty` rule can drop it, rather than
                    rendering a STATUS label with a blank beside it. */}
                {anyStatus && <td data-label={ta.colStatus}>{instrument.isStub && <span class="bp-kind bp-kind-stub">{ta.statusStub}</span>}{instrument.archivedAt && <span class="bp-kind">{ta.statusArchived}</span>}</td>}
                <td data-label={ta.colActions}>
                  <button
                    type="button"
                    class="bp-btn bp-btn-secondary bp-btn-sm"
                    data-sheet-open={`instrument-${instrument.id}`}
                  >{ta.edit}</button>
                  <RecordSheet
                    id={`instrument-${instrument.id}`}
                    eyebrow={ta.editingInstrument}
                    title={instrument.label}
                    subtitle={instrument.slug}
                  >
                    {/* Empty, and targeted by `form=` below. HTML forbids a
                        form inside a form and the PARSER DROPS THE INNER ONE
                        SILENTLY — the markup is in the response and simply
                        absent from the DOM, so the control renders and does
                        nothing. Everything here that is its own submission
                        lives out here for that reason. */}
                    <form method="post" id={`add-alias-${instrument.id}`} class="bp-sheet-aux">
                      <input type="hidden" name="intent" value="add-alias" />
                      <input type="hidden" name="instrumentId" value={instrument.id} />
                    </form>
                    {(aliases.get(instrument.id) ?? []).map((alias) => (
                      <form method="post" id={`drop-alias-${alias.id}`} class="bp-sheet-aux">
                        <input type="hidden" name="intent" value="remove-alias" />
                        <input type="hidden" name="aliasId" value={alias.id} />
                      </form>
                    ))}
                    <form
                      method="get"
                      action={`/admin/instruments/${instrument.id}/merge`}
                      id={`merge-${instrument.id}-form`}
                      class="bp-sheet-aux"
                    ></form>
                    <form method="post" class="bp-sheet-form">
                      <input type="hidden" name="intent" value="update" />
                      <input type="hidden" name="instrumentId" value={instrument.id} />
                      <div class="bp-sheet-body">
                        <div class="bp-sheet-field">
                          <label class="bp-eyebrow" for={`label-${instrument.id}`}>{ta.colLabel}</label>
                          <input
                            class="bp-input"
                            id={`label-${instrument.id}`}
                            name="label"
                            value={instrument.label}
                          />
                          <p class="bp-sheet-hint bp-m0">{ta.sortOrderHint}</p>
                        </div>

                        <div class="bp-sheet-field">
                          <label class="bp-eyebrow" for={`order-${instrument.id}`}>{ta.sortOrder}</label>
                          <input
                            class="bp-input bp-input-inline-number"
                            id={`order-${instrument.id}`}
                            name="sortOrder"
                            type="number"
                            value={instrument.sortOrder}
                          />
                        </div>

                        {/* No disclosure around it any more. Nineteen 44px
                            tiles had to be collapsed inside a table cell; in
                            a panel this wide they are just the field. */}
                        <fieldset class="bp-sheet-field">
                          <legend class="bp-eyebrow">{ta.colIcon}</legend>
                          <div class="bp-icon-grid">
                            <label class="bp-icon-choice" title={ta.iconNoneHint}>
                              <input type="radio" name="icon" value="" checked={!instrument.icon} />
                              <span class="bp-icon-choice-face bp-icon-choice-none">{ta.iconNone}</span>
                            </label>
                            {Object.entries(INSTRUMENT_GLYPHS).map(([key, glyph]) => (
                              <label class="bp-icon-choice" title={glyph.label}>
                                <input
                                  type="radio"
                                  name="icon"
                                  value={key}
                                  checked={instrument.icon === key}
                                />
                                <span class="bp-icon-choice-face">
                                  <InstrumentIcon icon={key} label={glyph.label} size={22} />
                                </span>
                              </label>
                            ))}
                          </div>
                        </fieldset>

                        {/* The ICON PICKER's grid and tiles, reused rather
                            than copied: two pickers stacked in one sheet that
                            merely resembled each other would drift the first
                            time either was touched. `bp-swatch` fills the tile
                            with the colour and swaps the selected state for a
                            ring and a tick — the one thing that has to differ,
                            because a picker whose choices ARE colours cannot
                            show selection by recolouring them. Each radio
                            carries a real name for the same reason: a swatch
                            is unusable without sight of it. */}
                        <fieldset class="bp-sheet-field">
                          <legend class="bp-eyebrow">{ta.colColor}</legend>
                          <div class="bp-icon-grid">
                            <label class="bp-icon-choice" title={ta.colorNoneHint}>
                              <input
                                type="radio"
                                name="color"
                                value=""
                                checked={!instrument.color}
                                aria-label={ta.colorNone}
                              />
                              <span class="bp-icon-choice-face bp-icon-choice-none">{ta.colorNone}</span>
                            </label>
                            {Object.entries(TRACK_COLORS).map(([key, color]) => {
                              const name = ta.trackColor[key as keyof typeof ta.trackColor] ?? color.label;
                              return (
                                <label class="bp-icon-choice" title={name}>
                                  <input
                                    type="radio"
                                    name="color"
                                    value={key}
                                    checked={instrument.color === key}
                                    aria-label={name}
                                  />
                                  <span
                                    class="bp-icon-choice-face bp-swatch"
                                    style={`--bp-swatch: var(${color.cssVar})`}
                                  />
                                </label>
                              );
                            })}
                          </div>
                          <p class="bp-sheet-hint bp-m0">{ta.colorHint}</p>
                        </fieldset>

                        {/* Other names for the same instrument. Sits under
                            the appearance fields because it is about identity
                            rather than looks, and above the destructive
                            block because it is the thing that usually makes
                            the destructive one unnecessary — a slug merged in
                            here is a slug nobody has to delete a row for. */}
                        <fieldset class="bp-sheet-field">
                          <legend class="bp-eyebrow">{ta.aliasesHeading}</legend>
                          {(aliases.get(instrument.id) ?? []).length === 0 ? (
                            <p class="bp-sheet-hint bp-m0">{ta.noAliases}</p>
                          ) : (
                            <ul class="bp-alias-list">
                              {(aliases.get(instrument.id) ?? []).map((alias) => (
                                <li class="bp-alias-row">
                                  <span class="bp-mono">{alias.slug}</span>
                                  <button
                                    type="submit"
                                    form={`drop-alias-${alias.id}`}
                                    class="bp-btn bp-btn-quiet bp-btn-xs"
                                    aria-label={ta.removeAlias(alias.slug)}
                                    title={ta.removeAlias(alias.slug)}
                                  >&times;</button>
                                </li>
                              ))}
                            </ul>
                          )}
                          <div class="bp-alias-add">
                            <label class="bp-visually-hidden" for={`alias-${instrument.id}`}>
                              {ta.aliasSlugLabel}
                            </label>
                            <input
                              class="bp-input"
                              id={`alias-${instrument.id}`}
                              name="slug"
                              form={`add-alias-${instrument.id}`}
                              placeholder={ta.aliasSlugLabel}
                            />
                            <button
                              type="submit"
                              form={`add-alias-${instrument.id}`}
                              class="bp-btn bp-btn-secondary bp-btn-sm"
                            >{ta.addAlias}</button>
                          </div>
                          <p class="bp-sheet-hint bp-m0">{ta.aliasesHint}</p>
                        </fieldset>

                        <div class="bp-sheet-extras">
                          {/* Delete sits beside Archive because they answer
                              the same question from opposite ends: archive
                              retires an instrument the band has stopped
                              playing, delete removes one that should never
                              have existed. Offered ONLY while nothing points
                              at it — otherwise the reason takes its place, so
                              nobody presses a button that cannot work. */}
                          {isInstrumentUnused(usageOf(usage, instrument.id)) ? (
                            <a
                              href={`/admin/instruments/${instrument.id}/delete`}
                              class="bp-sheet-danger"
                              data-confirm
                              data-confirm-title={`${ta.deleteInstrument}: ${instrument.label}`}
                              data-confirm-body={ta.deleteInstrumentBody(instrument.label)}
                              data-confirm-action={`/admin/instruments/${instrument.id}/delete`}
                              data-confirm-cta={ta.deleteInstrument}
                              data-confirm-redirect="/admin/instruments?deleted=1"
                            >{ta.deleteThisInstrument}</a>
                          ) : (
                            <p class="bp-sheet-hint bp-m0">
                              {ta.instrumentInUse(usageParts(usageOf(usage, instrument.id)))}
                            </p>
                          )}
                          {/* Merging is the answer when deleting is refused:
                              an instrument something DOES point at can still
                              stop existing, by becoming another one. A plain
                              GET to the confirm page, because the page's whole
                              job is to show what the merge would destroy
                              before anything happens. */}
                          {allInstruments.length > 1 && (
                            <div class="bp-merge-form">
                              <label class="bp-visually-hidden" for={`merge-${instrument.id}`}>
                                {ta.mergeTargetLabel}
                              </label>
                              <select
                                class="bp-select"
                                id={`merge-${instrument.id}`}
                                name="into"
                                form={`merge-${instrument.id}-form`}
                              >
                                {allInstruments
                                  .filter((other) => other.id !== instrument.id)
                                  .map((other) => (
                                    <option value={other.id}>{other.label}</option>
                                  ))}
                              </select>
                              <button
                                type="submit"
                                form={`merge-${instrument.id}-form`}
                                class="bp-btn bp-btn-secondary bp-btn-sm"
                              >
                                {ta.mergeInto}
                              </button>
                            </div>
                          )}
                          {instrument.archivedAt ? (
                            <button
                              type="submit"
                              form={`unarchive-${instrument.id}`}
                              class="bp-btn bp-btn-quiet bp-btn-sm"
                            >{ta.unarchive}</button>
                          ) : (
                            <a
                              href={`/admin/instruments/${instrument.id}/archive`}
                              class="bp-sheet-danger"
                              data-confirm
                              data-confirm-title={`Archive ${instrument.label}?`}
                              data-confirm-body={`${instrument.label} won't be selectable for new takes. Past takes that used it keep rendering fine.`}
                              data-confirm-action={`/admin/instruments/${instrument.id}/archive`}
                              data-confirm-cta={ta.archive}
                            >{ta.archive}</a>
                          )}
                        </div>
                      </div>
                      <div class="bp-sheet-foot">
                        <button type="submit" class="bp-btn bp-btn-primary">{ta.saveChanges}</button>
                        <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{ta.cancel}</button>
                      </div>
                    </form>
                    {instrument.archivedAt && (
                      <form
                        method="post"
                        id={`unarchive-${instrument.id}`}
                        class="bp-sheet-aux"
                        action={`/admin/instruments/${instrument.id}/archive?unarchive=1`}
                      />
                    )}
                  </RecordSheet>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p class="bp-credit">
    {ta.iconCreditBefore}{" "}
    <a href={INSTRUMENT_GLYPH_CREDIT.url} rel="noopener noreferrer" target="_blank">
      {INSTRUMENT_GLYPH_CREDIT.set}
    </a>{ta.iconCreditLicensed}{" "}
    <a href={INSTRUMENT_GLYPH_CREDIT.licenceUrl} rel="noopener noreferrer" target="_blank">
      {INSTRUMENT_GLYPH_CREDIT.licence}
      </a>.
    </p>
  </div>
</AppLayout>
