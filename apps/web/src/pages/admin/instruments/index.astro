---
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import { INSTRUMENT_GLYPHS, INSTRUMENT_GLYPH_CREDIT } from "@bandplate/ui/icons/instruments.js";
import InstrumentIcon from "../../../components/InstrumentIcon.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAppDeps } from "../../../server/app.js";
import { isSameOrigin } from "../../../server/csrf.js";
import {
  createInstrument,
  listInstruments,
  updateInstrument,
} from "../../../server/pages/admin-instruments.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();

let createError: string | undefined;
let createErrorField: "slug" | "label" | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent");

    if (intent === "create") {
      const result = await createInstrument(appDeps.db, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/instruments?created=1");
      }
      createError = result.error;
      createErrorField = result.field;
    } else if (intent === "update") {
      const id = String(formData.get("instrumentId") ?? "");
      const result = await updateInstrument(appDeps.db, id, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/instruments?updated=1");
      }
      formError = "Couldn't update that instrument — reload and try again.";
    }
  }
}

const instruments = await listInstruments(appDeps.db);
const justCreated = Astro.url.searchParams.get("created") === "1";
const justUpdated = Astro.url.searchParams.get("updated") === "1";
const justArchived = Astro.url.searchParams.get("archived") === "1";
---

<AdminLayout title="Instruments" principal={principal} current="instruments">
  {justCreated && <Banner kind="success">Instrument added.</Banner>}
  {justUpdated && <Banner kind="success">Instrument updated.</Banner>}
  {justArchived && <Banner kind="success">Instrument archived. Its past takes still render fine.</Banner>}
  {formError && <Banner kind="error">{formError}</Banner>}

  <section class="bp-card">
    <h2 class="bp-section-title">Add an instrument</h2>
    <form method="post" novalidate>
      <input type="hidden" name="intent" value="create" />
      <div class="bp-form-grid">
        <Field
          label="Slug"
          name="slug"
          required
          hint="Lowercase, no spaces — e.g. rhythm-guitar"
          error={createErrorField === "slug" ? createError : undefined}
        />
        <Field
          label="Label"
          name="label"
          required
          hint="What members see — e.g. Rhythm guitar"
          error={createErrorField === "label" ? createError : undefined}
        />
      </div>
      <button type="submit" class="bp-btn bp-btn-primary">Add instrument</button>
    </form>
  </section>

  <section>
    <h2>Instruments</h2>
    <p class="bp-field-hint">
      Archiving an instrument hides it from new takes but keeps every past take that used it
      rendering correctly.
    </p>
    {instruments.length === 0 ? (
      <p>No instruments yet — add the first one above.</p>
    ) : (
      <div class="bp-table-wrap">
        <table class="bp-table">
          <thead>
            <tr>
              <th scope="col">Icon</th>
              <th scope="col">Label</th>
              <th scope="col">Slug</th>
              <th scope="col">Order</th>
              <th scope="col">Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {instruments.map((instrument) => (
              <tr>
                <td data-label="Icon">
                  <InstrumentIcon icon={instrument.icon} label={instrument.label} size={24} />
                </td>
                <td data-label="Label">
                  <form method="post" class="bp-inline-form bp-instrument-form">
                    <input type="hidden" name="intent" value="update" />
                    <input type="hidden" name="instrumentId" value={instrument.id} />
                    <label class="sr-only" for={`label-${instrument.id}`}>
                      Label for {instrument.slug}
                    </label>
                    <input
                      class="bp-input bp-input-inline-label"
                      id={`label-${instrument.id}`}
                      name="label"
                      value={instrument.label}
                    />
                    <label class="sr-only" for={`order-${instrument.id}`}>
                      Sort order for {instrument.slug}
                    </label>
                    <input
                      class="bp-input bp-input-inline-number"
                      id={`order-${instrument.id}`}
                      name="sortOrder"
                      type="number"
                      value={instrument.sortOrder}
                    />
                    {/* A no-JS disclosure: the picker is a plain radio group
                    inside the row's own form, so choosing a glyph and pressing
                    Save is one submission. Collapsed by default because
                    nineteen 44px tiles per row would bury the table. */}
                    <details class="bp-icon-picker">
                      <summary>Icon</summary>
                      <fieldset class="bp-icon-grid">
                        <legend class="sr-only">Icon for {instrument.label}</legend>
                        <label class="bp-icon-choice" title="No icon — show initials">
                          <input type="radio" name="icon" value="" checked={!instrument.icon} />
                          <span class="bp-icon-choice-face bp-icon-choice-none">None</span>
                        </label>
                        {Object.entries(INSTRUMENT_GLYPHS).map(([key, glyph]) => (
                          <label class="bp-icon-choice" title={glyph.label}>
                            <input
                              type="radio"
                              name="icon"
                              value={key}
                              checked={instrument.icon === key}
                            />
                            <span class="bp-icon-choice-face">
                              <InstrumentIcon icon={key} label={glyph.label} size={22} />
                            </span>
                          </label>
                        ))}
                      </fieldset>
                    </details>
                    <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">Save</button>
                  </form>
                </td>
                <td data-label="Slug" class="bp-mono">{instrument.slug}</td>
                <td data-label="Order" class="bp-mono">{instrument.sortOrder}</td>
                <td data-label="Status">
                  <span class="bp-badge">{instrument.archivedAt ? "archived" : "active"}</span>
                </td>
                <td data-label="Actions">
                  {instrument.archivedAt ? (
                    <form method="post" action={`/admin/instruments/${instrument.id}/archive?unarchive=1`}>
                      <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">Unarchive</button>
                    </form>
                  ) : (
                    <a
                      href={`/admin/instruments/${instrument.id}/archive`}
                      class="bp-btn bp-btn-danger bp-btn-sm"
                      data-confirm
                      data-confirm-title={`Archive ${instrument.label}?`}
                      data-confirm-body={`${instrument.label} won't be selectable for new takes. Past takes that used it keep rendering fine.`}
                      data-confirm-action={`/admin/instruments/${instrument.id}/archive`}
                      data-confirm-cta="Archive"
                    >
                      Archive
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
  <p class="bp-credit">
    Instrument icons from{" "}
    <a href={INSTRUMENT_GLYPH_CREDIT.url} rel="noopener noreferrer" target="_blank">
      {INSTRUMENT_GLYPH_CREDIT.set}
    </a>, licensed{" "}
    <a href={INSTRUMENT_GLYPH_CREDIT.licenceUrl} rel="noopener noreferrer" target="_blank">
      {INSTRUMENT_GLYPH_CREDIT.licence}
    </a>.
  </p>
</AdminLayout>
