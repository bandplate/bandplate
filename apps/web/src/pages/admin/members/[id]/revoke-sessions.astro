---
import { adminMessages } from "@bandplate/i18n";
// The no-JS fallback destination for the ta.revokeSessions trigger on the
// members list: GET renders a real confirmation page (names the member,
// states the consequence), and this page's own `<form method="post">`
// performs the action — no JavaScript required. When JS is available, the
// `ConfirmDialog` island intercepts the trigger and POSTs here directly
// with `Accept: text/plain` instead of navigating, which is how this page
// tells the two callers apart below.
import ConfirmActionPage from "@bandplate/ui/components/ConfirmActionPage.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getAppDeps, getAuthDeps } from "../../../../server/app.js";
import { isSameOrigin } from "../../../../server/csrf.js";
import { getMember, revokeMemberSessions } from "../../../../server/pages/admin-members.js";

const ta = adminMessages(Astro.locals.locale);

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/admin/members");
}

const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);
const isFetch = (Astro.request.headers.get("accept") ?? "").includes("text/plain");

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    return new Response("origin check failed", { status: 403 });
  }
  const { kind } = await revokeMemberSessions(appDeps.db, authDeps, id);
  if (isFetch) {
    return new Response(kind === "ok" ? "ok" : "not found", { status: kind === "ok" ? 200 : 404 });
  }
  return Astro.redirect("/admin/members?revoked=1");
}

const member = await getMember(appDeps.db, id);
if (!member) {
  return new Response("Member not found.", { status: 404 });
}
---

<Layout title={ta.revokeSessions}>
  <ConfirmActionPage
    bannerTitle={`Revoke sessions for ${member.displayName}?`}
    cta={ta.revokeSessions}
    cancelHref="/admin/members"
    cancelLabel={ta.cancel}
  >
    {member.displayName} will be signed out everywhere and will need a new login link to get
    back in.
  </ConfirmActionPage>
</Layout>
