---
import { adminMessages, validationMessage } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import AdminHeader from "../../../components/AdminHeader.astro";
import InstrumentSet from "../../../components/InstrumentSet.astro";
import RecordSheet from "../../../components/RecordSheet.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { getAppDeps, getWebConfig } from "../../../server/app.js";
import { isSameOrigin } from "../../../server/csrf.js";
import { formatTimestamp } from "../../../server/format.js";
import {
  createMember,
  listAllInstruments,
  listMembersWithLastSeen,
  resendMemberInvite,
  updateMember,
  updateMemberInstruments,
} from "../../../server/pages/admin-members.js";

const ta = adminMessages(Astro.locals.locale);

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const webConfig = await getWebConfig();

let createError: string | undefined;
let createErrorField: "displayName" | "email" | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent");

    const invite = { mailer: appDeps.mailer, appOrigin: appDeps.config.appOrigin };

    if (intent === "create") {
      const result = await createMember(
        appDeps.db,
        appDeps.clock.now(),
        formData,
        invite,
        principal.memberId,
        webConfig.defaultLocale,
      );
      if (result.kind === "ok") {
        // The banner distinguishes the two, because "member added" while the
        // invitation silently failed is how a broken mail pipeline stays
        // hidden until someone cannot get in.
        return Astro.redirect(
          result.invited ? "/admin/members?created=1" : "/admin/members?created=1&nomail=1",
        );
      }
      if (result.kind === "email_taken") {
        createError = ta.duplicateEmail;
        createErrorField = "email";
      } else {
        createError = validationMessage(Astro.locals.locale, result.error);
        createErrorField = result.field;
      }
    } else if (intent === "record") {
      // ONE save for the whole record. The sheet shows role, status and
      // instruments together, so pressing Save has to mean "save what I see"
      // — two intents behind one button would let half a change land.
      const id = String(formData.get("memberId") ?? "");

      const instruments = await updateMemberInstruments(appDeps.db, id, formData);
      if (instruments.kind === "not_found") {
        formError = ta.memberNotFound;
      } else if (instruments.kind !== "ok") {
        formError = ta.instrumentsInvalid;
      } else if (!formData.has("role")) {
        // Your own row renders no role/status controls (see the sheet), so
        // there is nothing else to write.
        return Astro.redirect("/admin/members?updated=1");
      } else {
        const result = await updateMember(appDeps.db, id, formData, principal.memberId);
        if (result.kind === "ok") {
          return Astro.redirect("/admin/members?updated=1");
        }
        if (result.kind === "self") {
          formError = ta.selfError;
        } else if (result.kind === "last_admin") {
          formError = ta.lastAdmin;
        } else {
          formError = ta.memberUpdateFailed;
        }
      }
    } else if (intent === "invite") {
      const id = String(formData.get("memberId") ?? "");
      const result = await resendMemberInvite(appDeps.db, id, invite, principal.memberId);
      if (result.kind === "not_found") {
        formError = ta.memberNotFound;
      } else {
        return Astro.redirect(
          result.invited ? "/admin/members?invited=1" : "/admin/members?nomail=1",
        );
      }
    }
  }
}

const [members, allInstruments] = await Promise.all([
  listMembersWithLastSeen(appDeps.db),
  listAllInstruments(appDeps.db),
]);
const justCreated = Astro.url.searchParams.get("created") === "1";
const justUpdated = Astro.url.searchParams.get("updated") === "1";
const justRevoked = Astro.url.searchParams.get("revoked") === "1";
const justInvited = Astro.url.searchParams.get("invited") === "1";
const mailFailed = Astro.url.searchParams.get("nomail") === "1";
---

<AppLayout title={ta.membersTitle} principal={principal} current="admin" adminSection="members">
  <div class="bp-stack">
    <AdminHeader title={ta.members} current="members" />

    {justCreated && !mailFailed && (
      <Banner kind="success">{ta.memberAddedInvited}</Banner>
    )}
    {justCreated && mailFailed && <Banner kind="success">{ta.memberAdded}</Banner>}
    {justInvited && <Banner kind="success">{ta.inviteResent}</Banner>}
    {mailFailed && (
      <Banner kind="error" title={ta.inviteFailedTitle}>
        They're on the whitelist and can still sign in from the login page themselves — but check
        your mail configuration, because login links go out the same way.
      </Banner>
    )}
    {justUpdated && <Banner kind="success">{ta.memberUpdated}</Banner>}
    {justRevoked && <Banner kind="success">{ta.sessionsRevoked}</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    {/* One inline row of fields, not a bordered panel with its own "Add a
        member" heading. Two labelled inputs and a button say what they are;
        the heading was furniture around them, and the panel made the page
        open on a form rather than on the roster it is about. */}
    <form method="post" class="bp-admin-add" novalidate>
      <input type="hidden" name="intent" value="create" />
      <Field
        label={ta.colName}
        name="displayName"
        required
        autocomplete="name"
        error={createErrorField === "displayName" ? createError : undefined}
      />
      <Field
        label={ta.colEmail}
        name="email"
        type="email"
        required
        autocomplete="email"
        error={createErrorField === "email" ? createError : undefined}
      />
      <button type="submit" class="bp-btn bp-btn-primary">{ta.addMember}</button>
    </form>

    {members.length === 0 ? (
      <div class="bp-empty-state">
        <p>{ta.emptyMembers}</p>
      </div>
    ) : (
      <div class="bp-table-wrap">
        <table class="bp-table">
          <caption class="sr-only">{ta.bandMembers}</caption>
          <thead>
            <tr>
              <th scope="col">{ta.colName}</th>
              <th scope="col">{ta.colEmail}</th>
              <th scope="col">{ta.colRole}</th>
              <th scope="col">{ta.colInstruments}</th>
              <th scope="col">{ta.colLastSeen}</th>
              <th scope="col">{ta.colActions}</th>
            </tr>
          </thead>
          <tbody>
            {members.map((member) => {
              const memberInstruments = allInstruments.filter((instrument) =>
                member.instrumentIds.includes(instrument.id),
              );
              return (
              <tr>
                <td data-label={ta.colName}>
                  <span class="bp-table-name">{member.displayName}</span>
                  {/* Status rides under the name rather than taking a column
                      of its own: "active" is the answer for nearly every row,
                      so a column of it was five sixths noise. What is worth
                      seeing is the exception — invited, disabled — and an
                      exception reads better attached to the person it is
                      about. */}
                  {member.status !== "active" && (
                    <span class="bp-kind">
                      {member.status === "invited" ? ta.statusInvited : ta.statusDisabled}
                    </span>
                  )}
                </td>
                <td data-label={ta.colEmail} class="bp-table-quiet">{member.email}</td>
                <td data-label={ta.colRole}>
                  {member.role === "admin" ? (
                    <span class="bp-badge bp-badge-admin">admin</span>
                  ) : (
                    <span class="bp-kind">member</span>
                  )}
                </td>
                <td data-label={ta.colInstruments}>
                  <InstrumentSet
                    instruments={memberInstruments}
                    verb="plays"
                    tone="bare"
                    size={18}
                    emptyLabel="none"
                  />
                </td>
                <td data-label={ta.colLastSeen} class="bp-table-quiet bp-table-when">{formatTimestamp(Astro.locals.locale, member.lastSeenAt)}</td>
                {/* The row carries no controls at all now — one trigger, and
                    everything you can do to the record lives in its sheet. */}
                <td data-label={ta.colActions}>
                  <button
                    type="button"
                    class="bp-btn bp-btn-secondary bp-btn-sm"
                    data-sheet-open={`member-${member.id}`}
                  >{ta.edit}</button>
                  <RecordSheet
                    id={`member-${member.id}`}
                    eyebrow={ta.editingMember}
                    title={member.displayName}
                    subtitle={member.email}
                  >
                    {/* Resending the invitation is its own POST, and HTML has
                        no nested forms — so the form is an empty, hidden one
                        and its button lives in the body via `form=`, where it
                        belongs, rather than stranded under the footer. */}
                    <form method="post" id={`invite-${member.id}`} class="bp-sheet-aux">
                      <input type="hidden" name="intent" value="invite" />
                      <input type="hidden" name="memberId" value={member.id} />
                    </form>
                    <form method="post" class="bp-sheet-form">
                      <input type="hidden" name="intent" value="record" />
                      <input type="hidden" name="memberId" value={member.id} />
                      <div class="bp-sheet-body">
                        {member.id === principal.memberId ? (
                          // An admin can't change their own role or status —
                          // the server rejects it anyway (see updateMember's
                          // self-demotion guard), but rendering no control at
                          // all means there is no dead end to press and no way
                          // to lock yourself out from this row. Instruments
                          // are not a self-demotion concern, so they stay.
                          <p class="bp-sheet-hint bp-m0">{ta.selfRowNote}</p>
                        ) : (
                          <>
                            <div class="bp-sheet-field">
                              <label class="bp-eyebrow" for={`role-${member.id}`}>{ta.colRole}</label>
                              <select class="bp-select" id={`role-${member.id}`} name="role">
                                <option value="member" selected={member.role === "member"}>member</option>
                                <option value="admin" selected={member.role === "admin"}>admin</option>
                              </select>
                            </div>
                            <div class="bp-sheet-field">
                              <label class="bp-eyebrow" for={`status-${member.id}`}>{ta.colStatus}</label>
                              <select class="bp-select" id={`status-${member.id}`} name="status">
                                <option value="invited" selected={member.status === "invited"}>invited</option>
                                <option value="active" selected={member.status === "active"}>active</option>
                                <option value="disabled" selected={member.status === "disabled"}>disabled</option>
                              </select>
                            </div>
                          </>
                        )}

                        <fieldset class="bp-sheet-field">
                          <legend class="bp-eyebrow">{ta.colInstruments}</legend>
                          <div class="bp-pills">
                            {allInstruments.map((instrument) => (
                              <label class="bp-pill-check">
                                <input
                                  type="checkbox"
                                  name="instrumentIds"
                                  value={instrument.id}
                                  checked={member.instrumentIds.includes(instrument.id)}
                                />
                                <span class="bp-pill">
                                  {instrument.label}
                                  {instrument.archivedAt !== null ? " (archived)" : ""}
                                </span>
                              </label>
                            ))}
                          </div>
                        </fieldset>

                        <div class="bp-sheet-extras">
                          <button
                            type="submit"
                            form={`invite-${member.id}`}
                            class="bp-btn bp-btn-quiet bp-btn-sm"
                          >{ta.resendInvite}</button>
                          <a
                            href={`/admin/members/${member.id}/revoke-sessions`}
                            class="bp-sheet-danger"
                            data-confirm
                            data-confirm-title={`Revoke sessions for ${member.displayName}?`}
                            data-confirm-body={`${member.displayName} will be signed out everywhere and will need a new login link to get back in.`}
                            data-confirm-action={`/admin/members/${member.id}/revoke-sessions`}
                            data-confirm-cta={ta.revokeSessions}
                          >{ta.revokeSessions}</a>
                        </div>
                      </div>
                      <div class="bp-sheet-foot">
                        <button type="submit" class="bp-btn bp-btn-primary">{ta.saveChanges}</button>
                        {/* The way out. There wasn't one before — the only
                            escape from an open editor was Escape, which is
                            not a control anybody can see. */}
                        <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{ta.cancel}</button>
                      </div>
                    </form>
                  </RecordSheet>
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AppLayout>
