---
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import AdminHeader from "../../../components/AdminHeader.astro";
import InstrumentIcon from "../../../components/InstrumentIcon.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { getAppDeps } from "../../../server/app.js";
import { isSameOrigin } from "../../../server/csrf.js";
import { formatTimestamp } from "../../../server/format.js";
import {
  createMember,
  listAllInstruments,
  listMembersWithLastSeen,
  updateMember,
  updateMemberInstruments,
} from "../../../server/pages/admin-members.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();

let createError: string | undefined;
let createErrorField: "displayName" | "email" | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent");

    if (intent === "create") {
      const result = await createMember(appDeps.db, appDeps.clock.now(), formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/members?created=1");
      }
      if (result.kind === "email_taken") {
        createError = "A member with this email already exists.";
        createErrorField = "email";
      } else {
        createError = result.error;
        createErrorField = result.field;
      }
    } else if (intent === "update") {
      const id = String(formData.get("memberId") ?? "");
      const result = await updateMember(appDeps.db, id, formData, principal.memberId);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/members?updated=1");
      }
      if (result.kind === "self") {
        formError = "You can't change your own role or status — ask another admin to do it.";
      } else if (result.kind === "last_admin") {
        formError = "That would leave the band with no active admin. Promote someone else first.";
      } else {
        formError = "Couldn't update that member — reload and try again.";
      }
    } else if (intent === "instruments") {
      const id = String(formData.get("memberId") ?? "");
      const result = await updateMemberInstruments(appDeps.db, id, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/members?updated=1");
      }
      if (result.kind === "not_found") {
        formError = "Couldn't find that member — reload and try again.";
      } else {
        formError = "That instrument selection didn't look right — reload and try again.";
      }
    }
  }
}

const [members, allInstruments] = await Promise.all([
  listMembersWithLastSeen(appDeps.db),
  listAllInstruments(appDeps.db),
]);
const justCreated = Astro.url.searchParams.get("created") === "1";
const justUpdated = Astro.url.searchParams.get("updated") === "1";
const justRevoked = Astro.url.searchParams.get("revoked") === "1";
---

<AppLayout title="Admin — Members" principal={principal} current="admin" adminSection="members">
  <div class="bp-stack">
    <AdminHeader title="Members" current="members" />

    {justCreated && <Banner kind="success">Member added.</Banner>}
    {justUpdated && <Banner kind="success">Member updated.</Banner>}
    {justRevoked && <Banner kind="success">Sessions revoked. They'll need a new login link.</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    {/* One inline row of fields, not a bordered panel with its own "Add a
        member" heading. Two labelled inputs and a button say what they are;
        the heading was furniture around them, and the panel made the page
        open on a form rather than on the roster it is about. */}
    <form method="post" class="bp-admin-add" novalidate>
      <input type="hidden" name="intent" value="create" />
      <Field
        label="Name"
        name="displayName"
        required
        autocomplete="name"
        error={createErrorField === "displayName" ? createError : undefined}
      />
      <Field
        label="Email"
        name="email"
        type="email"
        required
        autocomplete="email"
        error={createErrorField === "email" ? createError : undefined}
      />
      <button type="submit" class="bp-btn bp-btn-primary">Add member</button>
    </form>

    {members.length === 0 ? (
      <div class="bp-empty-state">
        <p>No members yet — add the first one above.</p>
      </div>
    ) : (
      <div class="bp-table-wrap">
        <table class="bp-table">
          <caption class="sr-only">
            Band members
          </caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Email</th>
              <th scope="col">Role</th>
              <th scope="col">Instruments</th>
              <th scope="col">Last seen</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {members.map((member) => {
              const memberInstruments = allInstruments.filter((instrument) =>
                member.instrumentIds.includes(instrument.id),
              );
              return (
              <tr>
                <td data-label="Name">
                  <span class="bp-table-name">{member.displayName}</span>
                  {/* Status rides under the name rather than taking a column
                      of its own: "active" is the answer for nearly every row,
                      so a column of it was five sixths noise. What is worth
                      seeing is the exception — invited, disabled — and an
                      exception reads better attached to the person it is
                      about. */}
                  {member.status !== "active" && <span class="bp-kind">{member.status}</span>}
                </td>
                <td data-label="Email" class="bp-table-quiet">{member.email}</td>
                <td data-label="Role">
                  {member.role === "admin" ? (
                    <span class="bp-badge bp-badge-admin">admin</span>
                  ) : (
                    <span class="bp-kind">member</span>
                  )}
                </td>
                {/* A disclosure, not a four-row `<select multiple>`. The
                    select made every roster row five lines tall, which is the
                    one thing a table of hairline rows cannot afford — you
                    could no longer scan a column, which is what the table is
                    for. Closed, the cell answers "what do they play"; open, it
                    is the same pill group the filters use. */}
                <td data-label="Instruments">
                  <details class="bp-cell-editor">
                    <summary>
                      <span class="bp-visually-hidden">
                        Edit instruments for {member.displayName}
                      </span>
                      {memberInstruments.length > 0 ? (
                        <span class="bp-cell-editor-icons" aria-hidden="true">
                          {memberInstruments.map((instrument) => (
                            <InstrumentIcon
                              icon={instrument.icon}
                              label={instrument.label}
                              size={18}
                            />
                          ))}
                        </span>
                      ) : (
                        <span class="bp-kind">none</span>
                      )}
                    </summary>
                    <form method="post" class="bp-cell-editor-body">
                      <input type="hidden" name="intent" value="instruments" />
                      <input type="hidden" name="memberId" value={member.id} />
                      <fieldset class="bp-filter-pills">
                        <legend class="sr-only">Instruments for {member.displayName}</legend>
                        {allInstruments.map((instrument) => (
                          <label class="bp-filter-pill-check">
                            <input
                              type="checkbox"
                              name="instrumentIds"
                              value={instrument.id}
                              checked={member.instrumentIds.includes(instrument.id)}
                            />
                            <span class="bp-filter-pill">
                              {instrument.label}
                              {instrument.archivedAt !== null ? " (archived)" : ""}
                            </span>
                          </label>
                        ))}
                      </fieldset>
                      <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">
                        Save instruments
                      </button>
                    </form>
                  </details>
                </td>
                <td data-label="Last seen" class="bp-table-quiet bp-table-when">{formatTimestamp(member.lastSeenAt)}</td>
                {/* One control per row, same as the instruments cell. Role,
                    status and the destructive one all live behind it — a
                    roster where every row carries a red button reads as a page
                    about revoking sessions. */}
                <td data-label="Actions">
                  <details class="bp-cell-editor">
                    <summary class="bp-btn bp-btn-secondary bp-btn-sm">Edit</summary>
                    <div class="bp-cell-editor-body">
                      {member.id === principal.memberId ? (
                        // An admin can't change their own role/status here —
                        // the server rejects it anyway (see updateMember's
                        // self-demotion guard), but hiding the controls means
                        // there's no dead-end control to click in the first
                        // place, and no way to lock yourself out via this row
                        // at all. Instruments aren't a self-demotion concern,
                        // so that cell is still editable for this row.
                        <p class="bp-field-hint bp-m0">This is you — ask another admin.</p>
                      ) : (
                        <form method="post" class="bp-inline-form">
                          <input type="hidden" name="intent" value="update" />
                          <input type="hidden" name="memberId" value={member.id} />
                          <label class="sr-only" for={`role-${member.id}`}>
                            Role for {member.displayName}
                          </label>
                          <select class="bp-select bp-input-compact" id={`role-${member.id}`} name="role">
                            <option value="member" selected={member.role === "member"}>member</option>
                            <option value="admin" selected={member.role === "admin"}>admin</option>
                          </select>
                          <label class="sr-only" for={`status-${member.id}`}>
                            Status for {member.displayName}
                          </label>
                          <select class="bp-select bp-input-compact" id={`status-${member.id}`} name="status">
                            <option value="invited" selected={member.status === "invited"}>invited</option>
                            <option value="active" selected={member.status === "active"}>active</option>
                            <option value="disabled" selected={member.status === "disabled"}>disabled</option>
                          </select>
                          <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">Save</button>
                        </form>
                      )}
                      <a
                        href={`/admin/members/${member.id}/revoke-sessions`}
                        class="bp-btn bp-btn-danger bp-btn-sm"
                        data-confirm
                        data-confirm-title={`Revoke sessions for ${member.displayName}?`}
                        data-confirm-body={`${member.displayName} will be signed out everywhere and will need a new login link to get back in.`}
                        data-confirm-action={`/admin/members/${member.id}/revoke-sessions`}
                        data-confirm-cta="Revoke sessions"
                      >
                        Revoke sessions
                      </a>
                    </div>
                  </details>
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AppLayout>
