---
import { SCOPES } from "@bandplate/core";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import AdminHeader from "../../../components/AdminHeader.astro";
import CopyButton from "../../../components/CopyButton.tsx";
import AppLayout from "../../../layouts/AppLayout.astro";
import { getAppDeps, getAuthDeps } from "../../../server/app.js";
import { isSameOrigin } from "../../../server/csrf.js";
import { formatTimestamp } from "../../../server/format.js";
import {
  type CreateTokenResult,
  createToken,
  listTokens,
  updateTokenScopes,
} from "../../../server/pages/admin-tokens.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);

let createError: string | undefined;
let createErrorField: "label" | "scopes" | undefined;
let formError: string | undefined;
let created: Extract<CreateTokenResult, { kind: "ok" }> | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    const intent = formData.get("intent");

    if (intent === "create") {
      const result = await createToken(authDeps, formData);
      if (result.kind === "ok") {
        // Rendered directly below, on THIS response — never via a redirect,
        // since the raw secret must never be persisted or logged anywhere,
        // including a query string.
        created = result;
      } else {
        createError = result.error;
        createErrorField = result.field;
      }
    } else if (intent === "update") {
      const id = String(formData.get("tokenId") ?? "");
      const result = await updateTokenScopes(appDeps.db, id, formData);
      if (result.kind === "ok") {
        return Astro.redirect("/admin/tokens?updated=1");
      }
      formError = "Couldn't update that token's scopes — choose at least one and try again.";
    }
  }
}

const tokens = await listTokens(appDeps.db);
const justUpdated = Astro.url.searchParams.get("updated") === "1";
const justRevoked = Astro.url.searchParams.get("revoked") === "1";
---

<AppLayout title="Admin — Tokens" principal={principal} current="admin" adminSection="tokens">
  <div class="bp-stack">
    <AdminHeader title="Tokens" current="tokens" />

    {justUpdated && <Banner kind="success">Scopes updated.</Banner>}
    {justRevoked && <Banner kind="success">Token revoked. Anything using it will stop working immediately.</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    {created && (
      <Banner kind="success" title="Token created">
        <p class="mb-2">
          <strong>Copy this secret now — it will not be shown again.</strong>
        </p>
        {/* The one place mono earns its keep on these pages: a random secret
            is read a character at a time, and that is exactly what a
            fixed-width face is for. Email addresses and labels are words. */}
        <p class="bp-mono mb-2">{created.rawToken}</p>
        <CopyButton client:load value={created.rawToken} label="Copy secret" />
      </Banner>
    )}

    {/* The label sits inline like the other add forms; the scope checkboxes
        wrap under it because there are eight of them and they are the actual
        decision being made here. */}
    <form method="post" class="bp-admin-add bp-admin-add--stacked" novalidate>
      <input type="hidden" name="intent" value="create" />
      <Field
        label="Label"
        name="label"
        required
        hint="What this token is for — e.g. reaper-bridge"
        error={createErrorField === "label" ? createError : undefined}
      />
      <fieldset
        class="bp-checkbox-group"
        aria-invalid={createErrorField === "scopes" ? "true" : undefined}
        aria-describedby={createErrorField === "scopes" ? "scopes-error" : undefined}
      >
        <legend class="bp-eyebrow">Scopes</legend>
        {SCOPES.map((scope) => (
          <span class="bp-checkbox-item">
            <input type="checkbox" id={`scope-new-${scope}`} name="scopes" value={scope} />
            <label for={`scope-new-${scope}`}>{scope}</label>
          </span>
        ))}
        {createErrorField === "scopes" && (
          <p class="bp-field-error" id="scopes-error" role="alert">{createError}</p>
        )}
      </fieldset>
      <button type="submit" class="bp-btn bp-btn-primary">Create token</button>
    </form>

    {tokens.length === 0 ? (
      <div class="bp-empty-state">
        <p>No service tokens yet — create one above.</p>
      </div>
    ) : (
      <div class="bp-table-wrap">
        <table class="bp-table">
          <thead>
            <tr>
              <th scope="col">Label</th>
              <th scope="col">Scopes</th>
              <th scope="col">Created</th>
              <th scope="col">Last used</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {tokens.map((token) => (
              <tr>
                <td data-label="Label">
                  <span class="bp-table-name">{token.label}</span>
                  {token.revokedAt && <span class="bp-kind">revoked</span>}
                </td>
                <td data-label="Scopes" class="bp-table-quiet">{token.scopes.join(", ")}</td>
                <td data-label="Created" class="bp-table-quiet bp-table-when">{formatTimestamp(token.createdAt)}</td>
                <td data-label="Last used" class="bp-table-quiet bp-table-when">{formatTimestamp(token.lastUsedAt)}</td>
                <td data-label="Actions">
                  <div class="bp-table-actions">
                    {!token.revokedAt && (
                      <>
                        <details>
                          {/* No cursor utility needed — .bp-btn already sets cursor: pointer. */}
                          <summary class="bp-btn bp-btn-secondary bp-btn-sm">Edit scopes</summary>
                          <form method="post" class="mt-3">
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="tokenId" value={token.id} />
                            <fieldset class="bp-checkbox-group">
                              <legend class="sr-only">
                                Scopes for {token.label}
                              </legend>
                              {SCOPES.map((scope) => (
                                <span class="bp-checkbox-item">
                                  <input
                                    type="checkbox"
                                    id={`scope-${token.id}-${scope}`}
                                    name="scopes"
                                    value={scope}
                                    checked={token.scopes.includes(scope)}
                                  />
                                  <label for={`scope-${token.id}-${scope}`}>{scope}</label>
                                </span>
                              ))}
                            </fieldset>
                            <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">Save scopes</button>
                          </form>
                        </details>
                        <a
                          href={`/admin/tokens/${token.id}/revoke`}
                          class="bp-btn bp-btn-danger bp-btn-sm"
                          data-confirm
                          data-confirm-title={`Revoke the token ${token.label}?`}
                          data-confirm-body={`Anything using ${token.label} will stop being able to authenticate immediately. This can't be undone.`}
                          data-confirm-action={`/admin/tokens/${token.id}/revoke`}
                          data-confirm-cta="Revoke token"
                        >
                          Revoke
                        </a>
                      </>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AppLayout>
