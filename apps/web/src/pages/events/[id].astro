---
// One event: kind, date, venue, notes, and the takes recorded that day in
// recorded order (not newest-first — `getEventDetail` asks
// `takesRepo.listByEvent` for `{ order: "asc" }`, reconstructing what
// actually happened during the session).
//
// Measured before deciding on Server Islands: this page's whole query (the
// event plus every take that day, with instruments and songs batch-fetched)
// ran at ~0.5-0.7ms against seeded data — see task-5-report.md. Nothing
// here is deferred.
import { hasAllScopes } from "@bandplate/core";
import { instrumentsRepo, songsRepo } from "@bandplate/db";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import TakeRow from "../../components/TakeRow.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { eventKindLabel, eventLabel, formatLongDate } from "../../server/format.js";
import {
  type EventField,
  archiveEventConsequence,
  findSameDayEvents,
  getEventDetail,
  updateEvent,
} from "../../server/pages/events.js";
import { type TakeField, createTake } from "../../server/pages/takes.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/events");
}

const appDeps = await getAppDeps();

let editError: string | undefined;
let editErrorField: EventField | undefined;
let takeError: string | undefined;
let takeErrorField: TakeField | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "create-take") {
      const result = await createTake(appDeps.db, appDeps.clock.now(), formData);
      if (result.kind === "ok") {
        // Straight to the take: the next thing you do is put audio on it.
        return Astro.redirect(`/takes/${result.take.id}?created=1`);
      }
      if (result.kind === "unknown_parent") {
        takeError = "That's no longer here — reload and try again.";
        takeErrorField = result.field;
      } else {
        takeError = result.error;
        takeErrorField = result.field;
      }
    } else if (formData.get("intent") === "update") {
      const result = await updateEvent(appDeps.db, appDeps.clock.now(), id, formData);
      if (result.kind === "ok") {
        return Astro.redirect(`/events/${id}?saved=1`);
      }
      if (result.kind === "not_found") {
        formError = "That event is no longer here.";
      } else {
        editError = result.error;
        editErrorField = result.field;
      }
    }
  }
}

const detail = await getEventDetail(appDeps.db, id, principal.memberId);
if (!detail) {
  return new Response("Not found.", { status: 404 });
}

const { event, eventFavorited, takes } = detail;
// `eventKindLabel`, not a ternary of its own. This page said "Concert" while
// every take row, the ledger and the take page said "live" for the same event
// — one fact, two words, depending which screen you were on. It also hard-coded
// a three-value vocabulary and fell back to "Session" for anything else, which
// silently mislabels a kind an admin adds later; the helper passes an
// unrecognised value through as itself.
const kindLabel = eventKindLabel(event.kind);
// Title-case for the browser tab, which is the one place this word is a name
// rather than a label — `.bp-kind` uppercases it everywhere it is shown.
const kindTitle = kindLabel.charAt(0).toUpperCase() + kindLabel.slice(1);

const canArchive = hasAllScopes(principal, ["members:admin"]);
const isArchived = event.archivedAt !== null;
const justCreated = Astro.url.searchParams.get("created") === "1";
const justSaved = Astro.url.searchParams.get("saved") === "1";
// The same-day warning, carried across the redirect from `/events`. It is the
// only moment anyone has the context to notice that the bridge will later
// create a SECOND event for this day and split the takes between them.
const sameDayWarning = Astro.url.searchParams.get("dup") === "1";
const heldAtDate = new Date(event.heldAt);
const heldAtValue = `${heldAtDate.getFullYear()}-${String(heldAtDate.getMonth() + 1).padStart(2, "0")}-${String(heldAtDate.getDate()).padStart(2, "0")}`;
// A take added from an event's own page defaults to the day of the event —
// which is what it was, nearly always.
const takeDateValue = heldAtValue;
const justTakeDeleted = Astro.url.searchParams.get("take_deleted") === "1";
const justMerged = Astro.url.searchParams.get("merged") === "1";
// The duplicate this app cannot prevent, offered a repair. Shown to anyone —
// the split is worth knowing about — but only an admin gets the merge link,
// because it archives an event.
const sameDay = await findSameDayEvents(appDeps.db, event);
const [allSongs, allInstruments] = await Promise.all([
  songsRepo.list(appDeps.db),
  instrumentsRepo.list(appDeps.db),
]);
---

<AppLayout title={event.title ?? kindTitle} principal={principal} current="events">
  <div class="bp-stack">
    {isArchived && (
      <Banner kind="info" title="Archived">
        Out of the event archive and off home. Its takes are untouched and still play.
        {canArchive && (
          <a
            slot="action"
            href={`/admin/events/${event.id}/archive?unarchive=1`}
            class="bp-btn bp-btn-secondary bp-btn-sm"
          >
            Put it back
          </a>
        )}
      </Banner>
    )}
    {justCreated && <Banner kind="success">Added. Takes recorded that day go here.</Banner>}
    {sameDayWarning && (
      <Banner kind="info" title="There was already one that day">
        <p class="bp-m0">
          Another {kindLabel} is filed on {formatLongDate(event.heldAt)}. That's fine if you really
          played twice — but if this is the same session, use the one that was already there, or
          the bridge will file its takes against it and leave this one empty.
        </p>
      </Banner>
    )}
    {justSaved && <Banner kind="success">Saved.</Banner>}
    {justTakeDeleted && <Banner kind="success">Take deleted, along with its files.</Banner>}
    {justMerged && <Banner kind="success">Merged. Everything is on this one now.</Banner>}
    {sameDay.length > 0 && (
      <Banner kind="info" title="This day is filed twice">
        Another {kindLabel} sits on {formatLongDate(event.heldAt)}. If you both played twice that's
        right — but if it's the same session, the takes are split between them and the bridge will
        keep filing against whichever one holds its key.
        <Fragment slot="action">
          {sameDay.map((other) => (
            <a href={`/events/${other.id}`} class="bp-btn bp-btn-secondary bp-btn-sm">
              Open the other one
            </a>
          ))}
          {canArchive &&
            sameDay.map((other) => (
              <a
                href={`/admin/events/${event.id}/merge?into=${other.id}`}
                class="bp-btn bp-btn-secondary bp-btn-sm"
              >
                Move its takes here
              </a>
            ))}
        </Fragment>
      </Banner>
    )}
    {formError && <Banner kind="error">{formError}</Banner>}

    <header class="bp-event-hero">
      <div class="bp-event-hero-line">
        <span class="bp-kind">{kindLabel}</span>
        {/* Not .bp-mono — that's for technical data (chord progressions,
        timestamps, durations), not a human title, and its word-break:
        break-all would mangle a long venue-derived title with no real word
        boundaries to break at. */}
        {event.venue && <span class="bp-event-hero-venue">{event.venue}</span>}
      </div>
      <div class="bp-title-row">
      <h1 class="bp-hero-date">
        {formatLongDate(event.heldAt)}
        <span class="bp-take-favorite-mark">
          <FavoriteToggle
            targetType="event"
            targetId={event.id}
            favorited={eventFavorited}
            label={eventLabel(event) || `this ${kindLabel}`}
            size="lg"
          />
        </span>
      </h1>
        <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm" data-sheet-open="edit-event">
          Edit
        </button>
      </div>
      {event.title && <p class="bp-event-hero-title bp-m0">{event.title}</p>}
      {event.notes && <p class="bp-event-hero-notes bp-m0">{event.notes}</p>}

    </header>


    <RecordSheet
      id="add-take"
      eyebrow="New take"
      title="Add a take"
      subtitle="It goes on this session; the audio comes afterwards."
    >
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="create-take" />
        <input type="hidden" name="eventId" value={event.id} />
        <div class="bp-sheet-body">
          <div class="bp-sheet-field">
            <label class="bp-eyebrow" for="take-song-pick">Song</label>
            <select class="bp-select" id="take-song-pick" name="songId">
              {allSongs.map((option) => (
                <option value={option.id}>{option.title}</option>
              ))}
            </select>
          </div>
          <Field
            label="Recorded"
            name="recordedAt"
            type="date"
            required
            value={takeDateValue}
            error={takeErrorField === "recordedAt" ? takeError : undefined}
          />
          <Field
            label="Label"
            name="label"
            hint="Which pass it was — take 3, with the horns. Optional."
            error={takeErrorField === "label" ? takeError : undefined}
          />
          <fieldset class="bp-sheet-field">
            <legend class="bp-eyebrow">Instruments</legend>
            <div class="bp-filter-pills">
              {allInstruments.map((instrument) => (
                <label class="bp-filter-pill-check">
                  <input type="checkbox" name="instrumentIds" value={instrument.id} />
                  <span class="bp-filter-pill">{instrument.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="bp-sheet-hint bp-m0">
            This makes the take; the audio goes on afterwards. If the bridge is going to upload
            this session, let it create the takes instead.
          </p>
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">Add take</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>Cancel</button>
        </div>
      </form>
    </RecordSheet>

    <RecordSheet
      id="edit-event"
      eyebrow="Editing event"
      title={eventLabel(event) || formatLongDate(event.heldAt)}
      subtitle="Only the date and the kind are required."
    >
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="update" />
        <div class="bp-sheet-body">
          <div class="bp-sheet-field">
            <label class="bp-eyebrow" for="edit-event-kind">What was it</label>
            <select class="bp-select" id="edit-event-kind" name="kind">
              <option value="rehearsal" selected={event.kind === "rehearsal"}>Rehearsal</option>
              <option value="concert" selected={event.kind === "concert"}>Concert</option>
              <option value="session" selected={event.kind === "session"}>Session</option>
            </select>
          </div>
          <Field
            label="Date"
            name="heldAt"
            type="date"
            required
            value={heldAtValue}
            error={editErrorField === "heldAt" ? editError : undefined}
          />
          <Field
            label="Venue"
            name="venue"
            value={event.venue ?? ""}
            error={editErrorField === "venue" ? editError : undefined}
          />
          <Field
            label="Title"
            name="title"
            value={event.title ?? ""}
            error={editErrorField === "title" ? editError : undefined}
          />
          <Field
            label="Notes"
            name="notes"
            as="textarea"
            rows="4"
            value={event.notes ?? ""}
            error={editErrorField === "notes" ? editError : undefined}
          />
          {canArchive && !isArchived && (
            <div class="bp-sheet-extras">
              <a
                href={`/admin/events/${event.id}/archive`}
                class="bp-sheet-danger"
                data-confirm
                data-confirm-title={`Archive the ${kindLabel} of ${formatLongDate(event.heldAt)}?`}
                data-confirm-body={archiveEventConsequence(takes.length)}
                data-confirm-action={`/admin/events/${event.id}/archive`}
                data-confirm-cta="Archive event"
              >
                Archive this event
              </a>
            </div>
          )}
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">Save changes</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>Cancel</button>
        </div>
      </form>
    </RecordSheet>

    <section>
      <div class="bp-title-row">
        <h2 class="bp-section-title bp-m0">Takes</h2>
        <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm" data-sheet-open="add-take">
          Add take
        </button>
      </div>
      {takes.length > 0 && (
        <p class="bp-event-hero-hint bp-m0">
          {takes.length} {takes.length === 1 ? "take" : "takes"}, in the order they were played
        </p>
      )}
      {
        takes.length === 0 ? (
          <div class="bp-empty-state">
            <p>No takes logged for this one yet.</p>
          </div>
        ) : (
          <div class="bp-take-list bp-take-list--wide">
            {takes.map((take) => (
              <TakeRow
                take={take}
                instruments={take.instruments}
                context={{ kind: "event", song: take.song, eventKind: event.kind }}
                playableAssetId={take.playableAssetId}
                favorited={take.favorited}
              />
            ))}
          </div>
        )
      }
    </section>
  </div>
</AppLayout>
