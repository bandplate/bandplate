---
import { favoritesRepo } from "@bandplate/db";
// The event archive — rehearsals and concerts together, newest first,
// filterable by kind. The kind filter is a plain GET form (checkboxes),
// same JS-off approach as /songs.
import { messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import EventLedger from "../../components/EventLedger.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { formatLongDate } from "../../server/format.js";
import {
  EVENTS_PER_PAGE,
  type EventField,
  countArchivedEvents,
  createEvent,
  listEventsForArchive,
  parseEventsListArchivedFilter,
  parseEventsListKindFilter,
} from "../../server/pages/events.js";
import { pageRequest, pageView, paginationLabels } from "../../server/pagination.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();

const locale = Astro.locals.locale;
const t = messages(locale);

let createError: string | undefined;
let createErrorField: EventField | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "create") {
      const result = await createEvent(appDeps.db, appDeps.clock.now(), formData);
      if (result.kind === "ok") {
        // Straight to the event, because the next thing you do is put takes
        // in it. `dup=1` carries the same-day warning across the redirect —
        // it names no record, so it is safe in a query string.
        const dup = result.sameDay.length > 0 ? "&dup=1" : "";
        return Astro.redirect(`/events/${result.event.id}?created=1${dup}`);
      }
      createError = result.error;
      createErrorField = result.field;
    }
  }
}

const kindFilter = parseEventsListKindFilter(Astro.url.searchParams);
const viewingArchive = parseEventsListArchivedFilter(Astro.url.searchParams);
const { page, args: eventsPage } = pageRequest(Astro.url.searchParams, EVENTS_PER_PAGE);
const [events, favoriteEventIds, archivedCount] = await Promise.all([
  listEventsForArchive(appDeps.db, kindFilter, viewingArchive, eventsPage),
  favoritesRepo.listTargetIdsByMember(appDeps.db, principal.memberId, "event"),
  countArchivedEvents(appDeps.db),
]);
const pages = pageView({ url: Astro.url, page, perPage: EVENTS_PER_PAGE, total: events.total });
// A link to a page that has since fallen off the end lands on the last real
// one, filters intact, rather than on an empty archive.
if (pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

const justArchived = Astro.url.searchParams.get("archived_ok") === "1";
// `<input type="date">` wants YYYY-MM-DD in the member's own timezone, which
// is also what `createEvent` parses back — see `parseDateInput`.
const now = new Date(appDeps.clock.now());
const todayValue = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;

const KIND_OPTIONS = [
  { value: "rehearsal", label: t.events.filterRehearsals },
  { value: "concert", label: t.events.filterConcerts },
  { value: "session", label: t.events.filterSessions },
] as const;

// Every kind is on when nothing is filtered — `parseEventsListKindFilter`
// already reads an empty list as "all", so an unfiltered URL and an all-three
// URL mean the same thing and the pills show the same state for both.
const allKinds = KIND_OPTIONS.map((o) => o.value);
const selected = kindFilter.length > 0 ? kindFilter : [...allKinds];

/**
 * Where a pill points: the current selection with this kind flipped. Plain
 * links, so one tap applies the filter and the page still works with no JS —
 * the same bar the checkbox form met, without its Apply and Clear buttons.
 *
 * Two cases are deliberately collapsed to a bare `/events`: everything
 * selected, and nothing selected. The parser reads both as "all", so a URL
 * carrying all three kinds would be a longer way to say the same thing — and
 * turning the last pill off has to land somewhere honest rather than on an
 * empty list that claims there are no events.
 */
function toggleHref(kind: (typeof allKinds)[number]): string {
  const next = selected.includes(kind) ? selected.filter((k) => k !== kind) : [...selected, kind];
  const params = new URLSearchParams();
  if (next.length > 0 && next.length !== allKinds.length) {
    for (const k of allKinds.filter((k) => next.includes(k))) {
      params.append("kind", k);
    }
  }
  if (viewingArchive) {
    params.set("archived", "1");
  }
  const qs = params.toString();
  return qs ? `/events?${qs}` : "/events";
}

/** The Archived pill toggles, keeping the kind filter in force. */
function archivedHref(): string {
  const params = new URLSearchParams();
  if (kindFilter.length > 0 && kindFilter.length !== allKinds.length) {
    for (const k of allKinds.filter((k) => kindFilter.includes(k))) {
      params.append("kind", k);
    }
  }
  if (!viewingArchive) {
    params.set("archived", "1");
  }
  const qs = params.toString();
  return qs ? `/events?${qs}` : "/events";
}
---

<AppLayout title={t.events.title} principal={principal} current="events">
  <div class="bp-stack">
    <div class="bp-title-row">
      <h1 class="bp-page-title">{t.events.title}</h1>
      <button type="button" class="bp-btn bp-btn-primary" data-sheet-open="add-event">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        {t.events.addEvent}
      </button>
    </div>

    {justArchived && <Banner kind="success">{t.events.archivedDone}</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    <RecordSheet
      id="add-event"
      eyebrow={t.events.addEventEyebrow}
      title={t.events.addEventTitle}
      subtitle={t.events.addEventSubtitle}
    >
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="create" />
        <div class="bp-sheet-body">
          <div class="bp-sheet-field">
            <label class="bp-eyebrow" for="event-kind">What was it</label>
            <select class="bp-select" id="event-kind" name="kind">
              <option value="rehearsal">{t.events.kindRehearsal}</option>
              <option value="concert">{t.events.kindConcert}</option>
              <option value="session">{t.events.kindSession}</option>
            </select>
          </div>
          <Field
            label={t.events.dateLabel}
            name="heldAt"
            type="date"
            required
            value={todayValue}
            error={createErrorField === "heldAt" ? createError : undefined}
          />
          <Field
            label={t.events.venueLabel}
            name="venue"
            hint={t.events.venueHint}
            error={createErrorField === "venue" ? createError : undefined}
          />
          <Field
            label={t.events.titleLabel}
            name="title"
            hint={t.events.titleHint}
            error={createErrorField === "title" ? createError : undefined}
          />
          <p class="bp-sheet-hint bp-m0">
            If the bridge is going to upload this session, let it create the event — it files its
            takes against the one it made.
          </p>
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">{t.events.addEvent}</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.events.cancel}</button>
        </div>
      </form>
    </RecordSheet>

    <div class="bp-filter-pills">
      {
        KIND_OPTIONS.map((option) => {
          const on = selected.includes(option.value);
          return (
            <a href={toggleHref(option.value)} class="bp-filter-pill" aria-pressed={on ? "true" : "false"}>
              <span class="bp-filter-pill-mark" aria-hidden="true">
                {on ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12.5l5.5 5.5L20 6" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <circle cx="12" cy="12" r="9" />
                  </svg>
                )}
              </span>
              {option.label}
            </a>
          );
        })
      }
      {
        (archivedCount > 0 || viewingArchive) && (
          <a
            href={archivedHref()}
            class="bp-filter-pill bp-filter-pill--set-apart"
            aria-pressed={viewingArchive ? "true" : "false"}
          >
            Archived
          </a>
        )
      }
    </div>

    {
      events.rows.length === 0 ? (
        <div class="bp-empty-state">
          <p>
            {kindFilter.length > 0
              ? t.events.emptyFiltered
              : t.events.empty}
          </p>
        </div>
      ) : (
        // The same ledger home draws, with a star per row — this is where a
        // member decides an event is worth keeping in reach, and pinning it
        // here is how it reaches home's shelf. Home's own copy has no stars: a
        // column of them down a chronology reads as a second list.
        <EventLedger events={events.rows} favoritedIds={favoriteEventIds} />
      )
    }

    <Pagination {...pages} labels={paginationLabels(pages, "event")} />
  </div>
</AppLayout>
