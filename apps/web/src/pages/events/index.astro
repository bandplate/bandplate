---
// The event archive — rehearsals and concerts together, newest first,
// filterable by kind. The kind filter is a plain GET form (checkboxes),
// same JS-off approach as /songs.
import { favoritesRepo } from "@bandplate/db";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { eventLabel, formatLongDate } from "../../server/format.js";
import { listEventsForArchive, parseEventsListKindFilter } from "../../server/pages/events.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const kindFilter = parseEventsListKindFilter(Astro.url.searchParams);
const [events, favoriteEventIds] = await Promise.all([
  listEventsForArchive(appDeps.db, kindFilter),
  favoritesRepo.listTargetIdsByMember(appDeps.db, principal.memberId, "event"),
]);

const KIND_OPTIONS = [
  { value: "rehearsal", label: "Rehearsals" },
  { value: "concert", label: "Concerts" },
  { value: "session", label: "Sessions" },
] as const;
---

<AppLayout title="Events" principal={principal} current="events">
  <div class="bp-stack">
    <h1 class="bp-page-title">Events</h1>

    <form method="get" class="bp-toolbar">
      <fieldset class="bp-checkbox-group">
        <legend>Kind</legend>
        {
          KIND_OPTIONS.map((option) => (
            <span class="bp-checkbox-item">
              <input
                type="checkbox"
                id={`kind-${option.value}`}
                name="kind"
                value={option.value}
                checked={kindFilter.includes(option.value)}
              />
              <label for={`kind-${option.value}`}>{option.label}</label>
            </span>
          ))
        }
      </fieldset>
      <div class="bp-toolbar-actions">
        <button type="submit" class="bp-btn bp-btn-primary">Apply</button>
        {kindFilter.length > 0 && (
          <a href="/events" class="bp-btn bp-btn-secondary">
            Clear
          </a>
        )}
      </div>
    </form>

    {
      events.length === 0 ? (
        <div class="bp-empty-state">
          <p>
            {kindFilter.length > 0
              ? "Nothing of that kind yet — try clearing the filter."
              : "No events yet — they'll show up here once a rehearsal or show is logged."}
          </p>
        </div>
      ) : (
        <div class="bp-event-list">
          {events.map((event) => (
            <div class={`bp-event-row bp-event-row--${event.kind}`}>
              <a href={`/events/${event.id}`} class="bp-event-row-link">
                <div class="bp-event-row-main">
                  <p class="bp-event-row-date bp-m0">{formatLongDate(event.heldAt)}</p>
                  <p class="bp-event-row-venue bp-m0">
                    <span class={`bp-badge bp-badge-${event.kind}`}>{event.kind}</span>
                    {eventLabel(event) && ` ${eventLabel(event)}`}
                    <span class="bp-event-row-count">
                      {event.takeCount} {event.takeCount === 1 ? "take" : "takes"}
                    </span>
                  </p>
                </div>
                <div class="bp-event-row-stats">
                  {event.takeCount} {event.takeCount === 1 ? "take" : "takes"}
                </div>
              </a>
              <FavoriteToggle
                targetType="event"
                targetId={event.id}
                favorited={favoriteEventIds.has(event.id)}
                label={eventLabel(event) || `this ${event.kind}`}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</AppLayout>
