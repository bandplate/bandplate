---
// Home — opened one-handed, mid-rehearsal. It answers three questions, always
// in this order, one section each, on a phone and on a wide screen alike:
//
//   1. Na pultu: what is new for you. One card, the page's only strong call to
//      action: the newest band event with takes published since your last
//      visit, with "Přehrát vše" and, when you owe it, "Hlasovat (N)". With
//      nothing new the section is not drawn at all, heading included; an
//      empty state here would be a nag with nothing to say.
//   2. Rozpracované: what you are working on. Your pinned things as PLATES,
//      one row at one size, and your stash as a card beside them (under them
//      on a phone).
//   3. Poslední akce: what the band recorded lately, as a LEDGER.
//
// Width only ever puts things side by side WITHIN a section. The previous home
// split the page into two unrelated columns and led with a large "Zpátky k"
// hero, and the owner's verdict was that it had no natural reading order. Both
// are gone, and so is the stash's own heading and pill: the stash card
// replaces them.
//
// Still deliberately absent:
//
//   - A "needs your vote" list. The first card counts the NEW takes you have
//     not voted on, which is a fact about what just arrived; the full count
//     lives on `/me`.
//   - Takes nested under each recent event. Opening the event reaches them.
//   - `claimTakeTransition` / `<TakeTransitionRetarget />`. One take can still
//     appear only once on this page (the plates are the only take links), so
//     no `view-transition-name` is ever assigned twice.
import { formatDayMonth, formatDuration, formatShortDate, messages } from "@bandplate/i18n";
import Inbox from "@lucide/astro/icons/inbox";
import Play from "@lucide/astro/icons/play";
import { stashName } from "../client/stash-display.js";
import EventLedger from "../components/EventLedger.astro";
import PinnedPlate from "../components/PinnedPlate.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { getAppDeps } from "../server/app.js";
import { eventName } from "../server/format.js";
import { getHomeData } from "../server/pages/home.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const { onTheStand, pinned, recentEvents, stash } = await getHomeData(
  appDeps.db,
  principal.memberId,
);

const locale = Astro.locals.locale;
const t = messages(locale);

// --- Na pultu -------------------------------------------------------------

// The card's title: the event's own name, or, for the common untitled
// rehearsal, its kind and its day ("Zkouška 13. září"). The ledger says
// "Bez názvu" in that case, but a card's title has to be a name you could
// say out loud.
function standTitle(event: NonNullable<typeof onTheStand>["event"]): string {
  const named = eventName(event, null);
  if (named) {
    return named;
  }
  const kind = t.events.kindLabel(event.kind);
  return t.home.unnamedEventTitle({
    kind: kind.charAt(0).toLocaleUpperCase(locale) + kind.slice(1),
    date: formatDayMonth(locale, event.heldAt),
  });
}

const stand = onTheStand
  ? {
      id: onTheStand.event.id,
      title: standTitle(onTheStand.event),
      line: t.home.newTakesLine({
        takes: t.events.takeCount(onTheStand.takeCount),
        unvoted: onTheStand.unvotedCount,
      }),
      unvoted: onTheStand.unvotedCount,
      // Only takes with a ready master can be queued. A new take still
      // uploading is counted in the line above but has nothing to play yet.
      queue: onTheStand.takes.flatMap(({ take, song, playableAssetId }) =>
        playableAssetId
          ? [{ takeId: take.id, assetId: playableAssetId, title: song?.title ?? t.home.untitled }]
          : [],
      ),
    }
  : undefined;

// --- Rozpracované -----------------------------------------------------------

const stashCard = stash
  ? {
      count: stash.count,
      name: stashName(
        {
          songId: stash.latest.songId,
          songTitle: stash.latestSong?.title,
          label: stash.latest.label,
        },
        { noSong: t.stash.noSongYet, unknownSong: t.stash.unknownSong },
      ),
      when:
        stash.latest.durationMs != null
          ? t.home.stashLatestWhen({
              date: formatShortDate(locale, stash.latest.recordedAt),
              length: formatDuration(stash.latest.durationMs),
            })
          : formatShortDate(locale, stash.latest.recordedAt),
    }
  : undefined;
---

<AppLayout title={t.home.title} principal={principal} current="home">
  <div class="bp-home">
    {/* Every section is headed by an h2; the page's own h1 is the page's
        name, read out but not drawn, since the sidebar already says where you
        are. */}
    <h1 class="bp-visually-hidden">{t.home.title}</h1>

    {
      stand && (
        <section class="bp-home-section" aria-labelledby="home-stand-heading">
          {/* The card says what it is ("Nové od tvé poslední návštěvy"), so
              the heading is for the page outline only, not for the eye. */}
          <h2 id="home-stand-heading" class="bp-visually-hidden">
            {t.home.onTheStand}
          </h2>
          <div class="bp-stand">
            <p class="bp-eyebrow bp-stand-eyebrow">
              <span class="bp-stand-dot" aria-hidden="true" />
              {t.home.newSinceLastVisit}
            </p>
            <div class="bp-stand-head">
              <h3 class="bp-stand-title">
                <a href={`/events/${stand.id}`}>{stand.title}</a>
              </h3>
              <p class="bp-stand-line">{stand.line}</p>
            </div>
            {(stand.queue.length > 0 || stand.unvoted > 0) && (
              <div class="bp-stand-actions">
                {/* The event page's own play-all: `Player.tsx` reads the
                    queue out of the element this names. The queue is the
                    NEW takes, the ones the line above counts. */}
                {stand.queue.length > 0 && (
                  <button
                    type="button"
                    class="bp-btn bp-btn-secondary bp-btn-sm bp-btn-play-all bp-stand-play"
                    data-play-queue-start="home-new-takes"
                  >
                    {/* The event page's own "Přehrát vše": one play-all
                        control across the app, the gold disc carrying it. */}
                    <span class="bp-btn-play-disc" aria-hidden="true">
                      <Play size={13} fill="currentColor" />
                    </span>
                    {t.events.playAll}
                  </button>
                )}
                {/* `/takes?unvoted=1` has no event filter, so this goes to
                    the event, which lists exactly these takes; each one's
                    vote is on its own page, one tap from there. */}
                {stand.unvoted > 0 && (
                  <a href={`/events/${stand.id}`} class="bp-pill bp-pill--action bp-stand-vote">
                    {t.home.voteCount(stand.unvoted)}
                  </a>
                )}
              </div>
            )}
            {/* The play-all queue, as data only. Not buttons: nothing here is
                pressed, and a row of hidden controls would be focusable
                nothing. The attributes are the ones every play toggle
                carries, which is all `readQueueIn` looks at. */}
            {stand.queue.length > 0 && (
              <div id="home-new-takes" hidden>
                {stand.queue.map((item) => (
                  <span
                    data-audio-source
                    data-take-id={item.takeId}
                    data-asset-id={item.assetId}
                    data-title={item.title}
                    data-subtitle={stand.title}
                    data-source-kind="master"
                    data-role="toggle"
                  />
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    <section class="bp-home-section" aria-labelledby="home-progress-heading">
      <h2 id="home-progress-heading" class="bp-section-title bp-home-heading">
        {t.home.inProgress}
      </h2>
      {
        pinned.length === 0 && !stashCard ? (
          <div class="bp-empty-state">
            <p>
              <strong>{t.home.emptyPinnedLead}</strong> {t.home.emptyPinnedBody}{" "}
              <a href="/takes">{t.home.emptyPinnedLink}</a> {t.home.emptyPinnedTail}
            </p>
          </div>
        ) : (
          <div class="bp-progress">
            {pinned.length > 0 && (
              /* The wrapper exists only to hang the scroll fades on — the row
                 itself is the scroll container, and a pseudo-element on it
                 would scroll away with the content. */
              <div class="bp-pinned-rail-wrap">
                <div class="bp-pinned-rail">
                  {pinned.map((item) => (
                    <PinnedPlate item={item} />
                  ))}
                </div>
              </div>
            )}
            {stashCard && (
              <div class="bp-stash-card">
                <h3 class="bp-stash-card-title">
                  <Inbox size={16} aria-hidden="true" />
                  <span>
                    {t.stash.pill}{" "}<span class="bp-title-count">({stashCard.count})</span>
                  </span>
                </h3>
                <div class="bp-stash-card-latest">
                  <p class="bp-stash-card-name">{stashCard.name}</p>
                  <p class="bp-stash-card-meta">{stashCard.when}</p>
                </div>
                <div class="bp-pills">
                  <a href="/takes?stash=1" class="bp-pill bp-pill--action">
                    <Inbox size={16} aria-hidden="true" />
                    {t.stash.openStash}
                  </a>
                  <a
                    href="/record"
                    class="bp-pill bp-pill--action bp-record-btn bp-pill--record"
                    data-astro-reload
                  >
                    <span class="bp-record-mark" aria-hidden="true" />
                    {t.stash.recordIdea}
                  </a>
                </div>
              </div>
            )}
          </div>
        )
      }
    </section>

    <section class="bp-home-section" aria-labelledby="home-events-heading">
      <h2 id="home-events-heading" class="bp-section-title bp-home-heading">
        {t.home.recentEvents}
      </h2>
      {
        recentEvents.length === 0 ? (
          <div class="bp-empty-state">
            <p>{t.home.emptyEvents}</p>
          </div>
        ) : (
          <EventLedger events={recentEvents} footerHref="/events" />
        )
      }
    </section>
  </div>
</AppLayout>
