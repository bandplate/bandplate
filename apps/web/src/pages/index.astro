---
// Home — opened one-handed, mid-rehearsal. It answers two things and no more:
// what you PINNED (the songs and takes you are working on), and what the band
// recorded lately.
//
// Two sections, drawn so they cannot be mistaken for each other. Pinned items
// are PLATES — the acetate the app is named for, a dark grooved disc with a
// centre label — because they are things you reach for, and a list of rows was
// what made this page read as undifferentiated stuff. Recent events are a
// LEDGER: a date spine on the left, the venue as the line, the kind in small
// caps, the take count on the right. A chronology drawn as one.
//
// What used to be here and is deliberately gone:
//
//   - "Needs your vote". Nothing on the page everyone opens should nag, and a
//     new recording usually arrives as a shared link anyway. The count moved to
//     `/me`, where it is something you go looking for.
//   - Takes nested under each recent event. Home says an event happened;
//     opening it is how you reach its takes.
//   - `claimTakeTransition` / `<TakeTransitionRetarget />`. Both existed only
//     because one take could appear in two sections of this page at once, which
//     assigns the same `view-transition-name` twice and (per the spec) silently
//     aborts the transition for the WHOLE page. With one pinned list and no
//     take rows, a take cannot appear twice, so the problem and its two
//     workarounds are gone together.
import EventLedger from "../components/EventLedger.astro";
import PinnedPlate from "../components/PinnedPlate.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { getAppDeps } from "../server/app.js";
import { eventLabel, formatShortDate } from "../server/format.js";
import { getHomeData, pinnedKindWord } from "../server/pages/home.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const { pinned, recentEvents } = await getHomeData(appDeps.db, principal.memberId);

// The most recently pinned thing leads the page — "back to" whatever you were
// last on. The rest follow in the rail beneath it.
const [hero, ...rail] = pinned;

/** What the hero says under its title: the event it came from, then the date,
 *  on separate lines. No running time — this is an invitation back to a take,
 *  not a spec sheet. */
function heroLines(item: typeof hero): string[] {
  if (!item) {
    return [];
  }
  if (item.kind === "take") {
    const name = item.event ? eventLabel(item.event) : "";
    return [name, formatShortDate(item.take.recordedAt)].filter(Boolean);
  }
  if (item.kind === "song") {
    return [`${item.takeCount} ${item.takeCount === 1 ? "take" : "takes"}`];
  }
  // An untitled event IS its date — that is what the plate's label and the
  // title both say — so repeating it underneath told the member nothing twice.
  // What it has instead is a count.
  const name = eventLabel(item.event);
  const count = `${item.takeCount} ${item.takeCount === 1 ? "take" : "takes"}`;
  return name ? [name, formatShortDate(item.event.heldAt)] : [count];
}
---

<AppLayout title="Home" principal={principal} current="home">
  <div class="bp-home">
    <section class="bp-home-pinned">
      {
        hero ? (
          <>
            {/* One link, not two. The plate and the title point at the same
                thing, so they hover, focus and click together — the plate was
                lifting on its own while the words beside it sat inert. The
                heading stays an `<h1>` inside it so the page still has one. */}
            <a
              class="bp-pinned-hero"
              href={hero.kind === "take" ? `/takes/${hero.id}` : hero.kind === "song" ? `/songs/${hero.song.slug}` : `/events/${hero.id}`}
            >
              <PinnedPlate item={hero} size="hero" interactive={false} />
              <div class="bp-pinned-hero-text">
                <p class="bp-eyebrow bp-pinned-hero-eyebrow bp-m0">Back to</p>
                <h1 class="bp-pinned-hero-title bp-m0">
                  {hero.kind === "take"
                    ? (hero.song?.title ?? "Untitled take")
                    : hero.kind === "song"
                      ? hero.song.title
                      : formatShortDate(hero.event.heldAt)}
                </h1>
                {/* The kind leads the meta line, exactly as it does on the
                    rail plates below — the hero was the one pinned thing on the
                    page that never said whether it was a song, a take or an
                    event. */}
                <p class="bp-pinned-hero-meta bp-m0">
                  <span class="bp-kind">{pinnedKindWord(hero)}</span>
                  <span class="bp-pinned-hero-sep" aria-hidden="true" />
                  <span>
                    {heroLines(hero).map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </span>
                </p>
              </div>
            </a>
            {rail.length > 0 && (
              <div class="bp-pinned-rail">
                {rail.map((item) => (
                  <PinnedPlate item={item} size="rail" />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="bp-empty-state">
            <p>
              <strong>Nothing pinned yet.</strong> Tap the star on a song, take or event and it
              lands here — this is the shelf you reach for. <a href="/takes">Browse the archive</a>{" "}
              to find something.
            </p>
          </div>
        )
      }
    </section>

    <section class="bp-home-ledger">
      <h2 class="bp-section-title">Recent events</h2>
      {
        recentEvents.length === 0 ? (
          <div class="bp-empty-state">
            <p>
              No events yet. Ask whoever's running the session to log the next rehearsal or show —
              it'll show up here as soon as they do.
            </p>
          </div>
        ) : (
          <EventLedger events={recentEvents} footerHref="/events" />
        )
      }
    </section>
  </div>
</AppLayout>
