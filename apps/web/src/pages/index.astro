---
// Home — the page a member opens one-handed, mid-rehearsal (brief §3), so
// it answers "what should I listen to" in the order the brief specifies:
// favorites first (the things they reach for), then recent events with
// their takes, then "needs your vote". No longer public (see
// `server/guard.ts`) — this reads the signed-in member's own favorites and
// unvoted takes, so it needs a principal like every other member-facing
// page now that it's real.
//
// Favorites and "needs your vote" both got their real controls in Task 8
// (`FavoriteToggle`/`VoteToggle`, wired through `TakeRow`'s trailing slot
// and per-row favorite mark) — see task-8-report.md.
//
// `transitionName`/`claimTakeTransition` (review round 1, F1): a take that
// is BOTH a favorite and also appears in "recent events" or "needs your
// vote" would otherwise get the same `view-transition-name` twice on this
// page — which, per the CSS View Transitions spec, silently aborts the
// transition for the WHOLE page, not just those two rows. Only the first
// section to render a given take id keeps the name; later occurrences
// don't get one (the row still works, it just isn't a morph target). See
// `TakeRow.astro`'s own header comment for the prop this composes with.
//
// `<TakeTransitionRetarget />` (Fix round 3): JS-progressive-enhancement
// that moves the claimed name onto whichever occurrence the member
// actually clicks, so the transition morphs from the right place on
// screen. See that component's own header comment.
import FavoriteToggle from "../components/FavoriteToggle.astro";
import TakeRow from "../components/TakeRow.astro";
import TakeTransitionRetarget from "../components/TakeTransitionRetarget.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { getAppDeps } from "../server/app.js";
import { eventLabel, formatLongDate } from "../server/format.js";
import { getHomeData } from "../server/pages/home.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const { favorites, favoriteSongIds, recentEvents, unvotedTakes } = await getHomeData(
  appDeps.db,
  principal.memberId,
);

const hasFavorites =
  favorites.songs.length > 0 || favorites.takes.length > 0 || favorites.events.length > 0;
// Sub-headings ("Songs"/"Events"/"Takes") only earn their keep when more
// than one kind is actually present — a single-kind favorites list needs
// no label repeating what the section heading already said.
const favoriteKindCount = [
  favorites.songs.length > 0,
  favorites.events.length > 0,
  favorites.takes.length > 0,
].filter(Boolean).length;

const usedTakeTransitionIds = new Set<string>();
/** First call for a given take id gets the real name; every later call on
 *  this same page render gets `null` (no `transition:name` at all). */
function claimTakeTransition(takeId: string): string | null {
  if (usedTakeTransitionIds.has(takeId)) {
    return null;
  }
  usedTakeTransitionIds.add(takeId);
  return `take-${takeId}`;
}
---

<AppLayout title="Home" principal={principal} current="home">
  <TakeTransitionRetarget />
  <div class="bp-stack">
    <h1 class="bp-page-title">Welcome back</h1>

    <section>
      <h2 class="bp-section-title">Your favorites</h2>
      {
        !hasFavorites ? (
          <div class="bp-empty-state">
            <p>
              Nothing pinned yet — tap the star on a song, take, or event to pin it here.{" "}
              <a href="/search">Browse the archive</a> for what to listen to next.
            </p>
          </div>
        ) : (
          <div class="bp-stack bp-stack-tight">
            {favorites.songs.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Songs</p>}
                <div class="bp-song-list">
                  {favorites.songs.map((song) => (
                    <div class="bp-song-row">
                      <a href={`/songs/${song.slug}`} class="bp-song-row-link">
                        <div class="bp-song-row-main">
                          <p class="bp-song-title bp-m0">{song.title}</p>
                        </div>
                      </a>
                      <FavoriteToggle
                        targetType="song"
                        targetId={song.id}
                        favorited={favoriteSongIds.has(song.id)}
                        label={song.title}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
            {favorites.events.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Events</p>}
                <div class="bp-event-list">
                  {favorites.events.map((event) => (
                    <div class={`bp-event-row bp-event-row--${event.kind}`}>
                      <a href={`/events/${event.id}`} class="bp-event-row-link">
                        <div class="bp-event-row-main">
                          <p class="bp-event-row-date bp-m0">{formatLongDate(event.heldAt)}</p>
                          <p class="bp-event-row-venue bp-m0">
                            <span class={`bp-badge bp-badge-${event.kind}`}>{event.kind}</span>
                            {eventLabel(event) && ` ${eventLabel(event)}`}
                          </p>
                        </div>
                      </a>
                      <FavoriteToggle
                        targetType="event"
                        targetId={event.id}
                        favorited={true}
                        label={eventLabel(event) || `this ${event.kind}`}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
            {favorites.takes.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Takes</p>}
                <div class="bp-take-list bp-take-list--wide">
                  {favorites.takes.map((take) => (
                    <TakeRow
                      take={take}
                      instruments={take.instruments}
                      context={{ kind: "full", song: take.song, event: take.event }}
                      transitionName={claimTakeTransition(take.id)}
                      favorited={true}
                      playableAssetId={take.playableAssetId}
                      myVote={take.myVote}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        )
      }
    </section>

    <section>
      <h2 class="bp-section-title">Recent events</h2>
      {
        recentEvents.length === 0 ? (
          <div class="bp-empty-state">
            <p>
              No events yet. Ask whoever's running the session to log the next rehearsal or show —
              it'll show up here as soon as they do.
            </p>
          </div>
        ) : (
          <div class="bp-stack">
            {recentEvents.map(({ event, eventFavorited, takes }) => (
              <div class="bp-home-event-group">
                <div class={`bp-event-row bp-event-row--${event.kind}`}>
                  <a href={`/events/${event.id}`} class="bp-event-row-link">
                    <div class="bp-event-row-main">
                      <p class="bp-event-row-date bp-m0">{formatLongDate(event.heldAt)}</p>
                      <p class="bp-event-row-venue bp-m0">
                        <span class={`bp-badge bp-badge-${event.kind}`}>{event.kind}</span>
                        {eventLabel(event) && ` ${eventLabel(event)}`}
                        <span class="bp-event-row-count">
                          {event.takeCount} {event.takeCount === 1 ? "take" : "takes"}
                        </span>
                      </p>
                    </div>
                    <div class="bp-event-row-stats">
                      {event.takeCount} {event.takeCount === 1 ? "take" : "takes"}
                    </div>
                  </a>
                  <FavoriteToggle
                    targetType="event"
                    targetId={event.id}
                    favorited={eventFavorited}
                    label={eventLabel(event) || `this ${event.kind}`}
                  />
                </div>
                {takes.length > 0 && (
                  <div class="bp-take-list bp-take-list--wide">
                    {takes.map((take) => (
                      <TakeRow
                        take={take}
                        instruments={take.instruments}
                        context={{ kind: "event", song: take.song }}
                        transitionName={claimTakeTransition(take.id)}
                        favorited={take.favorited}
                        playableAssetId={take.playableAssetId}
                        myVote={take.myVote}
                      />
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }
    </section>

    <section>
      <h2 class="bp-section-title">Needs your vote</h2>
      {
        unvotedTakes.length === 0 ? (
          <div class="bp-empty-state">
            <p>
              <strong>You're all caught up.</strong> Every published take has your vote — check back
              once the band records something new.
            </p>
          </div>
        ) : (
          <div class="bp-take-list bp-take-list--wide" data-unvoted-list>
            {unvotedTakes.map((take) => (
              <TakeRow
                take={take}
                instruments={take.instruments}
                context={{ kind: "full", song: take.song, event: take.event }}
                transitionName={claimTakeTransition(take.id)}
                favorited={take.favorited}
                playableAssetId={take.playableAssetId}
                myVote={take.myVote}
              />
            ))}
          </div>
        )
      }
    </section>
  </div>
</AppLayout>
