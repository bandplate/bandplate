---
// GET renders "Sign in as {name}" and mutates nothing at all — no call
// here reaches `consumeLoginToken`. This is load-bearing, not stylistic:
// Gmail, Outlook and AV scanners prefetch links to build previews, and a
// consuming GET would break logins non-deterministically depending on the
// member's mail provider. POST is the only path that consumes the token.
//
// `Cache-Control: no-store` and `<meta name="robots" content="noindex">`
// (via `Layout`'s `noindex` prop) keep any intermediate cache or crawler
// from ever holding onto this URL, since holding it is equivalent to
// holding a (time-limited, single-use) credential.
import { messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import AuthState from "../../components/AuthState.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { getAppDeps, getAuthDeps } from "../../server/app.js";
import { setSessionCookie } from "../../server/cookies.js";
import { isSameOrigin } from "../../server/csrf.js";
import { type LoginTokenView, consume, peekView } from "../../server/pages/login-token.js";

Astro.response.headers.set("Cache-Control", "no-store");

const t = messages(Astro.locals.locale);

const token = Astro.params.token;
if (!token) {
  return Astro.redirect("/login");
}

const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);

let view: LoginTokenView;
let originError = false;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    originError = true;
    view = await peekView(authDeps, token);
  } else {
    const result = await consume(authDeps, token, Astro.request.headers.get("user-agent"));
    if (result.ok) {
      setSessionCookie(Astro.cookies, result.sessionToken, {
        cookieSecure: appDeps.config.cookieSecure,
      });
      return Astro.redirect("/");
    }
    view = { kind: "invalid" };
  }
} else {
  view = await peekView(authDeps, token);
}

// Initials for the identity disc — first letters of the first two words, the
// same rule `/me` uses, so the same person is drawn the same way on the screen
// that lets them in and on the screen about them.
const displayName = view.kind === "valid" ? (view.displayName ?? "") : "";
const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join("");
---

<AuthLayout title={t.auth.signInTitle} noindex>
  {originError && (
    <Banner kind="error">{t.common.originError}</Banner>
  )}

  {view.kind === "valid" ? (
    <>
      {/* A welcome, not a form. The owner's wording: "Hi there! You're
          signing in as [name]. Continue to bandplate." The button is still
          the POST that consumes the token; GET renders and nothing more. */}
      <h1 class="bp-auth-title bp-m0">{t.auth.greeting}</h1>
      <p class="bp-auth-lede bp-m0">{t.auth.signingInAs}</p>
      <div class="bp-auth-who">
        {initials && <span class="bp-auth-avatar" aria-hidden="true">{initials}</span>}
        <p class="bp-auth-title bp-auth-who-name bp-m0">{view.displayName ?? t.auth.yourself}</p>
      </div>
      <form method="post" class="bp-auth-form">
        <button type="submit" class="bp-btn bp-btn-primary">{t.auth.tokenSubmit}</button>
      </form>
      <p class="bp-auth-aside bp-m0">
        {t.auth.notYou} <a href="/login">{t.auth.notYouLink}</a>
      </p>
    </>
  ) : (
    <AuthState tone="alert" title={t.auth.spentTitle}>
      <svg slot="icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V13M12 16.2v.2" />
      </svg>
      {/* One screen for both cases. The server deliberately cannot tell an
          expired link from an already-used one without leaking which, and the
          member's next move is the same either way — so the way out is the
          gold action rather than a link at the bottom of a notice. */}
      <p class="bp-auth-lede bp-m0">{t.auth.spentLede}</p>
      <a href="/login" class="bp-btn bp-btn-primary bp-auth-action">{t.auth.spentAction}</a>
    </AuthState>
  )}
</AuthLayout>
