---
// GET renders the form. POST requests a login link — always the same
// confirmation regardless of whether the address is registered (see
// `handleLoginPost`/`requestLogin`), so this page has no branch that could
// leak membership.
import { messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import Mail from "@lucide/astro/icons/mail";
import Timer from "@lucide/astro/icons/timer";
import AuthState from "../../components/AuthState.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { getAppDeps, getAuthDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { handleLoginPost, type LoginPostResult } from "../../server/pages/login.js";

let result: LoginPostResult | undefined;
let originError = false;

if (Astro.request.method === "POST") {
  const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    originError = true;
  } else {
    const formData = await Astro.request.formData();
    // Workers profile only: `Astro.locals.runtime.ctx.waitUntil` schedules
    // the login-link send after the response is already decided, so the
    // mailer's latency never reaches the request/response timing — see
    // `requestLogin`'s `deferMailSend` doc comment in `@bandplate/core`.
    // `undefined` under the Node adapter (no `locals.runtime`), which
    // makes `handleLoginPost` fall back to its unchanged inline-await
    // behavior there.
    const runtime = Astro.locals.runtime;
    result = await handleLoginPost(
      {
        auth: authDeps,
        rateLimiter: appDeps.rateLimiter,
        appOrigin: appDeps.config.appOrigin,
        trustedProxyDepth: appDeps.config.trustedProxyDepth,
        deferMailSend: runtime ? (send) => runtime.ctx.waitUntil(send()) : undefined,
      },
      formData,
      Astro.request.headers,
    );

    // POST/Redirect/GET. Without it the confirmation is rendered as the POST's
    // own response, so a reload re-submits the form — the browser's "resend?"
    // prompt — and every reload mints another login token and another email.
    //
    // The redirect target is the SAME for a registered and an unregistered
    // address, because `handleLoginPost` already returns "sent" for both: the
    // uniform response that keeps the members table from being an enumeration
    // oracle survives this change intact.
    if (result.kind === "sent") {
      return Astro.redirect("/login?sent=1", 303);
    }
    if (result.kind === "rate_limited") {
      return Astro.redirect(`/login?slow=${result.retryAfterSeconds}`, 303);
    }
    if (result.kind === "invalid") {
      return Astro.redirect("/login?invalid=1", 303);
    }
  }
}

// Read back from the query string, not from `result` — after the redirect
// above there is no POST result to read. Everything here is
// attacker-controllable (anyone can type `?slow=`), so nothing is echoed:
// `sent` and `invalid` are presence-only flags, and `slow` is parsed as an
// integer and clamped before it reaches the page.
const params = Astro.url.searchParams;
const showSent = params.has("sent");
const showInvalid = params.has("invalid");
const rawSlow = Number.parseInt(params.get("slow") ?? "", 10);
const slowSeconds = Number.isFinite(rawSlow) ? Math.min(Math.max(rawSlow, 1), 3600) : undefined;

// `?email=` — set by the invite mail's button (see `sendMemberInvite`), so a
// new member presses one thing instead of retyping the address the mail was
// sent to. Unlike `sent`/`invalid`/`slow` above this one IS echoed, into the
// field's `value`, so it is checked for shape first: anyone can type a query
// string, and a page that renders arbitrary text as a locked-in "your address"
// is a free pretext for whoever sent the link. Astro escapes the attribute, so
// the check is about plausibility, not injection — anything that fails it
// falls through to the ordinary empty form rather than to an error, because a
// mangled parameter is not the visitor's problem to solve.
const PLAUSIBLE_EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const rawInvited = params.get("email")?.trim() ?? "";
const invitedEmail =
  rawInvited.length > 0 && rawInvited.length <= 320 && PLAUSIBLE_EMAIL.test(rawInvited)
    ? rawInvited
    : undefined;

const t = messages(Astro.locals.locale);

// `set:html` is safe here, and this is the only place it is used on this page.
// BOTH halves are ours: the sentence comes from the message catalog, and the
// one interpolated value is `slowSeconds` — a number already clamped to
// 1..3600 on the line above. Nothing a caller typed can reach this string.
//
// It exists because the number is wrapped in `.bp-tabular` so it does not
// jitter as it counts down. Assembling that in the template would mean three
// adjacent expressions in a fixed English order, and Czech puts the number
// somewhere else in the sentence.
const slowLedeHtml =
  slowSeconds === undefined
    ? ""
    : t.auth.slowLede(`<span class="bp-tabular">${slowSeconds}</span>`);
---

<AuthLayout title={t.auth.signInTitle}>
  {originError && (
    <Banner kind="error">{t.common.originError}</Banner>
  )}

  {/* The sent state REPLACES the form rather than sitting above it. The page
      has done the one thing it exists to do, and leaving the field there
      invites a second submission — which mints a second token and a second
      email — to answer a question the page has already answered. */}
  {showSent && (
    <AuthState tone="ok" title={t.auth.sentTitle}>
      <Mail size={26} slot="icon" />
      {/* Deliberately non-committal: a page that confirms an address IS
          registered turns the members table into an enumeration oracle, which
          is exactly what `handleLoginPost`'s uniform response prevents. The
          copy must not give back what the server withholds. */}
      <p class="bp-auth-lede bp-m0">{t.auth.sentLede}</p>
      <a href="/login" class="bp-btn bp-btn-quiet bp-auth-action">{t.auth.sentUseAnother}</a>
    </AuthState>
  )}

  {slowSeconds !== undefined && (
    <AuthState tone="alert" title={t.auth.slowTitle}>
      <Timer size={26} slot="icon" />
      {/* The number is wrapped so it does not jitter as it counts down, which
          is why the sentence arrives already assembled around a placeholder
          rather than as three adjacent expressions — Czech puts the number in
          a different place, and gluing fragments in the template would fix the
          word order in English. */}
      <p class="bp-auth-lede bp-m0" set:html={slowLedeHtml} />
      {/* No button, and no disabled one either: there is genuinely nothing to
          press, and a control that goes live on its own is a control people
          sit and watch. What this state actually provokes is "did the link I
          already asked for die too?", so that is what the line answers. */}
      <p class="bp-auth-note bp-m0">{t.auth.slowNote}</p>
    </AuthState>
  )}

  {!showSent && slowSeconds === undefined && (
    <>
      <h1 class="bp-auth-title">{t.auth.heading}</h1>
      <p class="bp-auth-lede bp-m0">{invitedEmail ? t.auth.invitedLede : t.auth.lede}</p>
      <form method="post" class="bp-auth-form" novalidate>
        {/* `readonly`, not `disabled`: a disabled control is not submitted,
            and this one carries the only value the form has. */}
        <Field
          label={t.auth.emailLabel}
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          value={invitedEmail}
          readonly={invitedEmail !== undefined}
          error={showInvalid ? t.auth.emailRequired : undefined}
        />
        <button type="submit" class="bp-btn bp-btn-primary">{t.auth.submit}</button>
      </form>
      {/* The way out of the lock. An invite is bound to one address, but the
          person holding it may not be — and without this the only escape is
          knowing to edit the URL. */}
      {invitedEmail && (
        <p class="bp-auth-aside bp-m0">
          <a href="/login">{t.auth.sentUseAnother}</a>
        </p>
      )}
    </>
  )}
</AuthLayout>
