---
// GET renders the form. POST requests a login link — always the same
// confirmation regardless of whether the address is registered (see
// `handleLoginPost`/`requestLogin`), so this page has no branch that could
// leak membership.
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import AuthState from "../../components/AuthState.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { getAppDeps, getAuthDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { type LoginPostResult, handleLoginPost } from "../../server/pages/login.js";

let result: LoginPostResult | undefined;
let originError = false;

if (Astro.request.method === "POST") {
  const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    originError = true;
  } else {
    const formData = await Astro.request.formData();
    // Workers profile only: `Astro.locals.runtime.ctx.waitUntil` schedules
    // the login-link send after the response is already decided, so the
    // mailer's latency never reaches the request/response timing — see
    // `requestLogin`'s `deferMailSend` doc comment in `@bandplate/core`.
    // `undefined` under the Node adapter (no `locals.runtime`), which
    // makes `handleLoginPost` fall back to its unchanged inline-await
    // behavior there.
    const runtime = Astro.locals.runtime;
    result = await handleLoginPost(
      {
        auth: authDeps,
        rateLimiter: appDeps.rateLimiter,
        appOrigin: appDeps.config.appOrigin,
        trustedProxyDepth: appDeps.config.trustedProxyDepth,
        deferMailSend: runtime ? (send) => runtime.ctx.waitUntil(send()) : undefined,
      },
      formData,
      Astro.request.headers,
    );

    // POST/Redirect/GET. Without it the confirmation is rendered as the POST's
    // own response, so a reload re-submits the form — the browser's "resend?"
    // prompt — and every reload mints another login token and another email.
    //
    // The redirect target is the SAME for a registered and an unregistered
    // address, because `handleLoginPost` already returns "sent" for both: the
    // uniform response that keeps the members table from being an enumeration
    // oracle survives this change intact.
    if (result.kind === "sent") {
      return Astro.redirect("/login?sent=1", 303);
    }
    if (result.kind === "rate_limited") {
      return Astro.redirect(`/login?slow=${result.retryAfterSeconds}`, 303);
    }
    if (result.kind === "invalid") {
      return Astro.redirect("/login?invalid=1", 303);
    }
  }
}

// Read back from the query string, not from `result` — after the redirect
// above there is no POST result to read. Everything here is
// attacker-controllable (anyone can type `?slow=`), so nothing is echoed:
// `sent` and `invalid` are presence-only flags, and `slow` is parsed as an
// integer and clamped before it reaches the page.
const params = Astro.url.searchParams;
const showSent = params.has("sent");
const showInvalid = params.has("invalid");
const rawSlow = Number.parseInt(params.get("slow") ?? "", 10);
const slowSeconds = Number.isFinite(rawSlow) ? Math.min(Math.max(rawSlow, 1), 3600) : undefined;
---

<AuthLayout title="Sign in">
  {originError && (
    <Banner kind="error">Something about that request looked wrong. Reload the page and try again.</Banner>
  )}

  {/* The sent state REPLACES the form rather than sitting above it. The page
      has done the one thing it exists to do, and leaving the field there
      invites a second submission — which mints a second token and a second
      email — to answer a question the page has already answered. */}
  {showSent && (
    <AuthState tone="ok" title="Check your email">
      <svg slot="icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="M3 7.5l9 6 9-6" />
      </svg>
      {/* Deliberately non-committal: a page that confirms an address IS
          registered turns the members table into an enumeration oracle, which
          is exactly what `handleLoginPost`'s uniform response prevents. The
          copy must not give back what the server withholds. */}
      <p class="bp-auth-lede bp-m0">If that address is registered, a link is on its way.</p>
      <p class="bp-auth-note bp-m0">single-use &middot; 15 minutes</p>
      <a href="/login" class="bp-btn bp-btn-quiet bp-auth-action">Use a different address</a>
    </AuthState>
  )}

  {slowSeconds !== undefined && (
    <AuthState tone="alert" title="Give it a minute">
      <svg slot="icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12.5" r="8" />
        <path d="M12 8.5V13l3 1.8M9.5 3h5" />
      </svg>
      <p class="bp-auth-lede bp-m0">
        Too many sign-in requests from here. Try again in about <span class="bp-tabular">{slowSeconds}</span>
        {" "}seconds.
      </p>
      {/* No button, and no disabled one either: there is genuinely nothing to
          press, and a control that goes live on its own is a control people
          sit and watch. What this state actually provokes is "did the link I
          already asked for die too?", so that is what the line answers. */}
      <p class="bp-auth-note bp-m0">any link already sent still works</p>
    </AuthState>
  )}

  {!showSent && slowSeconds === undefined && (
    <>
      <h1 class="bp-auth-title">Sign in</h1>
      <p class="bp-auth-lede bp-m0">We'll email you a link — no password to remember.</p>
      <form method="post" class="bp-auth-form" novalidate>
        <Field
          label="Email address"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          error={showInvalid ? "Enter your email address." : undefined}
        />
        <button type="submit" class="bp-btn bp-btn-primary">Send me a link</button>
      </form>
      <p class="bp-auth-note bp-m0">single-use &middot; 15 minutes</p>
    </>
  )}
</AuthLayout>
