---
// `/me` — who you are, and what you've done.
//
// Direction M2 from the design canvas. Two things came off this page:
//
//   - FAVOURITES. Home is now a shelf of exactly these things, so listing them
//     again here was the same duplication we removed from home itself — and it
//     was listing them under Songs / Events / Takes, the taxonomy home rejected.
//   - SESSIONS. Raw user-agent strings and a status badge answered a question
//     no member of a five-piece band asks; signing out lives in the shell,
//     where it is reachable from every page. See `server/pages/me.ts` for the
//     one capability that trade gives up.
//
// What is left is the page's actual subject: the takes still waiting for your
// ear, and the calls you have already made. Identity is a line at the top, not
// a card — this is the one page where the app already knows who is looking.
import { LANGUAGE_NAMES, LOCALES, messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import InstrumentSet from "../../components/InstrumentSet.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { setLocaleCookie } from "../../server/cookies.js";
import { isSameOrigin } from "../../server/csrf.js";
import { formatShortDate } from "../../server/format.js";
import { VOTES_PER_PAGE, getMeData, setLocaleFromForm } from "../../server/pages/me.js";
import { pageRequest, pageView, paginationLabels } from "../../server/pagination.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const locale = Astro.locals.locale;
const t = messages(locale);

// `/me`'s first POST branch — the settled shape from
// `admin/members/index.astro`: same-origin check, `intent` dispatch, then
// PRG so a reload does not re-submit.
//
// The redirect is what makes the language actually change: the member row is
// written here, but the PAGE was already being rendered in the old language
// when the form was submitted, and `Astro.locals.locale` for THIS request was
// resolved before the write. Redirecting means the next request resolves the
// new value from the row, which is also what re-renders the persisted islands.
let localeError: string | undefined;
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    localeError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "locale") {
      const result = await setLocaleFromForm(appDeps.db, principal.memberId, formData);
      if (result.kind === "ok") {
        // The cookie too, not just the row: sign out and the login page has no
        // member to ask, and it must not revert to whatever the browser wants.
        setLocaleCookie(Astro.cookies, result.locale, {
          cookieSecure: appDeps.config.cookieSecure,
        });
        return Astro.redirect("/me?saved=1");
      }
      localeError = t.common.genericError;
    }
  }
}

const languageSaved = Astro.url.searchParams.get("saved") === "1";
const { page, args: votesPage } = pageRequest(Astro.url.searchParams, VOTES_PER_PAGE);
const data = await getMeData(appDeps.db, principal.memberId, votesPage);
if (!data) {
  return new Response("Not found.", { status: 404 });
}

const { member, instruments, votes, voteTotal, unvotedCount } = data;
const pages = pageView({ url: Astro.url, page, perPage: VOTES_PER_PAGE, total: voteTotal });
if (pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

// Initials for the identity disc — first letters of the first two words, which
// handles "František Voráč" and a single-word stage name alike.
const initials = member.displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join("");
---

<AppLayout title="Me" principal={principal} current="me">
  <div class="bp-me">
    <section class="bp-me-main">
      <h1 class="bp-me-heading">Your votes</h1>

      {languageSaved && <Banner kind="success">{t.me.languageSaved}</Banner>}
      {localeError && <Banner kind="error">{localeError}</Banner>}

      {/* The count home used to render as a queue of six rows. Here it is a
          number you went looking for rather than one pushed at you, and its
          link lands on the archive ALREADY FILTERED to exactly these takes —
          `?unvoted=1` is the same question the number asks, so the member does
          not have to reconstruct it from a filter panel. */}
      {
        unvotedCount > 0 ? (
          <div class="bp-me-unvoted">
            <p class="bp-me-unvoted-line bp-m0">
              <span class="bp-me-unvoted-count">{unvotedCount}</span>
              <span>
                {unvotedCount === 1 ? "take is" : "takes are"} still waiting for your ear.
              </span>
            </p>
            {/* A button, like every other "go do the thing" in the app — the
                same quiet pill home's "All events" and this page's admin link
                use. It was an inline link inside a sentence, which is the one
                shape a member does not read as an action. */}
            <a href="/takes?unvoted=1" class="bp-btn bp-btn-quiet bp-btn-sm">
              {unvotedCount === 1 ? "Hear it" : "Hear them"}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h13" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        ) : (
          <p class="bp-me-unvoted-line bp-me-unvoted bp-m0">
            <span>You've had your say on every published take.</span>
          </p>
        )
      }

      {
        votes.length === 0 ? (
          <div class="bp-empty-state">
            <p>
              Nothing yet. Open a take and the keeper / not-a-keeper choice is right under the
              player.
            </p>
          </div>
        ) : (
          <ul class="bp-vote-list">
            {votes.map(({ vote, take }) => (
              <li class="bp-vote-row">
                <div class="bp-vote-row-main">
                  {/* A plain `transition:name`, no claim-and-retarget dance:
                      votes are one per take per member, so a take cannot appear
                      twice in this list and the duplicate-name problem that
                      machinery existed for cannot arise here. */}
                  {take ? (
                    <a
                      href={`/takes/${take.id}`}
                      class="bp-vote-row-song"
                      transition:name={`take-${take.id}`}
                      data-take-id={take.id}
                    >
                      {take.song?.title ?? "Untitled take"}
                    </a>
                  ) : (
                    <span class="bp-vote-row-song bp-vote-row-song--gone">
                      A take that's since been removed
                    </span>
                  )}
                  <p class="bp-vote-row-meta bp-m0">
                    {take?.event && <span>{formatShortDate(take.recordedAt)}</span>}
                    {vote.comment && <span class="bp-vote-row-comment">{vote.comment}</span>}
                  </p>
                </div>
                {/* The call, not a control. This is a record of what you decided,
                    and changing your mind happens on the take's own page where
                    you can hear it again first — a toggle here would let you
                    flip a verdict on a recording you are not listening to. */}
                <span class={`bp-badge ${vote.keeper ? "bp-badge-keeper" : ""}`}>
                  {vote.keeper ? "keeper" : "not a keeper"}
                </span>
              </li>
            ))}
          </ul>
        )
      }

      <Pagination {...pages} labels={paginationLabels(pages, "vote")} />
    </section>

    <aside class="bp-me-aside">
      <div class="bp-me-identity">
        <span class="bp-me-avatar" aria-hidden="true">{initials}</span>
        <div class="bp-me-identity-text">
          <p class="bp-me-name bp-m0">{member.displayName}</p>
          <p class="bp-me-contact bp-m0">
            <span>{member.email}</span>
            {member.role === "admin" && <span class="bp-kind">Admin</span>}
          </p>
        </div>
      </div>

      {
        instruments.length > 0 && (
          <p class="bp-me-instruments bp-m0">
            <InstrumentSet instruments={instruments} verb="plays" />
          </p>
        )
      }

      {/* The language picker.

          TWO SUBMIT BUTTONS, not a radio group and a Save. A radio group needs
          a second click on a button that says nothing about what it does; two
          buttons make the choice and the action the same gesture, which is one
          tap on a phone and works with no JS at all. The current one is
          `aria-pressed` and disabled — it is a statement, not an offer.

          Selection carries the tick as well as the accent fill, because this
          app's rule is that it never rests on colour alone.

          The language NAMES are autonyms — "English", "Čeština" — identical in
          both catalogs on purpose. Someone who picked Czech by accident has to
          be able to read their way back out. See `LANGUAGE_NAMES`.

          `data-astro-reload` is load-bearing, not caution: `<ClientRouter />`
          intercepts every same-origin form submission for its own soft
          navigation, and `Player`, `VoteFavorite` and `ConfirmDialog` are
          `transition:persist` — Astro MOVES those islands to the new page
          rather than remounting them, so their already-rendered text would
          stay in the old language. Forcing a real document load is the only
          fix, and its cost (playback stops) is stated on the control rather
          than discovered. */}
      <form
        method="post"
        class="bp-me-language"
        data-astro-reload
      >
        <input type="hidden" name="intent" value="locale" />
        <fieldset class="bp-sheet-field">
          <legend class="bp-eyebrow">{t.me.languageLegend}</legend>
          <div class="bp-filter-pills">
            {
              LOCALES.map((option) => {
                const name = LANGUAGE_NAMES[option];
                const current = option === locale;
                return current ? (
                  <span class="bp-filter-pill" aria-pressed="true" aria-label={t.me.languageCurrent(name)}>
                    <svg
                      class="bp-filter-pill-mark"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 12.5l5.5 5.5L20 6.5" />
                    </svg>
                    {name}
                  </span>
                ) : (
                  <button
                    type="submit"
                    name="locale"
                    value={option}
                    class="bp-filter-pill"
                    aria-pressed="false"
                    aria-label={t.me.languageSwitch(name)}
                  >
                    {name}
                  </button>
                );
              })
            }
          </div>
          <p class="bp-sheet-hint bp-m0">{t.me.languageHint}</p>
          <p class="bp-sheet-hint bp-m0">{t.me.languageStopsPlayback}</p>
        </fieldset>
      </form>

      {/* Signing out lives here, not in the shell. It was a button in the
          sidebar and another in the phone header — permanent chrome on every
          page for something a member does a handful of times a year, sitting
          where a mis-tap costs them their session. `/me` is the page about
          them, and this is the one destructive thing on it, so it takes the
          danger treatment and sits last.

          The "Go to admin" link that used to sit above it is gone: Admin is a
          nav item now, reachable from every page, so a second door to it on
          this one page was chrome that had to be maintained twice. */}
      <form method="post" action="/logout" class="bp-me-signout">
        <button type="submit" class="bp-btn bp-btn-danger bp-btn-sm">Sign out</button>
      </form>
    </aside>
  </div>
</AppLayout>
