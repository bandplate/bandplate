---
// The signed-in member's own page: name, instruments, sessions (sign out of
// THIS one — reusing the existing `POST /logout`, not a new endpoint),
// favorites, and votes so far. Replaces Task 5's placeholder.
//
// Instruments (Task 6 review round 1's data-model gap, now closed via the
// `memberInstruments` join table — see its schema comment): rendered as
// plain tags, same visual vocabulary `.bl-take-instrument-tag` already
// established for a take's instruments, INCLUDING archived ones (a member
// who plays an instrument the band has since dropped still sees it here —
// see `membersRepo.listInstrumentsForMember`).
//
// `transitionName`/`claimTakeTransition`: see F1 in the review — a take
// that's BOTH a favorite and voted-on would otherwise get the same
// `view-transition-name` twice on this one page (favorites' TakeRow AND
// the votes list's own link), which aborts the page's view transition
// entirely per the CSS View Transitions spec. Only the first occurrence of
// a given take id keeps the name; later ones simply don't get one (the
// link/row still works, it just isn't the View Transitions morph target).
import TakeRow from "../../components/TakeRow.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { SESSION_COOKIE_NAME } from "../../server/cookies.js";
import { formatTimestamp } from "../../server/format.js";
import { getMeData } from "../../server/pages/me.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const cookieValue = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const data = await getMeData(appDeps.db, principal.memberId, cookieValue);
if (!data) {
  return new Response("Not found.", { status: 404 });
}

const { member, instruments, sessions, favorites, votes } = data;
const now = appDeps.clock.now();

function sessionStatus(session: (typeof sessions)[number]): "active" | "revoked" | "expired" {
  if (session.revokedAt !== null) {
    return "revoked";
  }
  if (session.expiresAt <= now) {
    return "expired";
  }
  return "active";
}

const hasFavorites = favorites.songs.length > 0 || favorites.takes.length > 0;

const usedTakeTransitionIds = new Set<string>();
/** First call for a given take id gets the real name; every later call on
 *  this same page render gets `null` (no `transition:name` at all) — see
 *  this file's header comment (F1). */
function claimTakeTransition(takeId: string): string | null {
  if (usedTakeTransitionIds.has(takeId)) {
    return null;
  }
  usedTakeTransitionIds.add(takeId);
  return `take-${takeId}`;
}
---

<AppLayout title="Me" principal={principal} current="me">
  <div class="bl-stack">
    <h1 class="bl-page-title">Me</h1>

    <section class="bl-card">
      <h2 class="bl-section-title bl-m0">{member.displayName}</h2>
      <p class="bl-field-hint bl-m0">
        {member.email}
        <span class={`bl-badge ${member.role === "admin" ? "bl-badge-admin" : ""}`}>
          {member.role}
        </span>
      </p>
      {instruments.length > 0 && (
        <div class="bl-take-instruments">
          {instruments.map((instrument) => (
            <span class="bl-take-instrument-tag">
              {instrument.label}
              {instrument.archivedAt !== null && " (archived)"}
            </span>
          ))}
        </div>
      )}
      {member.role === "admin" && (
        <p>
          <a href="/admin" class="bl-btn bl-btn-secondary bl-btn-sm">
            Go to admin
          </a>
        </p>
      )}
    </section>

    <section>
      <h2 class="bl-section-title">Sessions</h2>
      <ul class="bl-session-list">
        {
          sessions.map((session) => {
            const status = sessionStatus(session);
            return (
              <li class="bl-session-row">
                <div class="bl-session-row-main">
                  <p class="bl-mono bl-session-row-agent bl-m0">
                    {session.userAgent ?? "Unknown device"}
                  </p>
                  <p class="bl-field-hint bl-m0">
                    Signed in {formatTimestamp(session.createdAt)} — last active{" "}
                    {formatTimestamp(session.lastSeenAt)}
                    {session.isCurrent && " — this device"}
                  </p>
                  <span class={`bl-badge ${status === "active" ? "bl-badge-active" : ""}`}>
                    {status}
                  </span>
                </div>
                {session.isCurrent && (
                  <form method="post" action="/logout" class="bl-session-row-action">
                    <button type="submit" class="bl-btn bl-btn-secondary bl-btn-sm">
                      Sign out
                    </button>
                  </form>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2 class="bl-section-title">Favorites</h2>
      {
        !hasFavorites ? (
          <div class="bl-empty-state">
            <p>
              Nothing pinned yet — favoriting is coming soon. In the meantime,{" "}
              <a href="/search">browse the archive</a>.
            </p>
          </div>
        ) : (
          <div class="bl-stack bl-stack-tight">
            {favorites.songs.length > 0 && (
              <div class="bl-song-list">
                {favorites.songs.map((song) => (
                  <a href={`/songs/${song.slug}`} class="bl-song-row">
                    <div class="bl-song-row-main">
                      <p class="bl-song-title bl-m0">{song.title}</p>
                    </div>
                  </a>
                ))}
              </div>
            )}
            {favorites.takes.length > 0 && (
              <div class="bl-take-list bl-take-list--wide">
                {favorites.takes.map((take) => (
                  <TakeRow
                    take={take}
                    instruments={take.instruments}
                    context={{ kind: "full", song: take.song, event: take.event }}
                    transitionName={claimTakeTransition(take.id)}
                  />
                ))}
              </div>
            )}
          </div>
        )
      }
    </section>

    <section>
      <h2 class="bl-section-title">Votes so far</h2>
      {
        votes.length === 0 ? (
          <div class="bl-empty-state">
            <p>You haven't voted on anything yet — check "Needs your vote" on the home page.</p>
          </div>
        ) : (
          <ul class="bl-vote-list">
            {votes.map(({ vote, take, favorited }) => (
              <li class="bl-vote-row">
                <div class="bl-vote-row-main">
                  {take ? (
                    <a
                      href={`/takes/${take.id}`}
                      class="bl-vote-row-song"
                      transition:name={claimTakeTransition(take.id) ?? undefined}
                    >
                      {take.song?.title ?? "Untitled take"}
                      {favorited && (
                        <span class="bl-favorite-mark" title="Also one of your favorites">
                          <svg
                            aria-hidden="true"
                            width="14"
                            height="14"
                            viewBox="0 0 16 16"
                            fill="currentColor"
                          >
                            <path d="M8 0.8l2.1 4.5 4.9.7-3.6 3.5.9 4.9L8 12.2l-4.3 2.2.9-4.9-3.6-3.5 4.9-.7z" />
                          </svg>
                          <span class="sr-only">, also a favorite</span>
                        </span>
                      )}
                    </a>
                  ) : (
                    <span class="bl-vote-row-song">A take that's since been removed</span>
                  )}
                  {vote.comment && <p class="bl-field-hint bl-m0">&ldquo;{vote.comment}&rdquo;</p>}
                </div>
                <span class={`bl-badge ${vote.keeper ? "bl-badge-keeper" : ""}`}>
                  {vote.keeper ? "keeper" : "not a keeper"}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AppLayout>
