---
// The signed-in member's own page: name, instruments, sessions (sign out of
// THIS one — reusing the existing `POST /logout`, not a new endpoint),
// favorites, and votes so far. Replaces Task 5's placeholder.
//
// Instruments (Task 6 review round 1's data-model gap, now closed via the
// `memberInstruments` join table — see its schema comment): rendered as
// plain tags, same visual vocabulary `.bp-take-instrument-tag` already
// established for a take's instruments, INCLUDING archived ones (a member
// who plays an instrument the band has since dropped still sees it here —
// see `membersRepo.listInstrumentsForMember`).
//
// `transitionName`/`claimTakeTransition`: see F1 in the review — a take
// that's BOTH a favorite and voted-on would otherwise get the same
// `view-transition-name` twice on this one page (favorites' TakeRow AND
// the votes list's own link), which aborts the page's view transition
// entirely per the CSS View Transitions spec. Only the first occurrence of
// a given take id keeps the name; later ones simply don't get one (the
// link/row still works, it just isn't the View Transitions morph target).
//
// `<TakeTransitionRetarget />` (Fix round 3): JS-progressive-enhancement
// that moves the claimed name onto whichever occurrence the member
// actually clicks, so the transition morphs from the right place on
// screen. See that component's own header comment.
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import PlayToggleButton from "../../components/PlayToggleButton.astro";
import TakeRow from "../../components/TakeRow.astro";
import TakeTransitionRetarget from "../../components/TakeTransitionRetarget.astro";
import VoteToggle from "../../components/VoteToggle.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { SESSION_COOKIE_NAME } from "../../server/cookies.js";
import { eventLabel, formatLongDate, formatTimestamp } from "../../server/format.js";
import { getMeData } from "../../server/pages/me.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const cookieValue = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const data = await getMeData(appDeps.db, principal.memberId, cookieValue);
if (!data) {
  return new Response("Not found.", { status: 404 });
}

const { member, instruments, sessions, favorites, votes } = data;
const now = appDeps.clock.now();

function sessionStatus(session: (typeof sessions)[number]): "active" | "revoked" | "expired" {
  if (session.revokedAt !== null) {
    return "revoked";
  }
  if (session.expiresAt <= now) {
    return "expired";
  }
  return "active";
}

const hasFavorites =
  favorites.songs.length > 0 || favorites.takes.length > 0 || favorites.events.length > 0;
const favoriteKindCount = [
  favorites.songs.length > 0,
  favorites.events.length > 0,
  favorites.takes.length > 0,
].filter(Boolean).length;

const usedTakeTransitionIds = new Set<string>();
/** First call for a given take id gets the real name; every later call on
 *  this same page render gets `null` (no `transition:name` at all) — see
 *  this file's header comment (F1). */
function claimTakeTransition(takeId: string): string | null {
  if (usedTakeTransitionIds.has(takeId)) {
    return null;
  }
  usedTakeTransitionIds.add(takeId);
  return `take-${takeId}`;
}
---

<AppLayout title="Me" principal={principal} current="me">
  <TakeTransitionRetarget />
  <div class="bp-stack">
    <h1 class="bp-page-title">Me</h1>

    <section class="bp-card">
      <h2 class="bp-section-title bp-m0">{member.displayName}</h2>
      <p class="bp-field-hint bp-m0">
        {member.email}
        <span class={`bp-badge ${member.role === "admin" ? "bp-badge-admin" : ""}`}>
          {member.role}
        </span>
      </p>
      {instruments.length > 0 && (
        <div class="bp-take-instruments">
          {instruments.map((instrument) => (
            <span class="bp-take-instrument-tag">
              {instrument.label}
              {instrument.archivedAt !== null && " (archived)"}
            </span>
          ))}
        </div>
      )}
      {member.role === "admin" && (
        <p>
          <a href="/admin" class="bp-btn bp-btn-secondary bp-btn-sm">
            Go to admin
          </a>
        </p>
      )}
    </section>

    <section>
      <h2 class="bp-section-title">Sessions</h2>
      <ul class="bp-session-list">
        {
          sessions.map((session) => {
            const status = sessionStatus(session);
            return (
              <li class="bp-session-row">
                <div class="bp-session-row-main">
                  <p class="bp-mono bp-session-row-agent bp-m0">
                    {session.userAgent ?? "Unknown device"}
                  </p>
                  <p class="bp-field-hint bp-m0">
                    Signed in {formatTimestamp(session.createdAt)} — last active{" "}
                    {formatTimestamp(session.lastSeenAt)}
                    {session.isCurrent && " — this device"}
                  </p>
                  <span class={`bp-badge ${status === "active" ? "bp-badge-active" : ""}`}>
                    {status}
                  </span>
                </div>
                {session.isCurrent && (
                  <form method="post" action="/logout" class="bp-session-row-action">
                    <button type="submit" class="bp-btn bp-btn-secondary bp-btn-sm">
                      Sign out
                    </button>
                  </form>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2 class="bp-section-title">Favorites</h2>
      {
        !hasFavorites ? (
          <div class="bp-empty-state">
            <p>
              Nothing pinned yet — tap the star on a song, take, or event to pin it here.{" "}
              <a href="/search">Browse the archive</a>.
            </p>
          </div>
        ) : (
          <div class="bp-stack bp-stack-tight">
            {favorites.songs.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Songs</p>}
                <div class="bp-song-list">
                  {favorites.songs.map((song) => (
                    <div class="bp-song-row">
                      <a href={`/songs/${song.slug}`} class="bp-song-row-link">
                        <div class="bp-song-row-main">
                          <p class="bp-song-title bp-m0">{song.title}</p>
                        </div>
                      </a>
                      <FavoriteToggle
                        targetType="song"
                        targetId={song.id}
                        favorited={true}
                        label={song.title}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
            {favorites.events.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Events</p>}
                <div class="bp-event-list">
                  {favorites.events.map((event) => (
                    <div class={`bp-event-row bp-event-row--${event.kind}`}>
                      <a href={`/events/${event.id}`} class="bp-event-row-link">
                        <div class="bp-event-row-main">
                          <p class="bp-event-row-date bp-m0">{formatLongDate(event.heldAt)}</p>
                          <p class="bp-event-row-venue bp-m0">
                            <span class={`bp-badge bp-badge-${event.kind}`}>{event.kind}</span>
                            {eventLabel(event) && ` ${eventLabel(event)}`}
                          </p>
                        </div>
                      </a>
                      <FavoriteToggle
                        targetType="event"
                        targetId={event.id}
                        favorited={true}
                        label={eventLabel(event) || `this ${event.kind}`}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
            {favorites.takes.length > 0 && (
              <div>
                {favoriteKindCount > 1 && <p class="bp-field-label bp-m0">Takes</p>}
                <div class="bp-take-list bp-take-list--wide">
                  {favorites.takes.map((take) => (
                    <TakeRow
                      take={take}
                      instruments={take.instruments}
                      context={{ kind: "full", song: take.song, event: take.event }}
                      transitionName={claimTakeTransition(take.id)}
                      favorited={true}
                      playableAssetId={take.playableAssetId}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        )
      }
    </section>

    <section>
      <h2 class="bp-section-title">Votes so far</h2>
      {
        votes.length === 0 ? (
          <div class="bp-empty-state">
            <p>You haven't voted on anything yet — check "Needs your vote" on the home page.</p>
          </div>
        ) : (
          <ul class="bp-vote-list">
            {votes.map(({ vote, take, favorited }) => (
              <li class="bp-vote-row">
                <div class="bp-vote-row-main">
                  {take?.playableAssetId && (
                    <PlayToggleButton
                      takeId={take.id}
                      assetId={take.playableAssetId}
                      title={take.song?.title ?? "Untitled take"}
                    />
                  )}
                  {take ? (
                    <>
                      <a
                        href={`/takes/${take.id}`}
                        class="bp-vote-row-song"
                        transition:name={claimTakeTransition(take.id) ?? undefined}
                        data-take-id={take.id}
                      >
                        {take.song?.title ?? "Untitled take"}
                      </a>
                      <FavoriteToggle
                        targetType="take"
                        targetId={take.id}
                        favorited={favorited}
                        label={take.song?.title ?? "this take"}
                      />
                    </>
                  ) : (
                    <span class="bp-vote-row-song">A take that's since been removed</span>
                  )}
                  {vote.comment && <p class="bp-field-hint bp-m0">&ldquo;{vote.comment}&rdquo;</p>}
                </div>
                {take && (
                  <VoteToggle
                    takeId={take.id}
                    keeperVotes={take.keeperVotes}
                    totalVotes={take.totalVotes}
                    ratingScore={take.ratingScore}
                  />
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AppLayout>
