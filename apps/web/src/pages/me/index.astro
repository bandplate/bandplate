---
// `/me` — the member's own profile.
//
// It used to be "your votes, plus whatever else had nowhere to live": a votes
// column beside an aside holding identity, instruments, the language setting
// and sign-out, in that order, with nothing saying where one ended and the
// next began. The aside was a junk drawer because it held everything that was
// not a vote.
//
// The page has a subject now, and the subject is YOU. It is built on the
// record plate the app already draws everywhere else (`.bp-plate` — grooves
// over vinyl, a gold centre label, a spindle): your initials go on the label,
// and what follows is what is pressed into it — the ledger of how you have
// voted, then the calls themselves.
//
// Four parts, one column, in this order:
//   HERO      the plate, your name, since when, what you play. Sign out sits
//             here rather than at the bottom of a rail — it is yours, it is
//             destructive, and it should be where you look for it.
//   LEDGER    four figures. `agreementPct` is the one worth having: it is
//             something the archive knows about you that you do not.
//   VOTES     the calls, with the comment you left, which was invisible before.
//   LANGUAGE  the one setting that lives here.
//
// Deliberately NOT here: favourites. Home is already the shelf of exactly
// those, and listing them twice is what this page was being cured of.
import {
  LANGUAGE_NAMES,
  LOCALES,
  formatLongDate,
  formatShortDate,
  messages,
} from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import InstrumentSet from "../../components/InstrumentSet.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { setLocaleCookie } from "../../server/cookies.js";
import { isSameOrigin } from "../../server/csrf.js";

import { VOTES_PER_PAGE, getMeData, setLocaleFromForm } from "../../server/pages/me.js";
import { pageRequest, pageView, paginationLabels } from "../../server/pagination.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const locale = Astro.locals.locale;
const t = messages(locale);

// `/me`'s first POST branch — the settled shape from
// `admin/members/index.astro`: same-origin check, `intent` dispatch, then
// PRG so a reload does not re-submit.
//
// The redirect is what makes the language actually change: the member row is
// written here, but the PAGE was already being rendered in the old language
// when the form was submitted, and `Astro.locals.locale` for THIS request was
// resolved before the write. Redirecting means the next request resolves the
// new value from the row, which is also what re-renders the persisted islands.
let localeError: string | undefined;
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    localeError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "locale") {
      const result = await setLocaleFromForm(appDeps.db, principal.memberId, formData);
      if (result.kind === "ok") {
        // The cookie too, not just the row: sign out and the login page has no
        // member to ask, and it must not revert to whatever the browser wants.
        setLocaleCookie(Astro.cookies, result.locale, {
          cookieSecure: appDeps.config.cookieSecure,
        });
        return Astro.redirect("/me?saved=1");
      }
      localeError = t.common.genericError;
    }
  }
}

const languageSaved = Astro.url.searchParams.get("saved") === "1";
const { page, args: votesPage } = pageRequest(Astro.url.searchParams, VOTES_PER_PAGE);
const data = await getMeData(appDeps.db, principal.memberId, votesPage);
if (!data) {
  return new Response("Not found.", { status: 404 });
}

const { member, instruments, votes, voteTotal, unvotedCount, keeperCount, agreementPct } = data;
const pages = pageView({ url: Astro.url, page, perPage: VOTES_PER_PAGE, total: voteTotal });
if (pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

// Initials for the identity disc — first letters of the first two words, which
// handles "František Voráč" and a single-word stage name alike.
const initials = member.displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join("");
---

<AppLayout title={t.me.title} principal={principal} current="me">
  <div class="bp-profile">

    {/* ── Hero ───────────────────────────────────────────────────────── */}
    <header class="bp-profile-hero">
      {/* The same plate the archive is drawn from, with you on the label.
          Decorative: the initials are already in the heading beside it. */}
      <span class="bp-profile-plate" aria-hidden="true">
        <span class="bp-profile-plate-label">{initials}</span>
        <span class="bp-profile-plate-spindle"></span>
      </span>

      <div class="bp-profile-identity">
        <p class="bp-eyebrow bp-m0">{t.me.memberSince(formatLongDate(locale, member.createdAt))}</p>
        <h1 class="bp-profile-name bp-m0">{member.displayName}</h1>
        <p class="bp-profile-contact bp-m0">
          <span>{member.email}</span>
          {member.role === "admin" && <span class="bp-kind">{t.me.admin}</span>}
        </p>
        {
          instruments.length > 0 ? (
            <p class="bp-profile-instruments bp-m0">
              <InstrumentSet instruments={instruments} verb="plays" />
            </p>
          ) : (
            /* One quiet line, not an empty chip rail pretending to be full. */
            <p class="bp-profile-noinstruments bp-m0">{t.me.noInstruments}</p>
          )
        }
      </div>

      {/* Sign out belongs to the person, so it lives on their own header —
          and it stays outline-only, because it is the one destructive thing
          on the page and must not compete with the plate for a thumb. */}
      <form method="post" action="/logout" class="bp-profile-signout">
        <button type="submit" class="bp-btn bp-btn-quiet bp-btn-sm">{t.me.signOut}</button>
      </form>
    </header>

    {languageSaved && <Banner kind="success">{t.me.languageSaved}</Banner>}
    {localeError && <Banner kind="error">{localeError}</Banner>}

    {/* ── Ledger ─────────────────────────────────────────────────────── */}
    <dl class="bp-profile-ledger">
      <div class="bp-profile-figure">
        <dd class="bp-profile-figure-value bp-m0">{voteTotal}</dd>
        <dt class="bp-eyebrow">{t.me.ledgerVotes(voteTotal)}</dt>
      </div>
      <div class="bp-profile-figure">
        <dd class="bp-profile-figure-value bp-m0">{keeperCount}</dd>
        <dt class="bp-eyebrow">{t.me.ledgerKeepers(keeperCount)}</dt>
      </div>
      <div class="bp-profile-figure">
        {/* A dash, not 0% — nothing this member voted on has been settled
            yet, and those are different facts. See `getMeData`. */}
        <dd class="bp-profile-figure-value bp-m0">
          {agreementPct === null ? (
            <span class="bp-profile-figure-none">{t.me.ledgerNoAnswer}</span>
          ) : (
            <>{agreementPct}<span class="bp-profile-figure-unit">%</span></>
          )}
        </dd>
        <dt class="bp-eyebrow">{t.me.ledgerAgreement}</dt>
      </div>
      <div class="bp-profile-figure">
        <dd class={`bp-profile-figure-value bp-m0 ${unvotedCount > 0 ? "bp-profile-figure-live" : ""}`}>
          {unvotedCount}
        </dd>
        <dt class="bp-profile-figure-term">
          <span class="bp-eyebrow">{t.me.ledgerWaiting}</span>
          {/* The only link in the row, and it lands on the archive ALREADY
              filtered to exactly these takes. */}
          {unvotedCount > 0 && (
            <a href="/takes?unvoted=1" class="bp-profile-figure-go">{t.me.hearThem(unvotedCount)} →</a>
          )}
        </dt>
      </div>
    </dl>

    {/* ── The calls ──────────────────────────────────────────────────── */}
    <section>
      <h2 class="bp-section-title bp-profile-section">{t.me.votesHeading}</h2>
      {
        votes.length === 0 ? (
          <div class="bp-empty-state">
            <p>{t.me.emptyVotes}</p>
          </div>
        ) : (
          <ul class="bp-vote-list">
            {votes.map(({ vote, take }) => (
              <li class="bp-vote-row">
                <div class="bp-vote-row-main">
                  {/* A plain `transition:name`, no claim-and-retarget dance:
                      votes are one per take per member, so a take cannot appear
                      twice in this list and the duplicate-name problem that
                      machinery existed for cannot arise here. */}
                  {take ? (
                    <a
                      href={`/takes/${take.id}`}
                      class="bp-vote-row-song"
                      transition:name={`take-${take.id}`}
                      data-take-id={take.id}
                    >
                      {take.song?.title ?? t.me.untitledTake}
                    </a>
                  ) : (
                    <span class="bp-vote-row-song bp-vote-row-song--gone">{t.me.takeRemoved}</span>
                  )}
                  {/* Your own words, which the old row threw away into a
                      metadata line beside the date. */}
                  {vote.comment && <p class="bp-vote-row-comment bp-m0">{vote.comment}</p>}
                </div>
                {/* Rendered only when there is a date: an empty span would
                    still claim its grid row and open a gap under the title. */}
                {take?.event && (
                  <span class="bp-vote-row-when bp-mono">
                    {formatShortDate(locale, take.recordedAt)}
                  </span>
                )}
                {/* The call, not a control. This is a record of what you
                    decided; changing your mind happens on the take's own page,
                    where you can hear it again first. */}
                <span class={`bp-badge ${vote.keeper ? "bp-badge-keeper" : ""}`}>
                  {vote.keeper ? t.me.verdictKeeper : t.me.verdictNotKeeper}
                </span>
              </li>
            ))}
          </ul>
        )
      }
      <Pagination {...pages} labels={paginationLabels(pages, "vote")} />
    </section>

    {/* ── Language ───────────────────────────────────────────────────── */}
    {/* A SELECT, not a row of pills. The list of languages grows, and a row of
        pills stops being a row at five of them.

        The submit button beside it is what keeps this working with no JS: a
        select's `change` is not a submission, and nothing else in this app has
        a JS-only path. The language switch is a poor place to start one.

        `data-astro-reload` is load-bearing, not caution — `<ClientRouter />`
        intercepts same-origin form posts, and `Player`, `VoteFavorite` and
        `ConfirmDialog` are `transition:persist`, so a soft navigation would
        MOVE them across with their old language still rendered. */}
    <section class="bp-profile-language">
      <h2 class="bp-section-title bp-profile-section">{t.me.languageLegend}</h2>
      <form method="post" class="bp-profile-language-form" data-astro-reload>
        <input type="hidden" name="intent" value="locale" />
        <label class="bp-visually-hidden" for="me-locale">{t.me.languageLegend}</label>
        <select class="bp-select bp-profile-language-select" id="me-locale" name="locale">
          {
            LOCALES.map((option) => (
              /* Autonyms — "English", "Čeština" — never translated. Somebody
                 who picked a language they cannot read has to be able to find
                 their way back out, and only a name in its own language does
                 that for them. */
              <option value={option} selected={option === locale}>{LANGUAGE_NAMES[option]}</option>
            ))
          }
        </select>
        <button type="submit" class="bp-btn bp-btn-quiet bp-btn-sm">{t.me.switchLanguage}</button>
      </form>
      <p class="bp-field-hint bp-m0">{t.me.languageHint} {t.me.languageStopsPlayback}</p>
    </section>

  </div>
</AppLayout>
