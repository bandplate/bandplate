---
// `/s/<code>`: a short share link (see `server/pages/share.ts`).
//
// Public in the member guard (`server/guard.ts`) because this page guards
// itself, three ways:
//
// - SIGNED IN: a 302 to the target's current page (`/songs/<slug>`, which
//   follows a rename, `/events/<id>`, `/takes/<id>`), or the app's ordinary
//   404 for a code that opens nothing.
// - SIGNED OUT, a PUBLIC link (a member turned it on): the take or the
//   event itself, to listen to, built from `server/pages/public-share.ts`'s
//   allow-list, under the same title-and-one-line preview card.
// - SIGNED OUT, a members' link that opens something: a tiny page a link
//   preview can read (WhatsApp, Messenger and Signal fetch it with no
//   session) carrying the target's title and one factual line, and nothing
//   else. A person is sent straight on to sign in with `?next=` set, so they
//   land back here and then on the page. A link turned back from public
//   lands here too.
// - SIGNED OUT, anything else (an unknown code, a deleted target, a private
//   take): the same 302 to `/login` every protected page gives a signed-out
//   request. Nothing about the code is revealed.
//
// The trade, accepted by the owner: whoever holds a code learns the title
// and that one line without signing in. Codes are 10 random base62
// characters (~59.5 bits), so they are found by being sent, not by guessing.
// Nothing rate-limits this route; the length is the whole defence.
import { messages } from "@bandplate/i18n";
import Play from "@lucide/astro/icons/play";
import PlayToggleButton from "../../components/PlayToggleButton.astro";
import ShareSignInCard from "../../components/ShareSignInCard.astro";
import TakeFactsCard from "../../components/TakeFactsCard.astro";
import TakeRow from "../../components/TakeRow.astro";
import PublicShareLayout from "../../layouts/PublicShareLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { loadPublicView } from "../../server/pages/public-share.js";
import { resolveShareCode } from "../../server/pages/share.js";
import { loginPathReturningTo } from "../../server/safe-redirect.js";

const { code } = Astro.params;
const locale = Astro.locals.locale;
const appDeps = await getAppDeps();
const resolved = await resolveShareCode(appDeps.db, code, locale);

if (Astro.locals.principal) {
  if (!resolved) {
    return new Response("Not found.", { status: 404 });
  }
  return Astro.redirect(resolved.path);
}

if (!resolved) {
  return Astro.redirect("/login");
}

Astro.response.headers.set("Cache-Control", "no-store");

const view = code ? await loadPublicView(appDeps.db, code, resolved, locale) : undefined;
const hasPlayable = view?.kind === "event" && view.takes.some((row) => row.playableAssetId);

const t = messages(locale);
const selfPath = `/s/${code}`;
const loginPath = loginPathReturningTo(selfPath);
const pageUrl = new URL(selfPath, Astro.url);
const imageUrl = new URL("/og-image.png", Astro.url);
const { title, description } = resolved.preview;
---

{
  view?.kind === "take" && (
    <PublicShareLayout
      title={view.title}
      description={view.preview.description}
      code={view.code}
      footer={t.auth.publicTakeFooter}
    >
      <div class="bp-take-detail-hero">
        {view.kindLabel && <span class="bp-kind">{view.kindLabel}</span>}
        <h1 class="bp-hero-title bp-m0">{view.title}</h1>
        {view.note && <p class="bp-hero-label bp-m0">{view.note}</p>}
      </div>
      {view.play && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">{t.takes.listenHeading}</h2>
          <div class="bp-take-play-section">
            <PlayToggleButton {...view.play} label={t.takes.playThisTake} />
          </div>
        </section>
      )}
      <div class="bp-take-facts-card">
        <TakeFactsCard {...view.facts} />
      </div>
    </PublicShareLayout>
  )
}
{
  view?.kind === "event" && (
    <PublicShareLayout
      title={view.title}
      description={view.preview.description}
      code={view.code}
      footer={t.auth.publicEventFooter}
    >
      <header class="bp-event-hero">
        <div class="bp-event-hero-line">
          <span class="bp-kind">{view.kindLabel}</span>
        </div>
        <h1 class="bp-hero-title bp-m0">{view.title}</h1>
        <p class="bp-public-summary bp-m0">{view.summary}</p>
        {hasPlayable && (
          <div class="bp-event-hero-actions">
            <button
              type="button"
              class="bp-btn bp-btn-secondary bp-btn-sm bp-btn-play-all"
              data-play-queue-start="event-takes"
            >
              <span class="bp-btn-play-disc" aria-hidden="true">
                <Play size={13} fill="currentColor" />
              </span>
              {t.events.playAll}
            </button>
          </div>
        )}
      </header>
      <section class="bp-take-strip">
        <h2 class="bp-strip-label">{t.events.takesHeading}</h2>
        <div class="bp-take-list bp-take-list--wide" id="event-takes" data-play-queue>
          {view.takes.map((row) => (
            <TakeRow
              take={row.take}
              instruments={row.instruments}
              context={{ kind: "event", song: row.song, eventKind: view.eventKind }}
              playableAssetId={row.playableAssetId}
              readOnly
            />
          ))}
        </div>
      </section>
    </PublicShareLayout>
  )
}
{
  !view && (
    <ShareSignInCard
      title={title}
      description={description}
      pageUrl={pageUrl.href}
      imageUrl={imageUrl.href}
      loginPath={loginPath}
    />
  )
}
