---
// Bootstraps the first admin. 404s once any member exists (same rule as
// the JSON API's `GET /setup`) so this page can't be used to re-run setup
// on a live deployment. On success the mail self-test result is rendered
// directly here (not after a redirect) — a broken mailer needs to be
// discovered by the operator running setup, not by the first member who
// can't get a login link.
import { messages, validationMessage } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import AuthLayout from "../layouts/AuthLayout.astro";
import { getAppDeps, getAuthDeps } from "../server/app.js";
import { setSessionCookie } from "../server/cookies.js";
import { isSameOrigin } from "../server/csrf.js";
import {
  type BootstrapPostResult,
  handleSetupPost,
  isBootstrapAvailable,
} from "../server/pages/setup.js";

const [appDeps, authDeps] = await Promise.all([getAppDeps(), getAuthDeps()]);

if (!(await isBootstrapAvailable(appDeps.db))) {
  return new Response("Not found.", { status: 404 });
}

let result: BootstrapPostResult | undefined;
let originError = false;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    originError = true;
  } else {
    const formData = await Astro.request.formData();
    result = await handleSetupPost(authDeps, formData, Astro.locals.locale);
    if (result.kind === "ok") {
      setSessionCookie(Astro.cookies, result.sessionToken, {
        cookieSecure: appDeps.config.cookieSecure,
      });
    }
  }
}

const fieldErrors = result?.kind === "invalid" ? result.errors : {};

const locale = Astro.locals.locale;
const t = messages(locale);
---

<AuthLayout title={t.auth.setupTitle}>
  {originError && (
    <Banner kind="error">{t.common.originError}</Banner>
  )}

  {result?.kind === "ok" ? (
    <>
      <h1 class="bp-auth-title">{t.auth.setupOkHeading}</h1>
      <p class="bp-auth-lede bp-m0">{t.auth.setupOkLede}</p>
      {/* The mail self-test stays a Banner: unlike the auth outcomes, this is
          a notice ABOUT something else on the page — the setup that already
          succeeded — and its failure case needs room for a paragraph of
          operator instructions that would swamp a state screen. */}
      {result.testEmailSent ? (
        <Banner kind="success" title={t.auth.setupMailOkTitle}>{t.auth.setupMailOkBody}</Banner>
      ) : (
        /* Whole clauses, assembled here rather than one paragraph with the
           command buried mid-sentence: no translation can reorder around an
           inline `<code>`, and Czech wants it somewhere English does not. */
        <Banner kind="error" title={t.auth.setupMailFailTitle}>
          {t.auth.setupMailFailLede} {t.auth.setupMailFailWhere}{" "}
          {t.auth.setupMailFailWorkers} <code class="bp-mono">wrangler tail</code>.{" "}
          {t.auth.setupMailFailContainer} {t.auth.setupMailFailCommon}
        </Banner>
      )}
      <a href="/admin" class="bp-btn bp-btn-primary bp-auth-action">{t.auth.setupGoToAdmin}</a>
    </>
  ) : (
    <>
      <h1 class="bp-auth-title">{t.auth.setupHeading}</h1>
      <p class="bp-auth-lede bp-m0">{t.auth.setupLede}</p>
      {result?.kind === "bad_token" && (
        <Banner kind="error">{t.auth.setupBadToken}</Banner>
      )}
      {result?.kind === "already_bootstrapped" && (
        <Banner kind="error">{t.auth.setupAlreadyDone}</Banner>
      )}
      <form method="post" class="bp-auth-form" novalidate>
        <Field
          label={t.auth.setupTokenLabel}
          name="bootstrapToken"
          type="password"
          required
          autocomplete="off"
          error={fieldErrors.bootstrapToken ? validationMessage(locale, fieldErrors.bootstrapToken) : undefined}
        />
        <Field
          label={t.auth.setupNameLabel}
          name="displayName"
          required
          autocomplete="name"
          error={fieldErrors.displayName ? validationMessage(locale, fieldErrors.displayName) : undefined}
        />
        <Field
          label={t.auth.setupEmailLabel}
          name="email"
          type="email"
          required
          autocomplete="email"
          error={fieldErrors.email ? validationMessage(locale, fieldErrors.email) : undefined}
        />
        <button type="submit" class="bp-btn bp-btn-primary">{t.auth.setupSubmit}</button>
      </form>
    </>
  )}
</AuthLayout>
