---
import { hasAllScopes } from "@bandplate/core";
import { assetsRepo, eventsRepo, instrumentsRepo } from "@bandplate/db";
// The song page. Its metadata, chord progression, lyrics, per-instrument
// notes, known aliases, and every take newest first (each linking to its
// event) — see TakeRow.astro for why that link is separate from the take's
// own link to `/takes/[id]`.
//
// Measured against seeded data before deciding: `getSongDetail` (song +
// aliases + instrument notes + up to 8 takes with their instruments and
// events, all batch-fetched) runs in ~0.5-1.3ms locally — nowhere near the
// ~150ms bar for a Server Island, so nothing on this page is deferred. See
// task-5-report.md for the full measurement.
import { messages, validationMessage } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import ChartEditor from "../../components/ChartEditor.tsx";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import TakeRow from "../../components/TakeRow.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { eventLabel, formatShortDate } from "../../server/format.js";
import {
  SONG_TAKES_PER_PAGE,
  type SongField,
  archiveSongConsequence,
  deleteSongConsequence,
  getSongDetail,
  updateSong,
} from "../../server/pages/songs.js";
import { type TakeField, createTake } from "../../server/pages/takes.js";
import { pageRequest, pageView, paginationLabels } from "../../server/pagination.js";
import { songToRows } from "../../server/song-chart-rows.js";
import { KNOWN_SECTION_WORDS, buildSongChart } from "../../server/song-text.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/songs");
}

const appDeps = await getAppDeps();

// The edit sheet posts here. On success we redirect to the song's own URL —
// which is UNCHANGED by a rename, since the slug never moves (see
// `songsRepo.update`).
const locale = Astro.locals.locale;
const t = messages(locale);

let editError: string | undefined;
let editErrorField: SongField | undefined;
let takeError: string | undefined;
let takeErrorField: TakeField | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "create-take") {
      const result = await createTake(appDeps.db, appDeps.clock.now(), formData);
      if (result.kind === "ok") {
        return Astro.redirect(`/takes/${result.take.id}?created=1`);
      }
      if (result.kind === "unknown_parent") {
        takeError = t.songs.takeGone;
        takeErrorField = result.field;
      } else {
        takeError = validationMessage(locale, result.error);
        takeErrorField = result.field;
      }
    } else if (formData.get("intent") === "update") {
      const id = String(formData.get("songId") ?? "");
      const result = await updateSong(
        appDeps.db,
        appDeps.clock.now(),
        principal.memberId,
        id,
        formData,
      );
      if (result.kind === "ok") {
        return Astro.redirect(`/songs/${slug}?saved=1`);
      }
      if (result.kind === "not_found") {
        formError = t.songs.gone;
      } else if (result.kind === "duplicate") {
        editError = `${result.existing.title} already has that title.`;
        editErrorField = "title";
      } else {
        editError = validationMessage(locale, result.error);
        editErrorField = result.field;
      }
    }
  }
}

const { page, args: takesPage } = pageRequest(Astro.url.searchParams, SONG_TAKES_PER_PAGE);
const detail = await getSongDetail(appDeps.db, slug, principal.memberId, takesPage);
if (!detail) {
  return new Response("Not found.", { status: 404 });
}

const { song, songFavorited, aliases, instrumentNotes, takes, takeTotal } = detail;
const pages = pageView({
  url: Astro.url,
  page,
  perPage: SONG_TAKES_PER_PAGE,
  total: takeTotal,
});
if (pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

/**
 * How many takes stand above the fold.
 *
 * Three, because a song's takes are near-identical rows — same title, same
 * event, differing only by date and duration — and a run of them pushed the
 * chords and lyrics, which is what the page is actually for, off the screen
 * entirely on a phone. Three is enough to show the shape of the list and that
 * the newest is on top.
 */
const TAKES_BEFORE_FOLD = 3;
const foldedTakes = takes.slice(TAKES_BEFORE_FOLD);
const metaParts = [song.musicalKey, song.tempoBpm ? t.songs.bpm(song.tempoBpm) : undefined].filter(
  Boolean,
);
// An interleaved chart (chords above their matching lyric section) when a
// recognized section label exists on either side, or the original raw
// two-block layout (chords, then lyrics, blank lines intact) when nothing
// is recognized — see the `SongChart` union in server/song-text.ts for why
// those are two different shapes rather than one that always tries to
// interleave.
// What this song IS in the archive: how much of it there is, in what key, at
// what tempo. Built from strings the page already renders, so the link
// preview cannot drift from what you see when you open it. `takeTotal`, not
// `takes.length` — the latter is one page of them.
const shareDescription = [t.takes.count(takeTotal), ...metaParts].join(" · ");

const chart = buildSongChart(song.chordProgression, song.lyrics);

// The edit sheet's rows, parsed server-side so the island has nothing to work
// out on mount — and so a song the parser cannot read as sections opens as
// text rather than being guessed at. See `songToRows`.
const rowsResult = songToRows(song.chordProgression, song.lyrics);
const chartRows = rowsResult.kind === "rows" ? rowsResult.rows : [];
const chartIsFreeform = rowsResult.kind === "freeform";

const canArchive = hasAllScopes(principal, ["members:admin"]);
const isArchived = song.archivedAt !== null;
const justCreated = Astro.url.searchParams.get("created") === "1";
const justSaved = Astro.url.searchParams.get("saved") === "1";

// What a permanent delete would take with it, counted for the confirm. Only
// for an admin — nobody else can reach the page it warns about.
//
// ONE aggregate query over every take of the song, not a walk of the takes on
// screen: those are a page now, and a tally of the visible fifteen would have
// understated what a delete destroys — the one number on a destructive confirm
// that must never read low.
const tally = canArchive
  ? await assetsRepo.tallyBySong(appDeps.db, song.id)
  : { files: 0, bytes: 0 };
const songFileCount = tally.files;
const songByteTotal = tally.bytes;

// The take sheet's pickers. Newest event first, which is nearly always the one
// being added to, so it is also the default.
const [allEvents, allInstruments] = await Promise.all([
  eventsRepo.listRecent(appDeps.db, { limit: 100 }),
  instrumentsRepo.list(appDeps.db),
]);
const defaultEvent = allEvents[0];
const takeDateValue = (() => {
  const d = new Date(defaultEvent ? defaultEvent.heldAt : Date.now());
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
})();

/** How an event reads in a picker: its name if it has one, else its date. */
function eventOptionLabel(event: eventsRepo.Event): string {
  const name = eventLabel({ title: event.title ?? null, venue: event.venue ?? null });
  return name ? `${name} — ${formatShortDate(event.heldAt)}` : formatShortDate(event.heldAt);
}
---

<AppLayout
  title={song.title}
  description={shareDescription}
  principal={principal}
  current="songs"
>
  <div class="bp-stack">
    {/* An archived song still renders at its own URL rather than 404ing —
        every take of it links here, and a working link that answers "not
        found" is worse than one that says why. */}
    {isArchived && (
      <Banner kind="info" title={t.songs.archivedBanner}>
        Out of the library and off the form when you add a take. Its takes are untouched and still
        play.
        {canArchive && (
          <a
            slot="action"
            href={`/admin/songs/${song.id}/archive?unarchive=1`}
            class="bp-btn bp-btn-secondary bp-btn-sm"
            data-confirm
            data-confirm-title={t.songs.unarchiveConfirmTitle(song.title)}
            data-confirm-body={t.songs.unarchiveConfirmBody}
            data-confirm-action={`/admin/songs/${song.id}/archive?unarchive=1`}
            data-confirm-cta={t.songs.unarchiveCta}
            data-confirm-tone="neutral"
          >
            {t.songs.putItBack}
          </a>
        )}
      </Banner>
    )}
    {justCreated && <Banner kind="success">{t.songs.created}</Banner>}
    {justSaved && <Banner kind="success">{t.songs.saved}</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    <div>
      <div class="bp-title-row">
      <h1 class="bp-hero-title">
        {song.title}
        <span class="bp-take-favorite-mark">
          <FavoriteToggle
            targetType="song"
            targetId={song.id}
            favorited={songFavorited}
            label={song.title}
            size="lg"
          />
        </span>
      </h1>
        <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm" data-sheet-open="edit-song">
          {t.songs.edit}
        </button>
      </div>
      {song.isStub && (
        <p class="bp-field-hint bp-m0">
          Added by the bridge from a take that named this title — nobody has confirmed the
          details yet.
        </p>
      )}
      {/* NOT `.bp-mono`. A key and a tempo are values this app formatted, not a
      string anyone transcribes — the mono face is reserved for pasted chord
      charts and machine strings (docs/design-foundation.md). Tabular figures
      are what a row of numbers actually needed. */}
      {metaParts.length > 0 && <p class="bp-song-hero-meta bp-m0">{metaParts.join(", ")}</p>}

    </div>


    <RecordSheet
      id="add-take"
      eyebrow={t.songs.addTakeEyebrow}
      title={t.songs.addTakeTitle}
      subtitle={t.songs.addTakeSubtitle}
    >
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="create-take" />
        <input type="hidden" name="songId" value={song.id} />
        <div class="bp-sheet-body">
          <div class="bp-sheet-field">
            <label class="bp-eyebrow" for="take-event-pick">{t.songs.eventPickLabel}</label>
            <select class="bp-select" id="take-event-pick" name="eventId">
              {allEvents.map((option) => (
                <option value={option.id}>{eventOptionLabel(option)}</option>
              ))}
            </select>
          </div>
          <Field
            label={t.songs.recordedLabel}
            name="recordedAt"
            type="date"
            required
            value={takeDateValue}
            error={takeErrorField === "recordedAt" ? takeError : undefined}
          />
          <Field
            label={t.songs.takeLabelLabel}
            name="label"
            hint={t.songs.takeLabelHint}
            error={takeErrorField === "label" ? takeError : undefined}
          />
          <fieldset class="bp-sheet-field">
            <legend class="bp-eyebrow">{t.takes.instrumentsHeading}</legend>
            <div class="bp-pills">
              {allInstruments.map((instrument) => (
                <label class="bp-pill-check">
                  <input type="checkbox" name="instrumentIds" value={instrument.id} />
                  <span class="bp-pill">{instrument.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="bp-sheet-hint bp-m0">
            This makes the take; the audio goes on afterwards. If the bridge is going to upload
            this session, let it create the takes instead.
          </p>
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">{t.songs.addTake}</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.songs.cancel}</button>
        </div>
      </form>
    </RecordSheet>

    <RecordSheet
      id="edit-song"
      eyebrow={t.songs.editEyebrow}
      title={song.title}
      subtitle={t.songs.editSubtitle}
    >
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="update" />
        <input type="hidden" name="songId" value={song.id} />
        <div class="bp-sheet-body">
          <Field
            label={t.songs.titleLabel}
            name="title"
            required
            value={song.title}
            autocomplete="off"
            hint={t.songs.slugHint}
            error={editErrorField === "title" ? editError : undefined}
          />
          <div class="bp-admin-add">
            <Field
              label={t.songs.keyLabel}
              name="musicalKey"
              value={song.musicalKey ?? ""}
              error={editErrorField === "musicalKey" ? editError : undefined}
            />
            <Field
              label={t.songs.tempoLabel}
              name="tempoBpm"
              type="number"
              inputmode="numeric"
              min="1"
              max="400"
              value={song.tempoBpm ? String(song.tempoBpm) : ""}
              error={editErrorField === "tempoBpm" ? editError : undefined}
            />
          </div>
          {/* Sections rather than two boxes with two contradictory formats —
              see `ChartEditor`. It renders the real `chordProgression` and
              `lyrics` textareas itself, so the form contract is unchanged and
              the no-JS path is the editor that exists today. */}
          <ChartEditor
            client:load
            locale={locale}
            initialRows={chartRows}
            freeform={chartIsFreeform}
            chordText={song.chordProgression ?? ""}
            lyricsText={song.lyrics ?? ""}
            vocabulary={[...KNOWN_SECTION_WORDS]}
          />
          <Field
            label={t.songs.notesLabel}
            name="notes"
            as="textarea"
            rows="4"
            value={song.notes ?? ""}
            hint={t.songs.notesHint}
            error={editErrorField === "notes" ? editError : undefined}
          />
          {/* One extras block: `.bp-sheet-extras` draws its own top rule, and
              two of them would draw two. Archiving comes first because it is
              what almost every "get this out of here" actually wants. */}
          {canArchive && (
            <div class="bp-sheet-extras">
              {!isArchived && (
                <a
                  href={`/admin/songs/${song.id}/archive`}
                  class="bp-sheet-danger"
                  data-confirm
                  data-confirm-title={t.songs.archiveConfirmTitle(song.title)}
                  data-confirm-body={archiveSongConsequence(takeTotal, locale)}
                  data-confirm-action={`/admin/songs/${song.id}/archive`}
                  data-confirm-cta={t.songs.archiveCta}
                >
                  {t.songs.archiveThis}
                </a>
              )}
              <a
                href={`/admin/songs/${song.id}/delete`}
                class="bp-sheet-danger"
                data-confirm
                data-confirm-title={t.songs.deleteConfirmTitle(song.title)}
                data-confirm-body={deleteSongConsequence(takeTotal, songFileCount, songByteTotal, locale)}
                data-confirm-action={`/admin/songs/${song.id}/delete`}
                data-confirm-cta={t.songs.deleteCta}
                data-confirm-redirect="/songs?song_deleted=1"
              >
                {t.songs.deleteForGood}
              </a>
            </div>
          )}
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">{t.songs.saveChanges}</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.songs.cancel}</button>
        </div>
      </form>
    </RecordSheet>

    {/* Two columns past `lg`: the chart at its own measure on the left, takes
    and the notes about them on the right. Below that they stack, and the ORDER
    changes — takes come before the chart on a phone, because a song is opened
    to hear it far more often than to read it. `order` on the grid children
    rather than two markup blocks: one DOM order, one source of truth, and the
    reading order for a screen reader follows the visual one at both sizes. */}
    <div class="bp-song-detail-grid">
      {/* NO view transition on the chart.
          `<ClientRouter />` cross-fades the page root by default, which is
          fine for a heading or a row and wrong here: a dense block of
          monospace chords fading through ANOTHER dense block of monospace
          chords is two songs' text overlaid and legible as neither, for the
          length of the fade, on the one part of the page you actually read.
          `animate="none"` gives it its own transition scope with no animation,
          so it swaps at once while the rest of the page still crossfades. */}
      <div class="bp-song-detail-chart" transition:animate="none">
        {chart.kind === "sections" && (
          <section>
            <h2 class="bp-section-title">{t.songs.chartHeading}</h2>
            <div class="bp-song-chart">
              {chart.sections.map((section) => (
                <div
                  class:list={[
                    "bp-song-chart-section",
                    // The chorus reads louder than the verses around it. Matched
                    // on the label the section parser already produced, in both
                    // languages the vocabulary covers — see server/song-text.ts.
                    /^(chorus|refr[ée]n)\b/i.test(section.label ?? "") &&
                      "bp-song-chart-section--chorus",
                  ]}
                >
                  {section.label && <p class="bp-song-chart-label">{section.label}</p>}
                  {section.chordLines.length > 0 && (
                    <pre class="bp-chords">{section.chordLines.join("\n")}</pre>
                  )}
                  {section.lyricLines.length > 0 && (
                    <pre class="bp-lyrics">{section.lyricLines.join("\n")}</pre>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        {chart.kind === "raw" && (
          <>
            {/* Nothing on this song was recognized as a section label (a
            language or convention SECTION_WORDS doesn't cover) — the
            interleaved chart above has nothing to pair by, and would
            otherwise drop blank lines and reorder chords after lyrics. Fall
            back to the original two-block layout: raw text, chords above
            lyrics, blank lines (stanza breaks) intact. */}
            {chart.chordText && (
              <section>
                <h2 class="bp-section-title">{t.songs.chordsHeading}</h2>
                <pre class="bp-chords">{chart.chordText}</pre>
              </section>
            )}
            {chart.lyricsText && (
              <section>
                <h2 class="bp-section-title">{t.songs.lyricsHeading}</h2>
                <pre class="bp-lyrics">{chart.lyricsText}</pre>
              </section>
            )}
          </>
        )}

        {/* Nothing written down yet — `buildSongChart` returns "none" when the
            song has neither chords nor lyrics. Past `lg` the chart is a whole
            column, so rendering nothing left a screen-high hole beside the
            takes and made the page look broken rather than empty. */}
        {chart.kind === "none" && (
          <section>
            <h2 class="bp-section-title">{t.songs.chartHeading}</h2>
            <div class="bp-empty-state">
              <p>{t.songs.chartEmpty}</p>
            </div>
          </section>
        )}
      </div>

      <div class="bp-song-detail-aside">
        <div class="bp-title-row">
          <h2 class="bp-section-title bp-m0">{t.songs.takesHeading}</h2>
          <button type="button" class="bp-btn bp-btn-secondary bp-btn-xs" data-sheet-open="add-take">
            {t.songs.addTake}
          </button>
        </div>
        {
          takes.length === 0 ? (
            <div class="bp-empty-state">
              <p>{t.songs.takesEmpty}</p>
            </div>
          ) : (
            <div class="bp-take-list" data-play-queue>
              {takes.slice(0, TAKES_BEFORE_FOLD).map((take) => (
                <TakeRow
                  take={take}
                  instruments={take.instruments}
                  context={{ kind: "song", event: take.event }}
                  playableAssetId={take.playableAssetId}
                  favorited={take.favorited}
                  ownerName={take.ownerName}
                />
              ))}
              {foldedTakes.length > 0 && (
                /* `<details>`, so the fold works with JS off — the whole song
                   page does, and a take list that needed an island to be
                   readable would be the first thing here that didn't.
                   `name` is deliberately absent: this is not an accordion,
                   nothing else closes when it opens. */
                <details class="bp-take-fold">
                  <summary class="bp-take-fold-toggle">
                    <span class="bp-take-fold-open">
                      Show {foldedTakes.length} more{" "}
                      {foldedTakes.length === 1 ? "take" : "takes"}
                    </span>
                    <span class="bp-take-fold-close">{t.songs.showFewer}</span>
                  </summary>
                  <div class="bp-take-list">
                    {foldedTakes.map((take) => (
                      <TakeRow
                        take={take}
                        instruments={take.instruments}
                        context={{ kind: "song", event: take.event }}
                        playableAssetId={take.playableAssetId}
                        favorited={take.favorited}
                        ownerName={take.ownerName}
                      />
                    ))}
                  </div>
                </details>
              )}
              <Pagination {...pages} labels={paginationLabels(pages, "take")} />
            </div>
          )
        }

        {instrumentNotes.length > 0 && (
          <section class="bp-song-aside-section">
            <h2 class="bp-section-title bp-m0">{t.songs.instrumentNotesHeading}</h2>
            <div class="bp-stack bp-stack-tight">
              {instrumentNotes.map((note) => (
                <div>
                  <p class="bp-field-label bp-m0">{note.instrumentLabel}</p>
                  <p class="bp-m0">{note.body}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {song.notes && (
          <section class="bp-song-aside-section">
            <h2 class="bp-section-title bp-m0">{t.songs.generalNotesHeading}</h2>
            <p class="bp-m0">{song.notes}</p>
          </section>
        )}

        {aliases.length > 0 && (
          <section class="bp-song-aside-section">
            <h2 class="bp-section-title bp-m0">{t.songs.aliasesHeading}</h2>
            <ul class="bp-stack bp-stack-tight list-none">
              {aliases.map((alias) => (
                <li class={alias.source === "ingest" ? "bp-mono" : ""}>{alias.aliasNorm}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </div>
</AppLayout>
