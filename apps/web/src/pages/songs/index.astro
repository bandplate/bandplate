---
// The song library. Search, sort, and an instrument filter — all a single
// plain GET form, so every one of these works with JS off: submitting
// reloads this same page with the query string set, and the server does
// the actual filtering (`listSongsForLibrary` -> `songsRepo.listWithStats`).
// There is nothing here for JS to progressively enhance without shipping a
// script this page doesn't otherwise need — see task-5-report.md's
// "instrument filter" section for why that trade was made deliberately.
import { favoritesRepo, instrumentsRepo } from "@bandplate/db";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { formatShortDate } from "../../server/format.js";
import { listSongsForLibrary, parseSongsListQuery } from "../../server/pages/songs.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const query = parseSongsListQuery(Astro.url.searchParams);

const [songs, instruments, favoriteSongIds] = await Promise.all([
  listSongsForLibrary(appDeps.db, query),
  instrumentsRepo.list(appDeps.db),
  favoritesRepo.listTargetIdsByMember(appDeps.db, principal.memberId, "song"),
]);

const sort = query.sort ?? "title";
const resultsLabel =
  query.search || query.instrumentIds.length > 0
    ? `${songs.length} ${songs.length === 1 ? "song matches" : "songs match"}`
    : `${songs.length} ${songs.length === 1 ? "song" : "songs"}`;
---

<AppLayout title="Songs" principal={principal} current="songs">
  <div class="bp-stack">
    <h1 class="bp-page-title">Songs</h1>

    <form method="get" class="bp-toolbar">
      <div class="bp-field">
        <label class="bp-field-label" for="song-search">Search titles</label>
        <input
          class="bp-input"
          type="search"
          id="song-search"
          name="q"
          value={query.search ?? ""}
          placeholder="e.g. Neon Skyline"
        />
      </div>

      <div class="bp-field">
        <label class="bp-field-label" for="song-sort">Sort by</label>
        <select class="bp-select" id="song-sort" name="sort">
          <option value="title" selected={sort === "title"}>Title (A to Z)</option>
          <option value="recent" selected={sort === "recent"}>Recently played</option>
          <option value="takes" selected={sort === "takes"}>Most takes</option>
        </select>
      </div>

      {
        /* Collapsed by default on phones — a real (JS-free) <details>
        disclosure, not a script-driven show/hide. On the stated primary
        device this is the tallest, hardest-to-scan control in the toolbar
        (up to a dozen 44px checkbox rows), and it was pushing the actual
        song list entirely below the fold. It stays open automatically when
        a filter is already applied, so an active filter is never hidden
        from view, and it's forced open past `lg` (see components.css),
        where there's room for it beside search/sort without burying
        anything. */
      }
      <details class="bp-toolbar-details" open={query.instrumentIds.length > 0}>
        <summary class="bp-toolbar-details-summary">
          Filter by instrument
          {query.instrumentIds.length > 0 && ` (${query.instrumentIds.length} selected)`}
        </summary>
        <fieldset class="bp-checkbox-group">
          <legend>
            Instruments
            {query.instrumentIds.length > 1 && (
              <span class="bp-field-hint">— must have a take with all of these</span>
            )}
          </legend>
          {
            instruments.map((instrument) => (
              <span class="bp-checkbox-item">
                <input
                  type="checkbox"
                  id={`instrument-${instrument.id}`}
                  name="instrument"
                  value={instrument.id}
                  checked={query.instrumentIds.includes(instrument.id)}
                />
                <label for={`instrument-${instrument.id}`}>{instrument.label}</label>
              </span>
            ))
          }
        </fieldset>
      </details>

      <div class="bp-toolbar-actions">
        <button type="submit" class="bp-btn bp-btn-primary">Apply filters</button>
        {(query.search || query.instrumentIds.length > 0 || sort !== "title") && (
          <a href="/songs" class="bp-btn bp-btn-secondary">
            Clear
          </a>
        )}
      </div>
    </form>

    <p class="bp-field-hint bp-m0">{resultsLabel}</p>

    {
      songs.length === 0 ? (
        <div class="bp-empty-state">
          <p>
            {query.search || query.instrumentIds.length > 0
              ? "No songs match that search — try clearing a filter."
              : "No songs yet — they'll show up here once takes start coming in."}
          </p>
        </div>
      ) : (
        <div class="bp-song-list">
          {songs.map((song) => (
            <div class="bp-song-row">
              <a href={`/songs/${song.slug}`} class="bp-song-row-link">
                <div class="bp-song-row-main">
                  <p class={`bp-song-title ${song.isStub ? "bp-song-title-stub" : ""}`}>
                    {song.title}
                  </p>
                  <p class="bp-song-meta">
                    {[song.musicalKey, song.tempoBpm ? `${song.tempoBpm} bpm` : undefined]
                      .filter(Boolean)
                      .join(", ") || "No key or tempo set"}
                  </p>
                </div>
                <div class="bp-song-row-stats">
                  <span>
                    <span class="bp-song-row-stat-value">{song.takeCount}</span>
                    {song.takeCount === 1 ? "take" : "takes"}
                  </span>
                  <span>
                    <span class="bp-song-row-stat-value">{formatShortDate(song.lastPlayedAt)}</span>
                    last played
                  </span>
                </div>
              </a>
              <FavoriteToggle
                targetType="song"
                targetId={song.id}
                favorited={favoriteSongIds.has(song.id)}
                label={song.title}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</AppLayout>
