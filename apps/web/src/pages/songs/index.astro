---
// The song library — a repertoire index, direction S1 from the canvas.
//
// A song row uses the take row's grammar, which is the argument for it: every
// row here leads to a page full of take rows, so the two should read alike.
// Title in the display face at row size, key and tempo in the small caps the
// kind labels use everywhere else, take count and last-played on the right.
// What it replaced carried the same facts as two "value + label" stat pairs in
// a vocabulary nothing else in the app used.
//
// Search and sort are the whole toolbar now: a field and three pills, no Apply,
// no Clear — the same treatment `/events` got, and for the same reason. The
// instrument filter is gone entirely (see `server/pages/songs.ts`).
import { hasAllScopes } from "@bandplate/core";
import { favoritesRepo } from "@bandplate/db";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { formatShortDate } from "../../server/format.js";
import {
  SONGS_PER_PAGE,
  type SongField,
  countArchivedSongs,
  createSong,
  listSongsForLibrary,
  parseSongsListQuery,
} from "../../server/pages/songs.js";
import { pageRequest, pageView } from "../../server/pagination.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();

// M8 — adding a song. The POST comes back to this same URL and re-renders on
// failure (which loses what was typed, the same trade the admin add forms
// already make) or redirects on success, so a reload never re-posts.
let createError: string | undefined;
let createErrorField: SongField | undefined;
let formError: string | undefined;
let duplicateSlug: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = "Something about that request looked wrong. Reload the page and try again.";
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "create") {
      const result = await createSong(appDeps.db, appDeps.clock.now(), formData);
      if (result.kind === "ok") {
        // Straight to the song rather than back to the list: you added it
        // because you have something to put in it.
        return Astro.redirect(`/songs/${result.song.slug}?created=1`);
      }
      if (result.kind === "duplicate") {
        createError = `${result.existing.title} is already in the library.`;
        createErrorField = "title";
        duplicateSlug = result.existing.slug;
      } else {
        createError = result.error;
        createErrorField = result.field;
      }
    }
  }
}

const query = parseSongsListQuery(Astro.url.searchParams);
const canArchive = hasAllScopes(principal, ["members:admin"]);

const { page, args: songsPage } = pageRequest(Astro.url.searchParams, SONGS_PER_PAGE);
const [songs, favoriteSongIds, archivedCount] = await Promise.all([
  listSongsForLibrary(appDeps.db, query, songsPage),
  favoritesRepo.listTargetIdsByMember(appDeps.db, principal.memberId, "song"),
  countArchivedSongs(appDeps.db),
]);
const pages = pageView({ url: Astro.url, page, perPage: SONGS_PER_PAGE, total: songs.total });
// A link to a page that has since fallen off the end lands on the last real
// one, filters intact, rather than on a blank library.
if (pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

const justArchived = Astro.url.searchParams.get("archived_ok") === "1";
const justUnarchived = Astro.url.searchParams.get("unarchived") === "1";
const justDeleted = Astro.url.searchParams.get("song_deleted") === "1";

const sort = query.sort ?? "title";
const viewingArchive = query.archived === true;
// Counted from the TOTAL, not from this page: "25 songs" under a library of
// 60 would be the page's length wearing the library's name.
const songCount = songs.total;
const noun = songCount === 1 ? "song" : "songs";
const resultsLabel = query.search
  ? `${songCount} ${songCount === 1 ? "song matches" : "songs match"}`
  : viewingArchive
    ? `${songCount} archived ${noun}`
    : `${songCount} ${noun}`;

const SORT_OPTIONS = [
  { value: "title", label: "A to Z" },
  { value: "recent", label: "Recently played" },
  { value: "takes", label: "Most takes" },
] as const;

/** A sort pill's href: this sort, keeping whatever search is in force. Plain
 *  links, so choosing one applies it with no Apply button and no JS. */
function sortHref(value: (typeof SORT_OPTIONS)[number]["value"]): string {
  const params = new URLSearchParams();
  if (query.search) {
    params.set("q", query.search);
  }
  // `title` is the default, so it needs no parameter — a clean URL for the
  // most common state.
  if (value !== "title") {
    params.set("sort", value);
  }
  if (viewingArchive) {
    params.set("archived", "1");
  }
  const qs = params.toString();
  return qs ? `/songs?${qs}` : "/songs";
}

/** The Archived pill toggles; it keeps the search but drops back to the
 *  default sort, since "recently played" means little in an archive. */
function archivedHref(): string {
  const params = new URLSearchParams();
  if (query.search) {
    params.set("q", query.search);
  }
  if (!viewingArchive) {
    params.set("archived", "1");
  }
  const qs = params.toString();
  return qs ? `/songs?${qs}` : "/songs";
}
---

<AppLayout title="Songs" principal={principal} current="songs">
  <div class="bp-stack">
    {/* Direction B from the canvas: the write affordance is a primary button
        in the title row, opening the record sheet the admin pages already
        use. It shortens to "Add" on a phone so the title keeps its room. */}
    <div class="bp-title-row">
      <h1 class="bp-page-title">Songs</h1>
      <button type="button" class="bp-btn bp-btn-primary" data-sheet-open="add-song">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Add song
      </button>
    </div>

    {justArchived && <Banner kind="success">Archived. It's out of the library; its takes are untouched.</Banner>}
    {justUnarchived && <Banner kind="success">Back in the library.</Banner>}
    {justDeleted && <Banner kind="success">Song deleted, along with its takes and their files.</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    <RecordSheet id="add-song" eyebrow="New song" title="Add a song" subtitle="A title is all you need — the rest can wait until someone knows it.">
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="create" />
        <div class="bp-sheet-body">
          <Field
            label="Title"
            name="title"
            required
            autocomplete="off"
            error={createErrorField === "title" ? createError : undefined}
          />
          {duplicateSlug && (
            <p class="bp-sheet-hint bp-m0">
              <a href={`/songs/${duplicateSlug}`}>Open it instead</a>
            </p>
          )}
          <div class="bp-admin-add">
            <Field
              label="Key"
              name="musicalKey"
              hint="However you say it — Am, F# dorian."
              error={createErrorField === "musicalKey" ? createError : undefined}
            />
            <Field
              label="Tempo"
              name="tempoBpm"
              type="number"
              inputmode="numeric"
              min="1"
              max="400"
              hint="Beats per minute."
              error={createErrorField === "tempoBpm" ? createError : undefined}
            />
          </div>
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">Add song</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>Cancel</button>
        </div>
      </form>
    </RecordSheet>

    {/* The search field keeps its own tiny form — a text input needs a submit
        to be usable with the keyboard, and Enter is that submit. The sort
        pills are links, so they need no form at all. */}
    {/* `transition:persist` keeps this exact element across the soft navigation
        the debounced submit triggers — without it the input is replaced on
        every keystroke's response and the member loses focus and caret
        position mid-word. Same mechanism the player bar uses to survive
        navigation. */}
    <form
      method="get"
      class="bp-songs-search"
      role="search"
      transition:persist="songs-search"
      data-songs-search
    >
      <label class="bp-visually-hidden" for="song-search">Search song titles</label>
      <span class="bp-songs-search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-4-4" />
        </svg>
      </span>
      <input
        class="bp-songs-search-input"
        type="search"
        id="song-search"
        name="q"
        value={query.search ?? ""}
        placeholder="Search titles"
      />
      {sort !== "title" && <input type="hidden" name="sort" value={sort} />}
      {/* Submits the form for anyone with no JS, and is the keyboard's Enter
          target for everyone else. Hidden, because with the debounce running
          there is nothing to press. */}
      <button type="submit" class="bp-visually-hidden">Search</button>
    </form>

    <div class="bp-filter-pills">
      {
        SORT_OPTIONS.map((option) => (
          <a
            href={sortHref(option.value)}
            class="bp-filter-pill"
            aria-pressed={sort === option.value ? "true" : "false"}
          >
            {option.label}
          </a>
        ))
      }
      {/* The archive's own way in. It shows archived songs INSTEAD of live
          ones — see `SongsListQuery.archived`. Hidden entirely when nothing
          is archived, so a band that never archives never sees it. */}
      {
        (archivedCount > 0 || viewingArchive) && (
          <a
            href={archivedHref()}
            class="bp-filter-pill bp-filter-pill--set-apart"
            aria-pressed={viewingArchive ? "true" : "false"}
          >
            Archived
          </a>
        )
      }
    </div>

    <p class="bp-field-hint bp-m0">{resultsLabel}</p>

    {
      songs.rows.length === 0 ? (
        <div class="bp-empty-state">
          <p>
            {query.search
              ? "No songs match that search."
              : viewingArchive
                ? "Nothing archived."
                : "No songs yet. Add one, or wait for the first takes to come in."}
          </p>
        </div>
      ) : (
        <div class="bp-song-list">
          {songs.rows.map((song) => (
            <div class="bp-song-row">
              <a href={`/songs/${song.slug}`} class="bp-song-row-link">
                <span class="bp-song-row-main">
                  <span class={`bp-song-title ${song.isStub ? "bp-song-title-stub" : ""}`}>
                    {song.title}
                  </span>
                  {/* NOT `.bp-kind`. That label uppercases, and a musical key
                      is case-significant: "Em" is E minor, "EM" is nothing.
                      Same size and colour, no transform and no extra tracking. */}
                  <span class="bp-song-row-meta">
                    {[song.musicalKey, song.tempoBpm ? `${song.tempoBpm} bpm` : undefined]
                      .filter(Boolean)
                      .join(" · ") || "No key or tempo"}
                  </span>
                </span>
                {/* Two numbers, in the note size the rest of the app uses for an
                    aside — not two stat pairs with their own labels. What the
                    numbers ARE is obvious from the words beside them. */}
                <span class="bp-song-row-stats">
                  <span>
                    {song.takeCount} {song.takeCount === 1 ? "take" : "takes"}
                  </span>
                  <span class="bp-song-row-last">{formatShortDate(song.lastPlayedAt)}</span>
                </span>
              </a>
              <FavoriteToggle
                targetType="song"
                targetId={song.id}
                favorited={favoriteSongIds.has(song.id)}
                label={song.title}
              />
            </div>
          ))}
        </div>
      )
    }

    <Pagination {...pages} noun="song" />
  </div>
</AppLayout>

<script>
  // Debounced search. Progressive enhancement in the strict sense: the form
  // works without this (type, press Enter), and this only removes the need to
  // press Enter. 300ms is long enough that a fast typist submits once per
  // word rather than once per keystroke, short enough that a slow one does not
  // wonder whether the field is live.
  //
  // Registered on `document` and re-checked per event rather than bound to the
  // element once: `<ClientRouter />` swaps the document on every navigation,
  // and a listener bound to the first render's input would be dropped on the
  // first search it triggered.
  const DEBOUNCE_MS = 300;
  let timer: number | undefined;

  document.addEventListener("input", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || target.name !== "q") {
      return;
    }
    const form = target.closest("form[data-songs-search]");
    if (!(form instanceof HTMLFormElement)) {
      return;
    }
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      // `requestSubmit`, not `submit`: it fires the submit event, so
      // `<ClientRouter />` intercepts it and does a soft navigation with the
      // persisted form intact, rather than a full page load that would drop
      // focus regardless of `transition:persist`.
      form.requestSubmit();
    }, DEBOUNCE_MS);
  });

  // A search that lands while the member is still typing must not leave the
  // caret behind. The persisted element keeps focus on its own; this only
  // restores it when the browser drops it (Safari, on some soft navigations).
  document.addEventListener("astro:after-swap", () => {
    const input = document.querySelector("form[data-songs-search] input[name='q']");
    if (input instanceof HTMLInputElement && input.value && document.activeElement !== input) {
      const end = input.value.length;
      input.focus();
      input.setSelectionRange(end, end);
    }
  });
</script>
