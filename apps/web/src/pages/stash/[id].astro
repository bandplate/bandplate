---
// One recording from the stash, as a PAGE. The surface a member actually uses
// is `StashItemSheet.astro`, opened from the row on `/takes?stash=1`; this is
// where the row's link goes when there is no script to open it with, and where
// a bookmark or a link from anywhere else lands.
//
// So the two say the same things in the same order — the facts, the one thing
// to do with the recording, then rename, download, delete — and a change to
// one is a change to both. They share the logic that matters: what the
// recording is CALLED (`stash-display.ts`) and what a write does
// (`applyStashWrite`), which is also where the owner check lives.
//
// Publishing and renaming are plain POSTs to this page, like every other M8
// write; delete is the shared `data-confirm` modal, with `/stash/[id]/delete`
// as its no-JS page. A published or someone else's take is a 404 here.
import { formatShortDate, messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import { stashName, stashNote, stashSongField } from "../../client/stash-display.js";
import PlayToggleButton from "../../components/PlayToggleButton.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { formatDuration } from "../../server/format.js";
import { applyStashWrite, getStashItem, listRecordableSongs } from "../../server/pages/stash.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return new Response("Not found.", { status: 404 });
}

const appDeps = await getAppDeps();
const locale = Astro.locals.locale;
const t = messages(locale);

let formError: string | undefined;
let renameError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    // This page is ABOUT one recording, so a form naming a different one is
    // not a write it can carry out — and applying it here would report the
    // result on the wrong recording's page. The stash list, where a form can
    // legitimately name any row, is the one that takes the id from the body.
    if (String(formData.get("takeId") ?? "") !== id) {
      return new Response("Not found.", { status: 404 });
    }
    const result = await applyStashWrite(
      appDeps.db,
      appDeps.clock.now(),
      principal.memberId,
      formData,
    );
    if (result.kind === "published") {
      return Astro.redirect(`/takes/${result.takeId}?published=1`);
    }
    if (result.kind === "renamed") {
      return Astro.redirect(`/stash/${result.takeId}?renamed=1`);
    }
    if (result.kind === "not_found") {
      return new Response("Not found.", { status: 404 });
    }
    if (result.kind === "ignored") {
      return new Response("Bad request.", { status: 400 });
    }
    if (result.kind === "error") {
      formError =
        result.error === "no_song"
          ? t.stash.noSongChosen
          : result.error === "song_not_found"
            ? t.stash.songGone
            : result.error === "nothing_to_play"
              ? t.stash.stillUploading
              : t.stash.labelTooLong;
      // Twice: in the field, for the page where the sheet is a plain block,
      // and in a banner, because with script the sheet is closed again by the
      // time this page is back.
      if (result.error === "label_too_long") {
        renameError = formError;
      }
    }
  }
}

const item = await getStashItem(appDeps.db, id, principal.memberId);
if (!item) {
  return new Response("Not found.", { status: 404 });
}
const { take, song, event, owner, playableAsset } = item;
const nameParts = { songId: take.songId, songTitle: song?.title, label: take.label };
const nameWords = { noSong: t.stash.noSongYet, unknownSong: t.stash.unknownSong };
// What this recording is called, and what its "Píseň" field says — two
// different questions once a recording can have no song. See `stash-display`.
const title = stashName(nameParts, nameWords);
// The song, said only where it is not already the title.
const note = stashNote(nameParts, nameWords);
const songField = stashSongField(nameParts, nameWords);
// The song has to be chosen before it can be added to the band, so the picker
// is part of the publish form rather than a step before it. Same list the
// recorder uses; loaded only when there is a choice to make.
const songChoices = take.songId ? [] : (await listRecordableSongs(appDeps.db)).songs;
const justRenamed = Astro.url.searchParams.get("renamed") === "1";
const length = formatDuration(take.durationMs);
---

<AppLayout title={t.stash.pageTitle(title)} principal={principal} current="takes">
  <div class="bp-stack bp-stash-item">
    <a href="/takes?stash=1" class="bp-btn bp-btn-secondary bp-btn-sm bp-stash-back">{t.stash.backToStash}</a>
    {justRenamed && <Banner kind="success">{t.stash.renamed}</Banner>}
    {formError && <Banner kind="error">{formError}</Banner>}

    <p class="bp-eyebrow bp-m0">{t.stash.addTitle}</p>
    {/* The heading: the recording's own name, then the song it is for and how
        long it runs. A recording with no name of its own is called by its
        song, so the line under it is only the length rather than the title
        twice. */}
    <div class="bp-title-row">
      <div>
        <h1 class="bp-hero-title bp-m0">{title}</h1>
        <p class="bp-stash-sub bp-m0">{note ? t.stash.songAndLength(note, length) : length}</p>
      </div>
      {playableAsset && (
        <PlayToggleButton takeId={take.id} assetId={playableAsset.id} title={title} subtitle={note ?? ""} size="lg" />
      )}
    </div>

    {/* Labelled fields, not a run joined by dots: three different facts. */}
    <dl class="bp-stash-facts">
      <div>
        <dt>{t.stash.fieldSong}</dt>
        <dd>{songField}</dd>
      </div>
      <div>
        <dt>{t.stash.fieldEvent}</dt>
        <dd>{t.stash.personalEvent(formatShortDate(locale, event?.heldAt ?? take.recordedAt))}</dd>
      </div>
      <div>
        <dt>{t.stash.fieldBy}</dt>
        <dd>{owner?.displayName}</dd>
      </div>
    </dl>

    {/* No fake affordances, and the NEAREST obstacle first: a recording still
        on its way from the phone cannot be added whatever the library holds,
        so that is what the page says. Only once the file has landed is an
        empty library the thing in the way. */}
    {!playableAsset ? (
      <p class="bp-field-hint bp-m0">{t.stash.stillUploading}</p>
    ) : !take.songId && songChoices.length === 0 ? (
      <p class="bp-field-hint bp-m0">{t.stash.noSongs}</p>
    ) : (
      <div class="bp-stash-publish">
        <p class="bp-m0">{t.stash.publishNote}</p>
        <form method="post">
          <input type="hidden" name="intent" value="publish" />
          <input type="hidden" name="takeId" value={take.id} />
          {!take.songId && (
            <div class="bp-stash-song-pick">
              <label class="bp-field-label" for="publish-song">{t.stash.chooseSong}</label>
              <select id="publish-song" name="songId" class="bp-input" required>
                <option value="">{t.stash.chooseSongPlaceholder}</option>
                {songChoices.map((choice) => (
                  <option value={choice.id}>{choice.title}</option>
                ))}
              </select>
            </div>
          )}
          <button type="submit" class="bp-btn bp-btn-primary">{t.stash.publish}</button>
        </form>
      </div>
    )}

    <div class="bp-stash-secondary">
      <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm" data-sheet-open="rename-stash">
        {t.stash.rename}
      </button>
      {playableAsset && (
        <a href={`/api/assets/${playableAsset.id}/download`} class="bp-btn bp-btn-secondary bp-btn-sm">
          {t.stash.download}
        </a>
      )}
      <a
        href={`/stash/${take.id}/delete`}
        class="bp-btn bp-btn-danger bp-btn-sm"
        data-confirm
        data-confirm-title={t.stash.deleteTitle(title)}
        data-confirm-body={t.stash.deleteBody}
        data-confirm-action={`/stash/${take.id}/delete`}
        data-confirm-cta={t.stash.deleteCta}
        data-confirm-redirect={`/takes?stash=1&deleted=${take.id}`}
      >
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
        </svg>
        {t.stash.delete}
      </a>
    </div>

    <RecordSheet id="rename-stash" eyebrow={t.stash.rename} title={title}>
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="rename" />
        <input type="hidden" name="takeId" value={take.id} />
        <div class="bp-sheet-body">
          <Field label={t.stash.labelField} name="label" value={take.label ?? ""} maxlength={200} error={renameError} />
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">{t.stash.renameSave}</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.stash.cancel}</button>
        </div>
      </form>
    </RecordSheet>
  </div>
</AppLayout>
