---
import { hasAllScopes } from "@bandplate/core";
// Take detail — the song (linked), the event and date (linked), duration,
// label, instruments recorded, state, and the current vote tally. Then the
// take's assets: the master, stems by instrument, and whether a lossless
// master exists (derived — `assetsRepo.takeHasLossless`, never stored).
//
// Playback (increment 4): a play control directly under the hero, above
// the metadata list — the gap task 6 left on purpose. No fake affordance
// when there's no ready master (brief still applies): the button and the
// "Solo" drawer both render conditionally on real, ready assets existing,
// never a disabled stand-in.
//
// Stems ship SOLO, not a mixer: the drawer swaps the player's single
// source while preserving playback position, one stream at a time — never
// synchronised multi-track playback (`HTMLMediaElement`s drift audibly
// within seconds with no sample-accurate sync, and a real fix needs Web
// Audio decoding every stem to an `AudioBuffer`, ~7×45MB of PCM for a
// four-minute take — enough to kill a mobile Safari tab). See
// task-7-report.md.
//
// `transition:name={`take-${take.id}`}` on the song-title hero matches the
// same name `TakeRow.astro` puts on its own link — clicking a take row
// morphs that link into this heading via View Transitions. Continuity is
// closest coming from "event"/"full" mode rows (whose own link text is
// already the song title); a "song" mode row's link is the recorded date
// instead, so that one morphs a date into a title — still a smooth shared
// transition, just not a pixel-identical one. See task-6-report.md.
import type { assetsRepo } from "@bandplate/db";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import InstrumentIcon from "../../components/InstrumentIcon.astro";
import PlayToggleButton from "../../components/PlayToggleButton.astro";
import VoteToggle from "../../components/VoteToggle.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import {
  eventKindLabel,
  eventLabel,
  formatBytes,
  formatDuration,
  formatLongDate,
  takeNote,
} from "../../server/format.js";
import { getTakeDetail } from "../../server/pages/takes.js";
import { TAKE_STATE_LABEL } from "../../server/take-state.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return new Response("Not found.", { status: 404 });
}

const appDeps = await getAppDeps();
const detail = await getTakeDetail(appDeps.db, id, principal.memberId);
if (!detail) {
  return new Response("Not found.", { status: 404 });
}

const { take, song, event, instruments, assets, hasLossless, favorited, myVote } = detail;
const instrumentLabelById = new Map(instruments.map((i) => [i.id, i.label]));
const isAdmin = hasAllScopes(principal, ["members:admin"]);

// `peaks` assets are waveform data for the future player, not something a
// member browses as a "recording" — the brief's own enumeration ("master,
// stems by instrument") doesn't mention them either.
const masters = assets.filter((a) => a.kind === "master");
const stems = assets.filter((a) => a.kind === "stem");
// F7 (review round 1): the empty state used to gate on `assets.length`,
// which includes `peaks` rows — a take with ONLY peaks assets (waveform
// data, filtered out above) rendered an empty `<ul>` instead of the empty
// state. Gate on what's actually displayed instead.
const displayableAssets = [...masters, ...stems];

// The one master this take is playable from — lossy tier preferred (see
// `assetsRepo.listPlayableMastersByTakeIds`'s doc comment for why: it's
// what every browser can decode without a plugin, and what the persistent
// player uses as the default source). `undefined` here means no play
// control renders at all.
const readyMasters = masters.filter((a) => a.status === "ready");
const playableMaster =
  readyMasters.find((a) => a.tier === "lossy") ?? readyMasters.find((a) => a.tier === "lossless");
const playableStems = stems.filter((a) => a.status === "ready");

const kindLabel = event ? eventKindLabel(event.kind) : "";
// The event's NAME where it has one, exactly as the take rows say it — a
// member arriving here from a row should read the same words they clicked.
const eventName = event
  ? eventLabel({ title: event.title ?? null, venue: event.venue ?? null })
  : "";
const noteText = takeNote(take.label, kindLabel);
const heroTitle = song ? song.title : `Take from ${formatLongDate(take.recordedAt)}`;
const heroSubtitle = event ? `${kindLabel} — ${formatLongDate(event.heldAt)}` : (take.label ?? "");

function assetLabel(asset: assetsRepo.Asset): string {
  if (asset.kind === "master") {
    return "Master";
  }
  return instrumentLabelById.get(asset.instrumentId ?? "") ?? "Unknown instrument";
}
---

<AppLayout title={song ? song.title : "Take"} principal={principal} current="home">
  {/* Direction T3 from the design canvas: labelled STRIPS hanging off one
      edge, divided by rules, no cards. It is the same grammar the song page
      uses, which is the whole argument for it — a member moving between the
      two reads one layout, not two. Each strip is titled by what it is FOR
      ("Listen", "Your vote"), because this page's job is a sequence — hear
      the take, then judge it — and the old five-row definition list, with
      the vote as its fifth entry after Instruments, said nothing about that.
      Facts collapse into one quiet run at the bottom; they are context for
      the decision, not the point of the page. */}
  <div class="bp-take-detail">
    <div class="bp-take-detail-hero">
      <h1 class="bp-hero-title bp-m0">
        {
          song ? (
            <a href={`/songs/${song.slug}`} class="bp-hero-title-link" transition:name={`take-${take.id}`}>
              {song.title}
            </a>
          ) : (
            <span transition:name={`take-${take.id}`}>Take</span>
          )
        }
        <span class="bp-take-favorite-mark">
          <FavoriteToggle
            targetType="take"
            targetId={take.id}
            favorited={favorited}
            label={song ? song.title : "this take"}
            size="lg"
          />
        </span>
      </h1>
      <p class="bp-take-detail-subline bp-m0">
        {/* Event name, then the date with the kind badge beside it — the take
            row's own order, so the two read the same way. An untitled event has
            nothing to say beyond its kind and the badge already says it ("this
            rehearsal" next to a `rehearsal` badge was the same word twice), so
            in that case the badge itself becomes the link and there is no name
            ahead of the date. */}
        {
          event && eventName && (
            <>
              <a href={`/events/${event.id}`} class="bp-take-event-link">
                {eventName}
              </a>
              <span class="bp-take-detail-sep" aria-hidden="true" />
            </>
          )
        }
        <span>{formatLongDate(event ? event.heldAt : take.recordedAt)}</span>
        {
          event && kindLabel ? (
            eventName ? (
              <span class="bp-badge bp-badge-kind">{kindLabel}</span>
            ) : (
              <a
                href={`/events/${event.id}`}
                class="bp-take-event-link"
                aria-label={`View this ${kindLabel}`}
              >
                <span class="bp-badge bp-badge-kind">{kindLabel}</span>
              </a>
            )
          ) : null
        }
      </p>
      {noteText && <p class="bp-take-detail-note bp-m0">{noteText}</p>}
      {/* The same line a take row carries, with the same treatment: the note
          size, a drawn rule, and the instrument glyphs. It was a strip of its
          own labelled "This take", which is a heading over two facts that the
          hero was already the natural home for — and it put the take's length
          three strips away from the control that plays it. */}
      <p class="bp-take-detail-facts bp-m0">
        <span>{formatDuration(take.durationMs)}</span>
        {
          instruments.length > 0 && (
            <>
              <span class="bp-take-detail-sep" aria-hidden="true" />
              <span
                class="bp-take-instruments"
                role="img"
                aria-label={`Instruments: ${instruments.map((i) => i.label).join(", ")}`}
              >
                {instruments.map((instrument) => (
                  <InstrumentIcon icon={instrument.icon} label={instrument.label} />
                ))}
              </span>
            </>
          )
        }
      </p>
    </div>

    {
      playableMaster && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">Listen</h2>
          <div class="bp-take-play-section">
            <div class="bp-take-play-lead">
              <PlayToggleButton
                takeId={take.id}
                assetId={playableMaster.id}
                title={heroTitle}
                subtitle={heroSubtitle}
                size="lg"
              />
              <div class="bp-take-play-lead-text">
                <p class="bp-take-play-title">Play this take</p>
                {/* Names the SOURCE, not the length. The duration lives one strip
                    down in "This take", where it is still there for a take that
                    has no playable asset and so renders no play control at all —
                    saying it in both places put the same number on screen twice. */}
                <p class="bp-take-play-sub">
                  <span>{playableMaster.tier === "lossless" ? "lossless master" : "master mix"}</span>
                </p>
              </div>
            </div>
            {playableStems.length > 0 && (
              <div class="bp-solo-drawer" role="group" aria-label="Solo an instrument">
                <button
                  type="button"
                  class="bp-solo-chip"
                  data-audio-source
                  data-take-id={take.id}
                  data-asset-id={playableMaster.id}
                  data-title={heroTitle}
                  data-subtitle={heroSubtitle}
                  data-source-label="Master"
                  data-role="source-select"
                  aria-pressed="false"
                >
                  Full mix
                </button>
                {playableStems.map((stem) => {
                  const instrumentLabel =
                    instrumentLabelById.get(stem.instrumentId ?? "") ?? "Unknown instrument";
                  return (
                    <button
                      type="button"
                      class="bp-solo-chip"
                      data-audio-source
                      data-take-id={take.id}
                      data-asset-id={stem.id}
                      data-title={heroTitle}
                      data-subtitle={heroSubtitle}
                      data-source-label={`Solo: ${instrumentLabel}`}
                      data-role="source-select"
                      aria-pressed="false"
                    >
                      Solo: {instrumentLabel}
                    </button>
                  );
                })}
              </div>
            )}
          </div>
        </section>
      )
    }

    <section class="bp-take-strip">
      <h2 class="bp-strip-label">Your vote</h2>
      {/* The band's decision, beside the votes that informed it. It used to sit
          next to the take's name, where it competed with the title for the
          first thing you read; `keeper` is not what the take IS, it is what was
          decided about it, so it belongs with the deciding. Only a settled
          state shows — `new` is every take until someone acts. */}
      {
        (take.state === "keeper" || take.state === "rejected") && (
          <p class="bp-take-verdict bp-m0">
            <span class={`bp-badge ${take.state === "keeper" ? "bp-badge-keeper" : ""}`}>
              {TAKE_STATE_LABEL[take.state]}
            </span>
            <span>the band's call on this take</span>
          </p>
        )
      }
      <VoteToggle
        takeId={take.id}
        keeperVotes={take.keeperVotes}
        totalVotes={take.totalVotes}
        ratingScore={take.ratingScore}
        myVote={myVote}
        size="lg"
      />
    </section>

    {
      isAdmin && (take.state === "published" || take.state === "new") && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">Admin</h2>
          <p class="bp-field-hint bp-m0">
            Votes only inform this — promoting or rejecting is a deliberate call, not automatic.
          </p>
          <div class="bp-dialog-actions bp-admin-take-actions">
            <a
              href={`/admin/takes/${take.id}/keeper`}
              class="bp-btn bp-btn-primary bp-btn-sm"
              data-confirm
              data-confirm-title={`Promote ${heroTitle} to keeper?`}
              data-confirm-body="This take will be marked keeper — the band's pick for this song at this event."
              data-confirm-action={`/admin/takes/${take.id}/keeper`}
              data-confirm-cta="Promote to keeper"
            >
              Promote to keeper
            </a>
            <a
              href={`/admin/takes/${take.id}/keeper?reject=1`}
              class="bp-btn bp-btn-danger bp-btn-sm"
              data-confirm
              data-confirm-title={`Reject ${heroTitle}?`}
              data-confirm-body="This take will be marked rejected and dropped from 'needs your vote'. It stays in the archive."
              data-confirm-action={`/admin/takes/${take.id}/keeper?reject=1`}
              data-confirm-cta="Reject"
            >
              Reject
            </a>
          </div>
        </section>
      )
    }

      <section class="bp-take-strip">
      <h2 class="bp-strip-label">Files</h2>
      {
        displayableAssets.length === 0 ? (
          <div class="bp-empty-state">
            <p>No assets uploaded for this take yet.</p>
          </div>
        ) : (
          <div class="bp-stack bp-stack-tight">
            <p class="bp-field-hint bp-m0">
              {hasLossless ? "A lossless master is available." : "No lossless master available yet."}
            </p>
            <ul class="bp-asset-list">
              {displayableAssets.map((asset) => (
                <li class="bp-asset-row">
                  <span class="bp-asset-row-label">{assetLabel(asset)}</span>
                  <span class="bp-asset-row-meta bp-mono">
                    <span class="bp-asset-row-meta-item">{asset.format}</span>
                    <span class="bp-asset-row-meta-item">{asset.tier}</span>
                    <span class="bp-asset-row-meta-item">{formatBytes(asset.bytes)}</span>
                    {asset.status !== "ready" && (
                      <span class="bp-asset-row-meta-item">{asset.status}</span>
                    )}
                  </span>
                  {/* A plain link, not a fetch: the endpoint 302s to a presigned
                      URL carrying `Content-Disposition: attachment`, so the browser's
                      own download manager takes it from there — resumable, visible in
                      Downloads, and working identically on iOS Safari, where a
                      JS-driven blob download does not. Absent for an asset that is
                      not ready, for the same reason the play control is: no
                      affordance for a file that isn't there yet. */}
                  {asset.status === "ready" ? (
                    <a
                      class="bp-asset-row-download"
                      href={`/api/assets/${asset.id}/download`}
                      download
                      data-astro-reload
                      aria-label={`Download ${assetLabel(asset)} (${asset.format}, ${formatBytes(asset.bytes)})`}
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12" />
                        <path d="M7 11l5 5 5-5" />
                        <path d="M4 20h16" />
                      </svg>
                    </a>
                  ) : (
                    <span class="bp-asset-row-download-empty" aria-hidden="true" />
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </div>
</AppLayout>
