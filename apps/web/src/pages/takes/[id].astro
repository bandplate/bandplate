---
import { canPublish, hasAllScopes } from "@bandplate/core";
// Take detail — the song (linked), the event and date (linked), duration,
// label, instruments recorded, state, and the current vote tally. Then the
// take's assets: the master, stems by instrument, and whether a lossless
// master exists (derived — `assetsRepo.takeHasLossless`, never stored).
//
// Playback: a play control directly under the hero. No fake affordance when
// there's no ready master (brief still applies) — it renders conditionally
// on real, ready assets existing, never as a disabled stand-in.
//
// TWO ways to hear this take, and the page is down to exactly those: the
// master, and "Open in mixer" beside it. A row of per-stem "Solo" chips used
// to sit here too; it is gone. It said the same thing three times over — the
// play button already plays the master, which was its first chip, and the
// player's Hraje sheet (opened from the bar's title) still swaps to a single
// stem WITHOUT leaving the page, on any page, which is strictly better than
// a drawer that only works on this one. What the drawer could never do is play the stems together,
// and that is what the mixer is for.
//
// That mixer's existence overturned this file's original ruling, which said
// synchronised multi-track playback was off the table. Half of that
// reasoning still stands: decoding every stem to an `AudioBuffer` really
// would cost about a gigabyte for one of this band's eight-minute takes.
// What it got wrong was the conclusion — streaming elements through a Web
// Audio graph costs almost no memory, and `/dev/sync` measured the sync
// penalty rather than assuming it: zero ppm of drift over five minutes on
// Chrome. See `Mixer.tsx`.
//
// The song-title hero carries no `transition:name`: a take row's label used
// to morph into it, and the owner found titles sliding between pages
// obtrusive. The page cross-fades like every other.
import type { assetsRepo } from "@bandplate/db";
import { instrumentsRepo, songsRepo } from "@bandplate/db";
import {
  formatBytes,
  formatLongDate,
  formatShortDate,
  messages,
  validationMessage,
} from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Field from "@bandplate/ui/components/Field.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Download from "@lucide/astro/icons/download";
import SlidersVertical from "@lucide/astro/icons/sliders-vertical";
import Trash from "@lucide/astro/icons/trash";
import AssetUploader from "../../components/AssetUploader.tsx";
import FavoriteToggle from "../../components/FavoriteToggle.astro";
import PlayToggleButton from "../../components/PlayToggleButton.astro";
import RecordSheet from "../../components/RecordSheet.astro";
import TakeFactsCard from "../../components/TakeFactsCard.astro";
import VoteToggle from "../../components/VoteToggle.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import { eventLabel, factsLine, formatDuration, takeNote } from "../../server/format.js";
import { MIN_MIXER_STEMS } from "../../server/pages/mix.js";
import {
  type TakeField,
  deleteAssetConsequence,
  deleteTakeConsequence,
  getTakeDetail,
  updateTake,
} from "../../server/pages/takes.js";
import { TAKE_STATE_LABEL } from "../../server/take-state.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return new Response("Not found.", { status: 404 });
}

const appDeps = await getAppDeps();

const locale = Astro.locals.locale;
const t = messages(locale);

let editError: string | undefined;
let editErrorField: TakeField | undefined;
let formError: string | undefined;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = t.common.originError;
  } else {
    const formData = await Astro.request.formData();
    if (formData.get("intent") === "update") {
      const result = await updateTake(appDeps.db, appDeps.clock.now(), id, formData);
      if (result.kind === "ok") {
        return Astro.redirect(`/takes/${id}?saved=1`);
      }
      if (result.kind === "not_found") {
        formError = t.takes.gone;
      } else if (result.kind === "unknown_parent") {
        editError = t.takes.songGone;
        editErrorField = result.field;
      } else {
        editError = validationMessage(locale, result.error);
        editErrorField = result.field;
      }
    }
  }
}

const detail = await getTakeDetail(appDeps.db, id, principal.memberId);
if (!detail) {
  return new Response("Not found.", { status: 404 });
}

// Only the owner gets this far with a private take; its page is the stash's.
if (detail.take.visibility === "private") {
  return Astro.redirect(`/stash/${detail.take.id}`);
}

const {
  take,
  song,
  event,
  instruments,
  instrumentsById,
  assets,
  hasLossless,
  favorited,
  myVote,
  ownerName,
} = detail;
// Labels come from the VOCABULARY, not from `instruments` (what was played on
// this take). The two are different sets by contract, and a stem whose
// instrument is missing from the take's list — every stem added by a later
// re-render — read as "Unknown instrument" while sitting in a file named
// after it.
const instrumentLabelById = new Map([...instrumentsById].map(([id, i]) => [id, i.label]));
const isAdmin = hasAllScopes(principal, ["members:admin"]);
/** A member's own recording, published from their stash: heard, not judged. */
const isPersonal = take.ownerMemberId !== null;

// `peaks` assets are waveform data for the future player, not something a
// member browses as a "recording" — the brief's own enumeration ("master,
// stems by instrument") doesn't mention them either.
const masters = assets.filter((a) => a.kind === "master");
const stems = assets.filter((a) => a.kind === "stem");
// F7 (review round 1): the empty state used to gate on `assets.length`,
// which includes `peaks` rows — a take with ONLY peaks assets (waveform
// data, filtered out above) rendered an empty `<ul>` instead of the empty
// state. Gate on what's actually displayed instead.
const displayableAssets = [...masters, ...stems];

// The one master this take is playable from — lossy tier preferred (see
// `assetsRepo.listPlayableMastersByTakeIds`'s doc comment for why: it's
// what every browser can decode without a plugin, and what the persistent
// player uses as the default source). `undefined` here means no play
// control renders at all.
const readyMasters = masters.filter((a) => a.status === "ready");
const playableMaster =
  readyMasters.find((a) => a.tier === "lossy") ?? readyMasters.find((a) => a.tier === "lossless");
const playableStems = stems.filter((a) => a.status === "ready");

const kindLabel = event ? t.events.kindLabel(event.kind) : "";
// The event's NAME where it has one, exactly as the take rows say it — a
// member arriving here from a row should read the same words they clicked.
const eventName = event
  ? eventLabel({ title: event.title ?? null, venue: event.venue ?? null })
  : "";
const noteText = takeNote(take.label, kindLabel);
// One plain sentence under the heading, carrying the two facts a heading of a
// song title cannot: which session this came out of, and when.
//
// It is assembled rather than templated because `eventKindLabel` returns the
// word the band uses — "live" for a concert — and "a take from a live on
// July 8" is not a sentence. Where the event has a name the name carries it;
// where it does not, the kind becomes an ADJECTIVE on the take ("A rehearsal
// take", "A live take"), which is grammatical for every value the vocabulary
// can hold, including one an admin adds later.
const heroLede = event
  ? eventName
    ? t.takes.heroFromEvent({ event: eventName, date: formatLongDate(locale, event.heldAt) })
    : t.takes.heroOfKind({ kind: kindLabel, date: formatLongDate(locale, event.heldAt) })
  : t.takes.heroRecorded(formatLongDate(locale, take.recordedAt));

// The take's own label belongs in its NAME, not in the run of facts. Two
// takes of one song are told apart by "take 2", and a reader looking for
// which one they are on was being asked to find it among a duration, an
// instrument set and a state badge.
//
// `takeNote` still decides whether there is a label worth saying: one that
// merely repeats the event's kind is suppressed, or the heading would read
// "Čoudy: Rehearsal" and say twice what the sentence under it already says.
const heroTitle = song
  ? noteText
    ? `${song.title}: ${noteText}`
    : song.title
  : t.takes.heroTitleByDate(formatLongDate(locale, take.recordedAt));
// Never the label any more — it is in the title now, and the player bar
// showing "Čoudy — take 2" over "take 2" is the same words twice. With no
// event to name, the date is what the lede says too.
const heroSubtitle = event
  ? `${kindLabel} — ${formatLongDate(locale, event.heldAt)}`
  : formatLongDate(locale, take.recordedAt);

// The phone header's line under the song's name: the take's own label and
// nothing else. It is what tells two takes of one song apart; where and when
// it was played are facts, and they have labelled places in the panel below.
const headerLead = song && noteText ? noteText : undefined;
// The panel's event cell. The catalog's kind words are lowercase, and here
// one can stand alone as a value ("Zkouška").
const panelEvent = event ? factsLine([eventName || kindLabel], locale) : null;
const panelDate = formatLongDate(locale, event ? event.heldAt : take.recordedAt);
const factsCard = {
  event: panelEvent,
  date: panelDate,
  duration: formatDuration(take.durationMs),
  verdict:
    take.state === "keeper" || take.state === "rejected"
      ? { label: TAKE_STATE_LABEL[take.state], keeper: take.state === "keeper" }
      : null,
  instruments,
};

// The link preview's sentence is the page's own lede. A second one written
// for the card is a second one to keep true.

/** An admin, on a take the band has not yet ruled on. */
const canDecide = isAdmin && !isPersonal && (take.state === "published" || take.state === "new");

const canDelete = hasAllScopes(principal, ["members:admin"]);
const justCreated = Astro.url.searchParams.get("created") === "1";
const justSaved = Astro.url.searchParams.get("saved") === "1";
const justPublished = Astro.url.searchParams.get("published") === "1";
const justUnpublished = Astro.url.searchParams.get("unpublished") === "1";
const publishBlocked = Astro.url.searchParams.get("nothing_to_play") === "1";

// A take is a container: created empty, filled over as many visits as it
// takes. So it stays out of sight until someone says it is ready —
// see `setTakePublished` for why that is a press rather than a side effect
// of the first file landing.
const isDraft = take.state === "uploading" || take.state === "new";
const readyToPublish = canPublish(assets);
const recordedAtDate = new Date(take.recordedAt);
const recordedAtValue = `${recordedAtDate.getFullYear()}-${String(recordedAtDate.getMonth() + 1).padStart(2, "0")}-${String(recordedAtDate.getDate()).padStart(2, "0")}`;

// The edit sheet's pickers. A band's repertoire is tens of songs, so the whole
// list is one cheap query and a plain `<select>` — the same call `/takes`
// already makes for its filter. Archived songs are excluded by the repo.
const [allSongs, allInstruments] = await Promise.all([
  songsRepo.list(appDeps.db),
  instrumentsRepo.list(appDeps.db),
]);
const takeInstrumentIds = new Set(instruments.map((i) => i.id));
const deleteConsequence = deleteTakeConsequence(assets, take.totalVotes, locale);
const justFileDeleted = Astro.url.searchParams.get("file_deleted") === "1";
// A published take with nothing playable left: deleting the last file does not
// unpublish it (one member's delete must not change what everyone sees), so
// the page says so and an admin decides.
const publishedButEmpty = !isDraft && !readyToPublish;

/** Whether removing this one would leave the take with nothing to play. */
function isLastPlayableAsset(asset: assetsRepo.Asset): boolean {
  return !assets.some(
    (a) => a.id !== asset.id && (a.kind === "master" || a.kind === "stem") && a.status === "ready",
  );
}

function assetLabel(asset: assetsRepo.Asset): string {
  if (asset.kind === "master") {
    return t.takes.masterLabel;
  }
  return instrumentLabelById.get(asset.instrumentId ?? "") ?? t.takes.unknownInstrument;
}
---

<AppLayout
  title={song ? t.takes.pageTitle(heroTitle) : t.takes.pageTitleUnknown}
  description={heroLede}
  headerTitle={song ? song.title : heroTitle}
  headerSubtitleLead={headerLead}
  principal={principal}
  current="home"
>
  {/* The take's facts on a phone: a card under the header. A picture of the
      hero's own copy, which is what assistive tech reads, so the shell marks
      this one aria-hidden. */}
  <TakeFactsCard slot="header-panel" {...factsCard} />
  <button
    slot="header-end"
    type="button"
    class="bp-btn bp-btn-secondary bp-btn-xs"
    data-sheet-open="edit-take"
  >
    {t.takes.edit}
  </button>
  <FavoriteToggle
    slot="header-actions"
    targetType="take"
    targetId={take.id}
    favorited={favorited}
    label={song ? song.title : t.takes.thisTake}
    size="lg"
  />
  {/* Direction T3 from the design canvas: labelled STRIPS hanging off one
      edge, divided by rules, no cards. It is the same grammar the song page
      uses, which is the whole argument for it — a member moving between the
      two reads one layout, not two. Each strip is titled by what it is FOR
      ("Listen", "Your vote"), because this page's job is a sequence — hear
      the take, then judge it — and the old five-row definition list, with
      the vote as its fifth entry after Instruments, said nothing about that.
      Facts collapse into one quiet run at the bottom; they are context for
      the decision, not the point of the page. */}
  <div class="bp-take-detail">
    {justCreated && (
      <Banner kind="success">
        {t.takes.takeAdded}
      </Banner>
    )}
    {justSaved && <Banner kind="success">{t.takes.saved}</Banner>}
    {justFileDeleted && <Banner kind="success">{t.takes.fileDeleted}</Banner>}
    {publishedButEmpty && (
      <Banner kind="error" title={t.takes.nothingToPlayTitle}>{t.takes.nothingToPlayBody}</Banner>
    )}
    {justPublished && <Banner kind="success">{t.takes.published}</Banner>}
    {justUnpublished && (
      <Banner kind="success">{t.takes.unpublished}</Banner>
    )}
    {publishBlocked && (
      <Banner kind="error">
        {t.takes.publishBlocked}
      </Banner>
    )}
    {formError && <Banner kind="error">{formError}</Banner>}

    <div class="bp-take-detail-hero">
      {/* "Take of <song>", not the song's own title. The title WAS a link to
          the song — a page heading that quietly navigates somewhere else,
          which is the one shape nobody reads as a way out, and it also made
          this page look like the song's page. The heading names what you are
          on; getting to the song is a button below it, where an action
          belongs. */}
      {/* The SONG's title, not "Take of <song>". The heading names the thing
          you are looking at, and what you are looking at is a performance of
          that song; the sentence under it says which one. "Take of …" was
          scaffolding standing in for a subtitle that did not exist yet.

          It still carries the view transition from the row that led here — and
          now the two match, since a take row's own link text is the song's
          title everywhere except a song page (which is already showing it). */}
      <div class="bp-title-row">
      <h1 class="bp-hero-title bp-m0 bp-titled-heading">
        {/* The transition name stays on the SONG alone. It morphs from a take
            row, whose text is the song's title — carrying the label into it
            would morph between two different strings. */}
        {/* Adjacent on purpose, with no whitespace between the tags: a
            newline here becomes a text node, and the colon would float away
            from the song's name as "Čoudy : take 1". */}
        {/* One line, cut with an ellipsis, so the star beside it never
            drops to a line of its own. The cut lands at the end, on the
            label, before the song's name. `title` shows the whole of it on
            hover; the heading's text is whole for anything that reads it. */}
        <span class="bp-hero-title-text" title={heroTitle}><span>{song ? song.title : "Take"}</span>{
          song && noteText && <span class="bp-hero-title-note">: {noteText}</span>
        }</span>
        <span class="bp-take-favorite-mark">
          <FavoriteToggle
            targetType="take"
            targetId={take.id}
            favorited={favorited}
            label={song ? song.title : t.takes.thisTake}
            size="lg"
          />
        </span>
      </h1>
        {/* Edit, beside the heading past `lg`. On a phone it is up in the
            header line and this copy is hidden, which empties the row. The
            band's ruling used to share it; it has its own strip below the
            ways out now. */}
        <div class="bp-take-hero-actions">
          <button type="button" class="bp-btn bp-btn-secondary bp-btn-sm bp-titled-action" data-sheet-open="edit-take">
            {t.takes.edit}
          </button>
        </div>
      </div>

      {/* Whose it is, as the personal event's own hero says it: a labelled
          field, because "osobní nahrávky" in the lede does not name anyone. */}
      {isPersonal && ownerName && (
        <p class="bp-take-detail-lede bp-m0">{t.events.recordedByLabel}: {ownerName}</p>
      )}

      {/* The take's facts, each under its own label, on the card the home
          page's Šuplík uses. Past `lg` this is the one on screen; on a phone
          the header carries a copy and this one is out of sight but still
          read, which is why it is here and not only in the header. It took
          the place of a sentence ("Nahrávka z akce …") and a run of a length
          and some glyphs, which said the same things with no labels. */}
      <div class="bp-take-facts-card bp-titled-facts">
        <TakeFactsCard {...factsCard} />
      </div>

      {/* A take created by hand starts empty and out of sight. This is where it
          gets let out — an explicit press, not a side effect of the first file
          landing: ingest publishes on commit because it declared a whole
          manifest and can tell when it is complete, and nothing here can.

          Dashed rather than a `.bp-banner`: this is not news that just
          happened, it is a standing condition of the page for as long as the
          take is a draft. */}
      {
        isDraft && (
          <div class="bp-take-draft">
            <div class="bp-take-draft-say">
              <span class="bp-eyebrow">{t.takes.draftEyebrow}</span>
              <p class="bp-m0">
                {readyToPublish ? t.takes.draftReady : t.takes.draftNotReady}
              </p>
            </div>
            {readyToPublish && (
              <form method="post" action={`/takes/${take.id}/publish`}>
                <button type="submit" class="bp-btn bp-btn-primary">{t.takes.publishTake}</button>
              </form>
            )}
          </div>
        )
      }

      {/* BOTH ways out, as a matched pair. A take belongs to a song and to an
          event equally, and the header used to reflect neither of those well:
          the song got a button, while the event got a muted link inside a line
          of facts — or, for an untitled rehearsal, nothing but the kind badge
          itself, which nobody would think to click. Each control now says what
          it leads to and names the thing itself, so a rehearsal is reachable
          exactly as a concert is. */}
      <div class="bp-take-ways">
        {
          song && (
            <a href={`/songs/${song.slug}`} class="bp-take-way">
              <span class="bp-take-way-kind">{t.takes.songHeading}</span>
              <span class="bp-take-way-name">{song.title}</span>
              <ArrowRight class="bp-take-way-arrow" aria-hidden="true" />
            </a>
          )
        }
        {
          event && (
            <a href={`/events/${event.id}`} class="bp-take-way">
              <span class="bp-take-way-kind">{kindLabel}</span>
              {/* An untitled event has no name to print, so its DATE names it —
                  which is exactly what the event ledger shows for one too. */}
              <span class="bp-take-way-name">{eventName || formatShortDate(locale, event.heldAt)}</span>
              <ArrowRight class="bp-take-way-arrow" aria-hidden="true" />
            </a>
          )
        }
      </div>

      {/* The band's ruling, under a heading like every other part of the
          page, after the ways out: deciding a take is an admin's job, not
          the first thing every member meets. Keeper keeps the accent fill
          and Reject the danger one, the weights they always had. Only while
          the take is undecided. */}
      {canDecide && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">{t.shell.nav.admin}</h2>
          <div class="bp-take-ruling">
            <a
              href={`/admin/takes/${take.id}/keeper`}
              class="bp-btn bp-btn-primary bp-btn-sm"
              data-confirm
              data-confirm-title={`Promote ${heroTitle} to keeper?`}
              data-confirm-body={t.takes.keeperBody}
              data-confirm-action={`/admin/takes/${take.id}/keeper`}
              data-confirm-cta={t.takes.keeperCta}
              data-confirm-tone="neutral"
            >
              {t.takes.keeperCta}
            </a>
            <a
              href={`/admin/takes/${take.id}/keeper?reject=1`}
              class="bp-btn bp-btn-danger bp-btn-sm"
              data-confirm
              data-confirm-title={`Reject ${heroTitle}?`}
              data-confirm-body={t.takes.rejectBody}
              data-confirm-action={`/admin/takes/${take.id}/keeper?reject=1`}
              data-confirm-cta={t.takes.rejectCta}
              data-confirm-tone="neutral"
            >
              {t.takes.rejectCta}
            </a>
          </div>
        </section>
      )}

    </div>

    <RecordSheet id="edit-take" eyebrow={t.takes.editEyebrow} title={heroTitle} subtitle={heroSubtitle}>
      {/* Empty, and targeted by `form=` above: HTML forbids a form inside a
          form, and the same trick is what the admin member sheet uses for its
          secondary POST. */}
      <form method="post" id="unpublish-take" action={`/admin/takes/${take.id}/unpublish`} class="bp-sheet-aux"></form>
      <form method="post" class="bp-sheet-form" novalidate>
        <input type="hidden" name="intent" value="update" />
        <div class="bp-sheet-body">
          <div class="bp-sheet-field">
            <label class="bp-eyebrow" for="take-song">{t.takes.songHeading}</label>
            <select class="bp-select" id="take-song" name="songId">
              {allSongs.map((option) => (
                <option value={option.id} selected={option.id === take.songId}>
                  {option.title}
                </option>
              ))}
            </select>
            <p class="bp-sheet-hint bp-m0">
              Filed under the wrong one? Moving it keeps the recording and its votes. Which session
              it came from can't be changed here — that's a fact about the day.
            </p>
          </div>
          <Field
            label={t.takes.recordedLabel}
            name="recordedAt"
            type="date"
            required
            value={recordedAtValue}
            error={editErrorField === "recordedAt" ? editError : undefined}
          />
          <Field
            label={t.takes.takeLabelLabel}
            name="label"
            value={take.label ?? ""}
            hint={t.takes.takeLabelHint}
            error={editErrorField === "label" ? editError : undefined}
          />
          <fieldset class="bp-sheet-field">
            <legend class="bp-eyebrow">{t.takes.instrumentsHeading}</legend>
            <div class="bp-pills">
              {allInstruments.map((instrument) => (
                <label class="bp-pill-check">
                  <input
                    type="checkbox"
                    name="instrumentIds"
                    value={instrument.id}
                    checked={takeInstrumentIds.has(instrument.id)}
                  />
                  <span class="bp-pill">{instrument.label}</span>
                </label>
              ))}
            </div>
            <p class="bp-sheet-hint bp-m0">
              What was played — not the same as what has its own file, since a take can capture the
              whole band in one mix.
            </p>
          </fieldset>
          <Field
            label={t.takes.notesLabel}
            name="notes"
            as="textarea"
            rows="4"
            value={take.notes ?? ""}
            error={editErrorField === "notes" ? editError : undefined}
          />
          {/* ONE extras block, not two. `.bp-sheet-extras` draws its own top
              rule, so a second one stacked below it drew a second rule with an
              empty band between them. */}
          {canDelete && (
            <div class="bp-sheet-extras">
              {/* "Unpublish", not "take it out of the archive" — since M8 the
                  word `archive` means retiring a song or an event, and reusing
                  it here read as archiving the take. This is the exact inverse
                  of the draft strip's "Publish take", so it says so.

                  Not automatic either: deleting the last playable file does not
                  silently unpublish, because one member's delete should not
                  change what everyone else sees. */}
              {!isDraft && (
                <button
                  type="submit"
                  form="unpublish-take"
                  class="bp-btn bp-btn-secondary bp-btn-sm"
                >
                  {t.takes.unpublishThisTake}
                </button>
              )}
              <a
                href={`/admin/takes/${take.id}/delete`}
                class="bp-sheet-danger"
                data-confirm
                data-confirm-title={`Delete this take of ${heroTitle}?`}
                data-confirm-body={deleteConsequence}
                data-confirm-action={`/admin/takes/${take.id}/delete`}
                data-confirm-cta={t.takes.deleteTake}
                data-confirm-redirect={`/events/${take.eventId}?take_deleted=1`}
              >
                {t.takes.deleteThisTake}
              </a>
            </div>
          )}
        </div>
        <div class="bp-sheet-foot">
          <button type="submit" class="bp-btn bp-btn-primary">{t.takes.saveChanges}</button>
          <button type="button" class="bp-btn bp-btn-secondary" data-sheet-close>{t.takes.cancel}</button>
        </div>
      </form>
    </RecordSheet>

    {
      playableMaster && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">{t.takes.listenHeading}</h2>
          <div class="bp-take-play-section">
            <div class="bp-take-play-lead">
              <PlayToggleButton
                takeId={take.id}
                assetId={playableMaster.id}
                title={heroTitle}
                subtitle={heroSubtitle}
                size="lg"
              />
              <div class="bp-take-play-lead-text">
                <p class="bp-take-play-title">{t.takes.playThisTake}</p>
                {/* Names the SOURCE, not the length. The duration lives one strip
                    down in "This take", where it is still there for a take that
                    has no playable asset and so renders no play control at all —
                    saying it in both places put the same number on screen twice. */}
                <p class="bp-take-play-sub">
                  <span>{playableMaster.tier === "lossless" ? t.takes.losslessMaster : t.takes.masterMix}</span>
                </p>
              </div>
            </div>
            {playableStems.length >= MIN_MIXER_STEMS && (
              /* Beside the play control, not under it: this is the other way
                 to listen to this take, so it belongs on that line. The
                 per-stem "Solo" chips that used to sit here are gone — the
                 play button already plays the master, which was the drawer's
                 first chip, and a stem on its own is still in the player's
                 Hraje sheet, which switches to it without leaving the page.

                 `data-astro-reload` is load-bearing, not a preference. The
                 shell player is `transition:persist`, so a view transition
                 would carry a PLAYING `<audio>` into a page that builds its
                 own audio graph — two engines, one pair of ears. A real
                 document load cannot. The cost is that this link gets no
                 shared-element transition; that is the price of the
                 invariant, and it is not a bug to fix. */
              <a
                href={`/takes/${take.id}/mix`}
                class="bp-take-play-lead bp-take-play-link"
                data-astro-reload
              >
                {/* The same disc the play control wears — see the stylesheet
                    for why it is borrowed by selector rather than by class. */}
                <span class="bp-mixer-open bp-play-toggle-lg" aria-hidden="true">
                  {/* Faders. Not a second triangle: this does not start
                      anything, it opens the place where you decide what
                      plays. */}
                  <SlidersVertical size={26} />
                </span>
                <span class="bp-take-play-lead-text">
                  <p class="bp-take-play-title bp-m0">{t.player.openInMixer}</p>
                  {/* Names the SOURCE, exactly as "master mix" does beside the
                      play control — which is the one thing that separates the
                      two ways of hearing this take. */}
                  <p class="bp-take-play-sub bp-m0">{t.mixer.stemCount(playableStems.length)}</p>
                </span>
              </a>
            )}
          </div>
        </section>
      )
    }

    {
      !isPersonal && (
        <section class="bp-take-strip">
          <h2 class="bp-strip-label">{t.takes.yourVoteHeading}</h2>
          <VoteToggle
            takeId={take.id}
            keeperVotes={take.keeperVotes}
            totalVotes={take.totalVotes}
            ratingScore={take.ratingScore}
            myVote={myVote}
            size="lg"
          />
        </section>
      )
    }

      <section class="bp-take-strip">
      {/* Direction U2: the action sits beside the heading — which the island
          renders itself, so the two share one row — and the whole strip takes a
          drop while something is dragged over it. Mounted here rather than in
          `AppLayout` because it serves exactly this page. */}
      <AssetUploader
        client:load
        locale={locale}
        takeId={take.id}
        takeHasMaster={masters.length > 0}
        instruments={allInstruments.map((i) => ({ id: i.id, label: i.label }))}
      />
      <p class="bp-uploader-nojs bp-field-hint bp-m0">
        Adding files needs JavaScript. Everything else on this page — editing the take, deleting a
        file, publishing — works without it.
      </p>

      {
        displayableAssets.length === 0 ? (
          <div class="bp-empty-state">
            <p>{t.takes.noAssets}</p>
          </div>
        ) : (
          <div class="bp-stack bp-stack-tight">
            <p class="bp-field-hint bp-m0">
              {hasLossless ? t.takes.losslessYes : t.takes.losslessNo}
            </p>
            <ul class="bp-asset-list">
              {displayableAssets.map((asset) => (
                <li class="bp-asset-row">
                  <span class="bp-asset-row-label">{assetLabel(asset)}</span>
                  <span class="bp-asset-row-meta bp-mono">
                    <span class="bp-asset-row-meta-item">{asset.format}</span>
                    {/* Dropped on a phone — see the stylesheet. The status
                        below is NOT: a file that is still uploading or has
                        failed has to say so at every width. */}
                    <span class="bp-asset-row-meta-item bp-asset-row-meta-detail">{asset.tier}</span>
                    <span class="bp-asset-row-meta-item bp-asset-row-meta-detail">
                      {formatBytes(locale, asset.bytes)}
                    </span>
                    {asset.status !== "ready" && (
                      <span class="bp-asset-row-meta-item">{asset.status}</span>
                    )}
                  </span>
                  {/* A plain link, not a fetch: the endpoint 302s to a presigned
                      URL carrying `Content-Disposition: attachment`, so the browser's
                      own download manager takes it from there — resumable, visible in
                      Downloads, and working identically on iOS Safari, where a
                      JS-driven blob download does not. Absent for an asset that is
                      not ready, for the same reason the play control is: no
                      affordance for a file that isn't there yet. */}
                  {asset.status === "ready" ? (
                    <a
                      class="bp-asset-row-download"
                      href={`/api/assets/${asset.id}/download`}
                      download
                      data-astro-reload
                      aria-label={t.takes.downloadAsset({ label: assetLabel(asset), format: asset.format, size: formatBytes(locale, asset.bytes) })}
                    >
                      <Download size={18} aria-hidden="true" stroke-width={1.8} />
                    </a>
                  ) : (
                    <span class="bp-asset-row-download-empty" aria-hidden="true" />
                  )}
                  {/* A plain confirm page, not a JSON call — uploading is the
                      one thing here that needs script, so destroying must not. */}
                  {canDelete && (
                    <a
                      class="bp-asset-row-delete"
                      href={`/admin/assets/${asset.id}/delete`}
                      data-confirm
                      data-confirm-title={t.takes.deleteAssetConfirmTitle(
                        assetLabel(asset).toLowerCase(),
                      )}
                      data-confirm-body={deleteAssetConsequence(
                        assetLabel(asset).toLowerCase(),
                        asset,
                        isLastPlayableAsset(asset),
                        locale,
                      )}
                      data-confirm-action={`/admin/assets/${asset.id}/delete`}
                      data-confirm-cta={t.takes.deleteFile}
                      aria-label={t.takes.deleteAsset(assetLabel(asset))}
                    >
                      <Trash size={17} aria-hidden="true" stroke-width={1.8} />
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </div>
</AppLayout>
