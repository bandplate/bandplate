---
import { instrumentsRepo, songsRepo, takesRepo } from "@bandplate/db";
// The takes archive: every take the band has, narrowed by song, instrument,
// date, rating and "not voted by me".
//
// Direction T2 from the canvas, with its phone question settled as B — the
// filters are a SHEET on a phone and a PANEL beside the results on desktop.
// One trick makes that one set of controls rather than two: the panel IS a
// `<dialog>`, styled as a plain static column past `lg` and opened with
// `showModal()` below it. A second copy of these fields would mean a second set
// of ids, and the first thing to rot would be the `<label for>` pairs.
//
// Filters apply on CONFIRM, in both contexts. One rule rather than two: a
// change that applies itself is right beside the results on a desktop panel and
// wrong under a sheet that covers them, and a control whose behaviour depends
// on the width of the window is a control nobody can predict.
//
// Past `lg` the panel is a bar across the top of the page and its button is
// always there. Below it, the same element is a sheet, and the button is its
// confirm. The script only opens and dismisses; submitting is the form's own
// job, which is also why this whole page still works with no JS at all.
//
// It degrades honestly: with no JS the sheet's `<summary>`-free trigger is
// hidden, the dialog renders as a plain block (a `<dialog>` with no `open` is
// `display: none`, which the no-JS rule below overrides), and the form's own
// submit button applies the filters.
import { messages } from "@bandplate/i18n";
import Banner from "@bandplate/ui/components/Banner.astro";
import Pagination from "@bandplate/ui/components/Pagination.astro";
import StashItemSheet from "../../components/StashItemSheet.astro";
import StashPendingList from "../../components/StashPendingList.tsx";
import StashRow from "../../components/StashRow.astro";
import TakeRow from "../../components/TakeRow.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import { isSameOrigin } from "../../server/csrf.js";
import {
  RECORDED_WINDOWS,
  type SearchTakesResult,
  TAKES_PER_PAGE,
  hasAnyFilter,
  hasRecordedFilter,
  parseSearchQuery,
  searchTakes,
} from "../../server/pages/search.js";
import { applyStashWrite, getStashView } from "../../server/pages/stash.js";
import { pageRequest, pageView, paginationLabels } from "../../server/pagination.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const locale = Astro.locals.locale;
const t = messages(locale);
const query = parseSearchQuery(Astro.url.searchParams);
const viewingStash = Astro.url.searchParams.get("stash") === "1";

// A recording's sheet posts to the page it was opened on, which is this one.
// The take is named in the form and the write checks it belongs to the member
// signing the request, so a hand-built POST reaches nothing of anybody else's.
let formError: string | undefined;
let renameError: string | undefined;
let renamedTakeId: string | undefined;
if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request, appDeps.config.appOrigin)) {
    formError = t.common.originError;
  } else {
    const result = await applyStashWrite(
      appDeps.db,
      appDeps.clock.now(),
      principal.memberId,
      await Astro.request.formData(),
    );
    if (result.kind === "published") {
      return Astro.redirect(`/takes/${result.takeId}?published=1`);
    }
    if (result.kind === "renamed") {
      return Astro.redirect(`/takes?stash=1&renamed=${result.takeId}`);
    }
    if (result.kind === "not_found") {
      return new Response("Not found.", { status: 404 });
    }
    // A form naming no recording, or an intent this page has no write for.
    // Nothing happened, and rendering the list as if it had would say a
    // change landed.
    if (result.kind === "ignored") {
      return new Response("Bad request.", { status: 400 });
    }
    if (result.kind === "error") {
      // Twice for a label that will not fit: in the field, where it was
      // typed, and in a banner, because with script the sheet is closed
      // again by the time this page is back.
      formError =
        result.error === "no_song"
          ? t.stash.noSongChosen
          : result.error === "song_not_found"
            ? t.stash.songGone
            : result.error === "nothing_to_play"
              ? t.stash.stillUploading
              : t.stash.labelTooLong;
      if (result.error === "label_too_long") {
        renameError = formError;
        renamedTakeId = result.takeId;
      }
    }
  }
}
// Set by the delete on `/stash/[id]`: the take just deleted, whose local copy
// (if this device still holds one) the list below drops.
const deletedTakeId = viewingStash
  ? (Astro.url.searchParams.get("deleted") ?? undefined)
  : undefined;
const filtersApplied = hasAnyFilter(query) || query.sort !== "recent";

const { page, args: takesPage } = pageRequest(Astro.url.searchParams, TAKES_PER_PAGE);
const [{ results, total }, instruments, songs, stashCount, stash] = await Promise.all([
  // The stash is a different list, not a filter on this one: nothing below the
  // bar is searched while it is open.
  viewingStash
    ? Promise.resolve<SearchTakesResult>({ results: [], total: 0 })
    : searchTakes(appDeps.db, query, principal.memberId, takesPage, appDeps.clock.now()),
  instrumentsRepo.list(appDeps.db),
  // The picker's options. A band's repertoire is tens of songs, so the whole
  // list is one cheap query and a plain `<select>` — no autocomplete, no
  // script, and it works with JS off like every other control here.
  songsRepo.list(appDeps.db),
  takesRepo.countStash(appDeps.db, principal.memberId),
  viewingStash
    ? getStashView(appDeps.db, principal.memberId)
    : Promise.resolve({ rows: [], owner: undefined, songChoices: [] }),
]);
const stashRows = stash.rows;
// `?renamed=` names the recording, so the banner is about the one that was
// renamed rather than about "something on this page".
const justRenamed = Astro.url.searchParams.get("renamed");
const renamedRow = justRenamed ? stashRows.find((row) => row.id === justRenamed) : undefined;

// How many filters are actually on — the number on the trigger, so a member
// who left one set two days ago sees that before wondering where their takes
// went. Sort is not a filter and is not counted.
const activeFilterCount = [
  Boolean(query.songId),
  query.instrumentIds.length > 0,
  hasRecordedFilter(query),
  query.unvotedOnly,
].filter(Boolean).length;

// Open the exact-date disclosure only when it is the one in use. A member who
// picked "Past month" should not have two empty date fields sitting under it
// implying they still have to fill something in.
const usingExactDates = Boolean(query.dateFrom) || Boolean(query.dateTo);

const pages = pageView({ url: Astro.url, page, perPage: TAKES_PER_PAGE, total });
// A filtered link whose page has since fallen off the end lands on the last
// real one rather than on an empty result set that looks like a bad filter.
if (!viewingStash && pages.redirectTo) {
  return Astro.redirect(pages.redirectTo);
}

// The real count, not a hedge. This read `${results.length}+ takes` when the
// old hard cap truncated — "200+" said nothing a member could act on, and was
// indistinguishable from an archive that held exactly 200.
const countLabel = t.takes.count(total);
---

<AppLayout title={t.takes.title} principal={principal} current="takes">
  <div class={viewingStash ? "bp-takes bp-takes--stash" : "bp-takes"}>
    <div class="bp-takes-bar">
      <h1 class="bp-page-title bp-m0 bp-takes-bar-title">{t.takes.title}</h1>
      {/* The stash, as a pill beside the filters: a different list of MY
          recordings, toggled like the Archived pill on /events. The count is
          server-side only; recordings still on the phone are counted by
          nobody but the list itself. */}
      <a
        href={viewingStash ? "/takes" : "/takes?stash=1"}
        class="bp-pill"
        aria-pressed={viewingStash ? "true" : "false"}
      >
        {t.stash.pill}
        {stashCount > 0 && <span class="bp-pill-count">{stashCount}</span>}
      </a>
      {/* In the stash, the way in to the recorder where the filters were: the
          mic alone, in the gold tint. The words would not fit beside the title
          and the pill on a phone, and they are still what is read out. */}
      {viewingStash ? (
        <a href="/record" class="bp-btn bp-stash-record" data-astro-reload>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="3" width="6" height="12" rx="3" />
            <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
          </svg>
          <span class="bp-visually-hidden">{t.stash.recordIdea}</span>
        </a>
      ) : (
        <>
          <button type="button" class="bp-filter-trigger" data-filter-open>
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 6h18M7 12h10M11 18h2" />
            </svg>
            {t.takes.filters}
            {activeFilterCount > 0 && <span class="bp-badge bp-badge-keeper">{activeFilterCount}</span>}
          </button>
          {/* Clearing without opening the sheet first. It only appears when there
              is something to clear, and only on a phone — the panel carries its own
              Clear beside its confirm, so a second one up here would be the
              duplicate we just removed from the sheet's header. */}
          {filtersApplied && (
            <a href="/takes" class="bp-btn bp-btn-secondary bp-btn-sm bp-takes-bar-clear">
              {t.takes.clear}
            </a>
          )}
        </>
      )}
    </div>

    {/* With no JS the dialog renders as a plain block, and the stash view
        must not show filters that do not apply to it. */}
    {!viewingStash && (
      <dialog class="bp-filter-sheet" data-filter-sheet aria-label={t.takes.filters}>
        <form method="get" class="bp-filter-form" data-filter-form>
          <div class="bp-filter-sheet-head">
            {/* A real button, not decoration. On a phone the grip is the thing a
                thumb reaches for to dismiss a sheet, so it has to be tappable and
                it has to say what it does to anything that isn't looking. */}
            <button type="button" class="bp-filter-sheet-grip" data-filter-close>
              <span class="bp-visually-hidden">{t.takes.filtersClose}</span>
            </button>
            {/* No "Clear all" here. Clearing lives next to the confirm at the
                bottom, where the member's thumb already is and where the two
                things you can do with a set of filters — apply them or drop them
                — sit together. Two clears meant two places to look. */}
            <div class="bp-filter-sheet-head-row">
              <h2 class="bp-filter-sheet-title bp-m0">{t.takes.filters}</h2>
            </div>
          </div>

          <div class="bp-filter-groups">
            {/* A picker, not a text field. Typing a title asked the member to
                spell a song the way the archive stores it — diacritics and all —
                to reach takes they can see listed on the next page over. Every
                take belongs to exactly one song, so picking one is exact where
                typing was a guess. */}
            <div class="bp-filter-group">
              <label class="bp-eyebrow bp-filter-legend" for="search-song">{t.takes.songLabel}</label>
              <select class="bp-select" id="search-song" name="song">
                <option value="">{t.takes.anySong}</option>
                {songs.map((song) => (
                  <option value={song.id} selected={query.songId === song.id}>
                    {song.title}
                  </option>
                ))}
              </select>
            </div>

            <fieldset class="bp-filter-group">
              {/* Hand-picked, and nothing else: none chosen means any instrument
                  is fine, several means a take has to carry all of them. There is
                  no "All" shortcut — "all" IS the empty selection, and a pill for
                  it would be a control whose pressed state means the same thing
                  as every other pill being unpressed. */}
              <legend class="bp-eyebrow bp-filter-legend">
                {t.takes.instrumentsLegend}
                {query.instrumentIds.length > 1 && (
                  <span class="bp-filter-legend-note">{t.takes.instrumentsAll}</span>
                )}
              </legend>
              <div class="bp-pills">
                {instruments.map((instrument) => (
                  <label class="bp-pill-check">
                    <input
                      type="checkbox"
                      id={`search-instrument-${instrument.id}`}
                      name="instrument"
                      value={instrument.id}
                      checked={query.instrumentIds.includes(instrument.id)}
                    />
                    <span class="bp-pill">{instrument.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            {/* A WINDOW first, a date range second. "What have we played in the
                past month" is the question this filter is actually asked; the
                two date pickers that used to be the whole control made a member
                work out and type the answer to a question they had not asked.

                Radios, not links: the sheet applies on confirm like every other
                control here, and a link would apply itself. `Any time` is a real
                option rather than an absent state, so the group always has a
                selected member and a member can get back to it. */}
            <fieldset class="bp-filter-group">
              <legend class="bp-eyebrow bp-filter-legend">{t.takes.recordedLegend}</legend>
              <div class="bp-pills">
                <label class="bp-pill-check">
                  <input
                    type="radio"
                    name="since"
                    value=""
                    checked={!query.since && !usingExactDates}
                  />
                  <span class="bp-pill">{t.takes.anyTime}</span>
                </label>
                {Object.entries(RECORDED_WINDOWS).map(([value, { labelKey }]) => (
                  <label class="bp-pill-check">
                    <input type="radio" name="since" value={value} checked={query.since === value} />
                    <span class="bp-pill">{t.takes[labelKey]}</span>
                  </label>
                ))}
              </div>

              {/* The escape hatch, folded away. `<details>` because it has to
                  open with no JS, and open by default only when it is what the
                  member is actually using. */}
              <details class="bp-filter-dates-fold" open={usingExactDates}>
                <summary class="bp-filter-dates-toggle">{t.takes.exactDates}</summary>
                <div class="bp-filter-dates">
                  <label class="bp-visually-hidden" for="search-date-from">{t.takes.recordedFrom}</label>
                  <input
                    class="bp-input"
                    type="date"
                    id="search-date-from"
                    name="dateFrom"
                    value={query.dateFrom ?? ""}
                  />
                  <span class="bp-filter-dates-sep" aria-hidden="true">to</span>
                  <label class="bp-visually-hidden" for="search-date-to">{t.takes.recordedTo}</label>
                  <input
                    class="bp-input"
                    type="date"
                    id="search-date-to"
                    name="dateTo"
                    value={query.dateTo ?? ""}
                  />
                </div>
                <p class="bp-field-hint bp-m0">{t.takes.exactDatesNote}</p>
              </details>
            </fieldset>

            {/* Where `/me`'s count sends you. A filter rather than a separate
                view, so it stacks with everything else here — "what haven't I
                judged from last month, with horns on it" is one query. */}
            <fieldset class="bp-filter-group">
              <legend class="bp-eyebrow bp-filter-legend">{t.takes.yoursLegend}</legend>
              <div class="bp-pills">
                <label class="bp-pill-check">
                  <input
                    type="checkbox"
                    id="search-unvoted"
                    name="unvoted"
                    value="1"
                    checked={query.unvotedOnly}
                  />
                  <span class="bp-pill">{t.takes.notVotedByMe}</span>
                </label>
              </div>
            </fieldset>

            <div class="bp-filter-group">
              <label class="bp-eyebrow bp-filter-legend" for="search-sort">{t.takes.sortLabel}</label>
              <select class="bp-select" id="search-sort" name="sort">
                <option value="recent" selected={query.sort === "recent"}>{t.takes.sortRecent}</option>
                <option value="rating" selected={query.sort === "rating"}>{t.takes.sortRating}</option>
              </select>
            </div>
          </div>

          {/* One button, both contexts: the sheet's confirm and the panel's
              apply. It is never hidden — a filter you have set and cannot apply
              is worse than one extra press. */}
          <div class="bp-filter-sheet-foot">
            <button type="submit" class="bp-btn bp-btn-primary bp-filter-apply">
              {t.takes.showTakes}
            </button>
            {filtersApplied && (
              <a href="/takes" class="bp-btn bp-btn-secondary bp-btn-sm bp-filter-reset">
                {t.takes.clear}
              </a>
            )}
          </div>
        </form>
      </dialog>
    )}

    {viewingStash ? (
      <div class="bp-search-results">
        {formError && <Banner kind="error">{formError}</Banner>}
        {renamedRow && <Banner kind="success">{t.stash.renamed}</Banner>}
        <p class="bp-stash-lede bp-m0">{t.stash.viewLede}</p>
        <StashPendingList
          client:load
          locale={locale}
          memberId={principal.memberId}
          serverTakeIds={stashRows.map((row) => row.id)}
          deletedTakeId={deletedTakeId}
        />
        {stashRows.length > 0 && (
          <div class="bp-take-list bp-take-list--wide" data-play-queue>
            {stashRows.map((row) => <StashRow row={row} />)}
          </div>
        )}
        {/* The sheets live here rather than beside their rows: the list
            staggers its rows' entry by `nth-child`, and a dialog between two
            of them would shift every delay after it. It is also where the
            island appends the sheet for a recording that went up while this
            page was open — always rendered, so there is somewhere to put it. */}
        <div class="bp-stash-sheets" data-stash-sheets>
          {stashRows.map((row) => (
            <StashItemSheet
              row={row}
              ownerName={stash.owner?.displayName}
              songChoices={stash.songChoices}
              renameError={row.id === renamedTakeId ? renameError : undefined}
            />
          ))}
        </div>
      </div>
    ) : (
      <div class="bp-search-results">
        <p class="bp-takes-count bp-m0">
          {countLabel}
          {filtersApplied && <span class="bp-kind">{t.takes.filtered}</span>}
        </p>
        {
          results.length === 0 ? (
            <div class="bp-empty-state">
              <p>
                {filtersApplied
                  ? t.takes.emptyFiltered
                  : t.takes.empty}
              </p>
            </div>
          ) : (
            <div class="bp-take-list bp-take-list--wide" data-play-queue>
              {results.map((take) => (
                <TakeRow
                  take={take}
                  instruments={take.instruments}
                  context={{ kind: "full", song: take.song, event: take.event }}
                  playableAssetId={take.playableAssetId}
                  favorited={take.favorited}
                  ownerName={take.ownerName}
                />
              ))}
            </div>
          )
        }

        <Pagination {...pages} labels={paginationLabels(pages, "take")} />
      </div>
    )}
  </div>
</AppLayout>

<script>
  // Opening and dismissing the sheet. Nothing else — filters are applied by the
  // form's own submit button, in both contexts, so this page works unchanged
  // with no JS beyond the sheet never opening (see the `scripting: none` rule
  // in components.css, which renders the same element as a plain block).
  function sheet(): HTMLDialogElement | null {
    const el = document.querySelector("[data-filter-sheet]");
    return el instanceof HTMLDialogElement ? el : null;
  }

  // Delegated from `document` and re-resolved per event: `<ClientRouter />`
  // replaces the document on every navigation, so a listener bound to the first
  // render's elements would be gone after the first filter change.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) {
      return;
    }
    if (target.closest("[data-filter-open]")) {
      sheet()?.showModal();
      return;
    }
    if (target.closest("[data-filter-close]")) {
      sheet()?.close();
      return;
    }
    // Tap outside to dismiss, the way every sheet on a phone behaves. A
    // `<dialog>` does not do this on its own: a click on the backdrop is
    // dispatched with the DIALOG as its target, so this is the check — the
    // click landed on the element itself rather than on anything inside it.
    const el = sheet();
    if (el?.open && target === el) {
      el.close();
    }
  });
</script>
