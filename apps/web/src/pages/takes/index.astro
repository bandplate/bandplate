---
// The takes archive: every take in the band's history, filtered by song,
// instrument (AND), date range, rating and state. A plain GET form — every
// filter round-trips through the URL, so a search is shareable/bookmarkable
// and works with JS off (same approach `/songs`'s instrument filter uses;
// see that page's header comment for why no client script is worth adding
// just to progressively enhance a form this page doesn't otherwise need
// any script for).
//
// Layout: a filter panel BESIDE the results on desktop, a collapsed
// `<details>` above them on phones (brief §4, "as /songs does") — reusing
// `/songs`'s exact `<details>`-collapse-plus-force-open-past-lg mechanism
// (`.bp-toolbar-details`, see components.css), generalized here to wrap
// every filter fieldset (not just one instrument checkbox group) inside a
// single `.bp-search-filters-body` child, so the same one CSS override
// that already forces that one child visible past `lg` covers the whole
// filter set instead of needing a rule per fieldset.
import { instrumentsRepo, songsRepo } from "@bandplate/db";
import TakeRow from "../../components/TakeRow.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppDeps } from "../../server/app.js";
import {
  type SearchRating,
  hasAnyFilter,
  parseSearchQuery,
  searchTakes,
} from "../../server/pages/search.js";

const principal = Astro.locals.principal;
if (!principal) {
  return Astro.redirect("/login");
}

const appDeps = await getAppDeps();
const query = parseSearchQuery(Astro.url.searchParams);
const filtersApplied = hasAnyFilter(query) || query.sort !== "recent";

const [{ results, truncated }, instruments, songs] = await Promise.all([
  searchTakes(appDeps.db, query, principal.memberId),
  instrumentsRepo.list(appDeps.db),
  // The picker's options. A band's repertoire is tens of songs, so the whole
  // list is one cheap query and a plain `<select>` — no autocomplete, no
  // script, and it works with JS off like every other control here.
  songsRepo.list(appDeps.db),
]);

const STATE_OPTIONS = [
  { value: "new", label: "New" },
  { value: "published", label: "Published" },
  { value: "keeper", label: "Keeper" },
  { value: "rejected", label: "Rejected" },
] as const;

const RATING_OPTIONS: Array<{ value: SearchRating; label: string }> = [
  { value: "50", label: "50% keeper or better" },
  { value: "75", label: "75% keeper or better" },
  { value: "100", label: "Unanimous keeper" },
];

// When truncated, `results.length` is only the page size (`SEARCH_LIMIT`),
// not the true match count — stating it as a count directly above the
// truncation notice below would contradict that notice ("N takes match" /
// "showing the first N — narrow to see the rest" reads as if N were the
// whole truth). Qualify it as "at least N" instead so the two lines agree.
const resultsLabel = truncated
  ? `${results.length}+ ${results.length === 1 ? "take matches" : "takes match"}`
  : filtersApplied
    ? `${results.length} ${results.length === 1 ? "take matches" : "takes match"}`
    : `${results.length} ${results.length === 1 ? "take" : "takes"}`;
---

<AppLayout title="Takes" principal={principal} current="takes">
  <div class="bp-stack">
    <h1 class="bp-page-title">Search</h1>

    <form method="get" class="bp-search-layout">
      <details class="bp-toolbar-details bp-search-filters" open={filtersApplied}>
        <summary class="bp-toolbar-details-summary">
          Filters
          {filtersApplied && " (applied)"}
        </summary>
        <div class="bp-search-filters-body bp-stack">
          {/* A picker, not a text field. Typing a title asked the member to
              spell a song the way the archive stores it — diacritics and all —
              to reach takes they can see listed on the next page over. Every
              take belongs to exactly one song, so picking one is exact where
              typing was a guess. */}
          <div class="bp-field">
            <label class="bp-field-label" for="search-song">Song</label>
            <select class="bp-select" id="search-song" name="song">
              <option value="">Any song</option>
              {songs.map((song) => (
                <option value={song.id} selected={query.songId === song.id}>
                  {song.title}
                </option>
              ))}
            </select>
          </div>

          <fieldset class="bp-checkbox-group">
            <legend>
              Instruments
              {query.instrumentIds.length > 1 && (
                <span class="bp-field-hint">— must have a take with all of these</span>
              )}
            </legend>
            {
              instruments.map((instrument) => (
                <span class="bp-checkbox-item">
                  <input
                    type="checkbox"
                    id={`search-instrument-${instrument.id}`}
                    name="instrument"
                    value={instrument.id}
                    checked={query.instrumentIds.includes(instrument.id)}
                  />
                  <label for={`search-instrument-${instrument.id}`}>{instrument.label}</label>
                </span>
              ))
            }
          </fieldset>

          <div class="bp-form-grid">
            <div class="bp-field">
              <label class="bp-field-label" for="search-date-from">Recorded from</label>
              <input
                class="bp-input"
                type="date"
                id="search-date-from"
                name="dateFrom"
                value={query.dateFrom ?? ""}
              />
            </div>
            <div class="bp-field">
              <label class="bp-field-label" for="search-date-to">Recorded to</label>
              <input
                class="bp-input"
                type="date"
                id="search-date-to"
                name="dateTo"
                value={query.dateTo ?? ""}
              />
            </div>
          </div>

          <div class="bp-field">
            <label class="bp-field-label" for="search-sort">Sort by</label>
            <select class="bp-select" id="search-sort" name="sort">
              <option value="recent" selected={query.sort === "recent"}>Most recent</option>
              <option value="rating" selected={query.sort === "rating"}>
                Most keeper votes
              </option>
            </select>
          </div>

          <div class="bp-field">
            <label class="bp-field-label" for="search-rating">Minimum rating</label>
            <select class="bp-select" id="search-rating" name="rating">
              <option value="" selected={!query.rating}>Any rating</option>
              {
                RATING_OPTIONS.map((option) => (
                  <option value={option.value} selected={query.rating === option.value}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </div>

          {/* Where `/me`'s count sends you. A checkbox rather than a separate
              view, so it stacks with everything else in this panel — "what
              haven't I judged from last month, with horns on it" is one query,
              not three pages. */}
          <fieldset class="bp-checkbox-group">
            <legend>Yours</legend>
            <span class="bp-checkbox-item">
              <input type="checkbox" id="search-unvoted" name="unvoted" value="1" checked={query.unvotedOnly} />
              <label for="search-unvoted">Not voted by me</label>
            </span>
          </fieldset>

          <fieldset class="bp-checkbox-group">
            <legend>State</legend>
            {
              STATE_OPTIONS.map((option) => (
                <span class="bp-checkbox-item">
                  <input
                    type="checkbox"
                    id={`search-state-${option.value}`}
                    name="state"
                    value={option.value}
                    checked={query.states.includes(option.value)}
                  />
                  <label for={`search-state-${option.value}`}>{option.label}</label>
                </span>
              ))
            }
          </fieldset>

          <div class="bp-toolbar-actions">
            <button type="submit" class="bp-btn bp-btn-primary">Search</button>
            {filtersApplied && (
              <a href="/takes" class="bp-btn bp-btn-secondary">
                Clear
              </a>
            )}
          </div>
        </div>
      </details>

      <div class="bp-search-results">
        <p class="bp-field-hint bp-m0">{resultsLabel}</p>
        {
          truncated && (
            <p class="bp-field-hint bp-m0">
              Showing the first {results.length} matches — narrow your filters to see the rest.
            </p>
          )
        }
        {
          results.length === 0 ? (
            <div class="bp-empty-state">
              <p>
                {filtersApplied
                  ? "No takes match those filters — try clearing one."
                  : "No takes in the archive yet."}
              </p>
            </div>
          ) : (
            <div class="bp-take-list bp-take-list--wide">
              {results.map((take) => (
                <TakeRow
                  take={take}
                  instruments={take.instruments}
                  context={{ kind: "full", song: take.song, event: take.event }}
                  favorited={take.favorited}
                  playableAssetId={take.playableAssetId}
                />
              ))}
            </div>
          )
        }
      </div>
    </form>
  </div>
</AppLayout>
