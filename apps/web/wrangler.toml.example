# Deploy config for the Cloudflare Workers profile (increment 7). Build
# first with `BANDPLATE_ADAPTER=cloudflare astro build` (produces
# `dist/_worker.js/`), then `wrangler deploy` (or `wrangler dev` for local
# verification). See `docs/deploy-cloudflare.md` for the full walkthrough —
# what a self-deployer creates, which secrets to set, and how migrations
# run.
name = "bandplate"
main = "dist/_worker.js/index.js"
compatibility_date = "2025-09-01"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "dist"
binding = "ASSETS"

# Runs the notification tick every 10 minutes — the `scheduled` handler
# `src/worker.ts` exports alongside the normal `fetch` one (wired in via
# `workerEntryPoint` in `astro.config.mjs`). Cron Triggers run in UTC; the
# reminder logic itself (weekly-slot gating, quiet periods, ...) reasons in
# `Europe/Prague` — see `docs/deploy-cloudflare.md`'s "Scheduled tick"
# section. Not conditional on push being configured: the handler no-ops
# when `getNotificationDeps()` is `undefined` (no VAPID vars set).
[triggers]
crons = ["*/10 * * * *"]

# The one real binding this Worker needs — see `packages/db/src/client.ts`
# for why the D1 driver drops in with zero repo changes. Object storage
# (R2) and mail are reached over `fetch` with plain secret credentials
# instead (S3_* and MAIL_* below, set via `wrangler secret put`) — see
# `packages/storage/src/s3.ts`'s closing comment for why the R2 binding is
# deliberately not used.
#
# `database_id` here is a placeholder — a self-deployer replaces it with
# their own D1 database's id after `wrangler d1 create bandplate` (see the
# docs). Local `wrangler dev`/`vitest-pool-workers` never touch a real
# Cloudflare account regardless of this value.
[[d1_databases]]
binding = "DB"
database_name = "bandplate"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "../../packages/db/migrations/sqlite"

# --- Non-secret vars -------------------------------------------------------
# Secrets (BANDPLATE_BOOTSTRAP_TOKEN, MAIL_API_KEY, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY) are set with `wrangler secret put <NAME>`, never
# committed here — see docs/deploy-cloudflare.md.
#
# CRITICAL — every value below is a PLACEHOLDER. `docs/deploy-cloudflare.md`
# step 5 ("Replace every [vars] placeholder") walks through all five.
# BANDPLATE_APP_ORIGIN and MAIL_FROM (the "bandplate.example" ones) and
# S3_ENDPOINT/S3_PUBLIC_ENDPOINT (the "<account-id>" ones) are enforced at
# startup — the app refuses to boot with a message naming the variable if
# you forget one (see `apps/web/src/server/config.worker.ts`). S3_BUCKET
# needs replacing too if you named your bucket anything other than
# "bandplate" in step 2 — that one can't be fail-fast-checked because
# "bandplate" is itself a perfectly valid bucket name.
[vars]
BANDPLATE_APP_ORIGIN = "https://bandplate.example"
# Optional, "en" or "cs", English if unset. The language for anyone whose
# browser asks for something the app does not speak, and the language written
# onto every new member's row — which is what their invitation is sent in.
# A member's own choice on `/me` always wins, and so does a browser that asks
# for a language this app has.
BANDPLATE_DEFAULT_LOCALE = "en"
MAIL_PROVIDER = "resend"
MAIL_FROM = "bandplate@bandplate.example"
S3_ENDPOINT = "https://<account-id>.r2.cloudflarestorage.com"
S3_PUBLIC_ENDPOINT = "https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET = "bandplate"
S3_REGION = "auto"

# Push notifications (Web Push / VAPID) — optional, off by default. Left
# commented out on purpose: BANDPLATE_VAPID_PUBLIC_KEY and BANDPLATE_VAPID_SUBJECT
# are all-or-nothing with the BANDPLATE_VAPID_PRIVATE_KEY *secret* below (see
# docs/deploy-cloudflare.md's secrets step) — a real key pair uncommented here
# with no matching secret set fails the placeholder/completeness check at
# startup, same as leaving one BANDPLATE_SMTP_* variable set without the rest.
# Generate a pair with `pnpm --filter @bandplate/push vapid:generate`, then
# uncomment both lines below with your public key and a real contact
# address, and set the private key with `wrangler secret put
# BANDPLATE_VAPID_PRIVATE_KEY` — never put the private key in this file.
# BANDPLATE_VAPID_PUBLIC_KEY = "<your generated public key>"
# BANDPLATE_VAPID_SUBJECT = "mailto:band@example.com"
