---
// Banner primitive — success/error/info callout. Text always inherits
// `--bp-color-fg` (set by `.bp-banner`, never an accent color); the accent
// only tints the border and background wash. See components.css's file
// header for the contrast rationale.
export interface Props {
  kind?: "success" | "error" | "info";
  title?: string;
}

const { kind = "info", title } = Astro.props;

const icon = kind === "success" ? "✓" : kind === "error" ? "!" : "i";
const role = kind === "error" ? "alert" : "status";
---

<div class={`bp-banner bp-banner-${kind}`} role={role}>
  <span class="bp-banner-icon" aria-hidden="true">{icon}</span>
  <div>
    {title && <strong>{title}</strong>}
    <div><slot /></div>
  </div>
</div>
