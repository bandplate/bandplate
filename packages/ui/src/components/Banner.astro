---
import { CircleAlert, CircleCheck, Info } from "@lucide/astro";
// Banner primitive — success/error/info callout. Text always inherits
// `--bp-color-fg` (set by `.bp-banner`, never an accent color); the accent
// only tints the background wash. See components.css's file header for the
// contrast rationale.
//
// Direction B1 from the canvas. Three things it fixes:
//
//  - The icon was a TYPED CHARACTER — "✓", "!", "i" — set in the body face
//    beside a display-face heading, at whatever size the text happened to be.
//    Every other icon in this app is drawn SVG on a 16/20/24 grid, and this is
//    now one too, in a tinted disc so it reads as a mark rather than as the
//    first letter of the sentence.
//  - Nothing capped the measure, so "Saved." stretched the full width of the
//    page and the eye had to travel the whole bar to find nothing else there.
//  - An action sat stranded at the bottom-left of an otherwise empty block.
//    It goes in the `action` slot now and is pinned to the far end of the row,
//    which is what makes the width deliberate instead of accidental.
//
// ONE SHAPE, and the action is optional — a "Saved" and an "Archived" are the
// same kind of thing and read as one.
export interface Props {
  kind?: "success" | "error" | "info";
  title?: string;
}

const { kind = "info", title } = Astro.props;
const role = kind === "error" ? "alert" : "status";
const hasAction = Astro.slots.has("action");
---

<div class={`bp-banner bp-banner-${kind}`} role={role}>
  <span class="bp-banner-icon" aria-hidden="true">
    {
      kind === "success" && <CircleCheck size={20} />
    }
    {
      kind === "error" && <CircleAlert size={20} />
    }
    {
      kind === "info" && <Info size={20} />
    }
  </span>
  <div class="bp-banner-say">
    {title && <strong class="bp-banner-title">{title}</strong>}
    <slot />
  </div>
  {
    hasAction && (
      <div class="bp-banner-action">
        <slot name="action" />
      </div>
    )
  }
</div>
