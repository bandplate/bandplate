---
// The control under every listing that can grow.
//
// It is built from `.bp-filter-pill`, which already carried an
// `[aria-current="page"]` rule before anything paged — the filter pills and
// the page numbers are the same object (a small, pressable, pill-shaped
// choice among a row of them), and giving pagination its own near-identical
// vocabulary would have been a second thing to keep in step with the first.
//
// --- Links, not buttons -------------------------------------------------
//
// Every item is an `<a href>`. A page is an ADDRESS: it is shareable,
// bookmarkable, opens in a new tab on a middle click, and — the reason this
// app cares — works with no JS at all, like every other control here. A
// `<button>` in a form would have given up all four to gain nothing.
//
// --- What the row shows -------------------------------------------------
//
// First and last are always rendered, so "jump to the end" is never a walk.
// Everything within two of the current page is rendered, so the neighbours a
// thumb reaches for are there. Between those, one ellipsis per side — except
// where the gap stands for exactly ONE page, which `pageView` renders instead:
// an ellipsis hiding a single page is a lie that costs a click.
//
// --- Two rows, one markup ------------------------------------------------
//
// Below `sm` the numbers are gone and a "Page 4 of 9" label stands in their
// place. Measured before deciding, at 375px on page 4 of 9: seven numbers plus
// two steps wrapped the row onto THREE lines, which reflowed every time you
// paged, and squeezing them to fit meant 36px targets against a 44px floor.
//
// Both alternatives were worse. Scrolling the numbers hides pages behind a
// gesture with nothing to say they are there. Narrowing the window to ±1 still
// wraps at four digits and gives a phone the least useful set of links.
// Dropping them outright costs nothing a phone was going to use — nobody jumps
// to page 7 of a rehearsal archive with a thumb — and buys back the width for
// two 44px steps and an honest statement of where you are.
//
// Both halves are always in the markup, one hidden by CSS. No JS, no second
// component, and nothing that depends on guessing the viewport server-side.
//
// The count line is the accessible name of the whole control ("Page 2 of 7"),
// so a screen reader hears where it is before it hears eleven links.
export interface PaginationItem {
  kind: "page" | "gap";
  page?: number;
  href?: string;
  current?: boolean;
}

export interface Props {
  page: number;
  pageCount: number;
  total: number;
  /** 1-based index of the first and last row on this page. */
  from: number;
  to: number;
  prevHref?: string | undefined;
  nextHref?: string | undefined;
  items: PaginationItem[];
  /** What is being counted, singular — "take", "song", "event". */
  noun: string;
  /** Overrides the plural when it is not `${noun}s`. */
  pluralNoun?: string;
}

const { page, pageCount, total, from, to, prevHref, nextHref, items, noun, pluralNoun } =
  Astro.props;

const plural = pluralNoun ?? `${noun}s`;
// Built as ONE string rather than as adjacent `{from}–{to} of {total} {noun}`
// expressions: Astro drops the whitespace between two neighbouring expressions
// on the same line, which rendered "of 225takes".
const rangeLabel = `${from}–${to} of ${total} ${total === 1 ? noun : plural}`;
---

{
  /* One page and nothing to page to: the control would be a row of one
     disabled arrow either side of the number 1, which is furniture, not
     information. The range line above it already says how many there are. */
  pageCount > 1 && (
    <nav class="bp-pagination" aria-label={`Pagination, page ${page} of ${pageCount}`}>
      <p class="bp-pagination-range bp-m0">{rangeLabel}</p>

      <div class="bp-pagination-row">
        {prevHref ? (
          <a class="bp-filter-pill bp-pagination-step" href={prevHref} rel="prev">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 5l-7 7 7 7" />
            </svg>
            <span class="bp-pagination-step-word">Previous</span>
          </a>
        ) : (
          /* Rendered, not omitted: an arrow that appears on page 2 and shifts
             every number along with it makes the row jump under a thumb that
             is already moving toward one. `aria-hidden` because "unavailable
             previous page" is noise a screen reader does not need. */
          <span class="bp-filter-pill bp-pagination-step bp-pagination-step--off" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 5l-7 7 7 7" />
            </svg>
            <span class="bp-pagination-step-word">Previous</span>
          </span>
        )}

        {/* The phone's stand-in for the numbers. `aria-hidden`, because the
            nav's own label already says "page 4 of 9" and the numbered links
            below are still in the accessibility tree at every width — this is
            a visual substitute, not a second announcement. */}
        <span class="bp-pagination-here" aria-hidden="true">
          Page {page} of {pageCount}
        </span>

        <ol class="bp-pagination-pages">
          {items.map((item) =>
            item.kind === "gap" ? (
              <li class="bp-pagination-gap" aria-hidden="true">
                …
              </li>
            ) : (
              <li>
                <a
                  class="bp-filter-pill bp-pagination-page"
                  href={item.href}
                  aria-current={item.current ? "page" : undefined}
                  aria-label={`Page ${item.page}`}
                >
                  {item.page}
                </a>
              </li>
            ),
          )}
        </ol>

        {nextHref ? (
          <a class="bp-filter-pill bp-pagination-step" href={nextHref} rel="next">
            <span class="bp-pagination-step-word">Next</span>
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <span class="bp-filter-pill bp-pagination-step bp-pagination-step--off" aria-hidden="true">
            <span class="bp-pagination-step-word">Next</span>
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 5l7 7-7 7" />
            </svg>
          </span>
        )}
      </div>
    </nav>
  )
}
